          "substeps": []
        },
        {
          "type": "step",
          "id": "closure:1bjs9dp",
          "html": "Talk to Elvarg for the <a href=\"https://runescape.wiki/w/Last_Will_and_Testament\" target=\"_blank\" rel=\"noopener\">Last Will and Testament</a>.",
          "text": "Talk to Elvarg for the Last Will and Testament.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "closure:8gvc6q",
          "html": "Head to the kitchen in the northwest corner of the ground floor (UK) / 1<sup>st</sup> floor (US) of Draynor Manor and <i>turn off</i> the range.",
          "text": "Head to the kitchen in the northwest corner of the ground floor (UK) / 1st floor (US) of Draynor Manor and turn off the range.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "closure:eew5d3",
          "html": "Talk to a <a href=\"https://runescape.wiki/w/Banker\" target=\"_blank\" rel=\"noopener\">banker</a> (e.g <a href=\"https://runescape.wiki/w/Varrock_west_bank\" target=\"_blank\" rel=\"noopener\">Varrock west</a> / <a href=\"https://runescape.wiki/w/Varrock_east_bank\" target=\"_blank\" rel=\"noopener\">east bank</a>, <a href=\"https://runescape.wiki/w/Grand_Exchange#Varrock\" target=\"_blank\" rel=\"noopener\">Varrock Grand Exchange</a>, <a href=\"https://runescape.wiki/w/Draynor_bank\" target=\"_blank\" rel=\"noopener\">Draynor</a>) to receive <a href=\"https://runescape.wiki/w/Elvarg%27s_treasure_hoard\" target=\"_blank\" rel=\"noopener\">Elvarg&#39;s treasure hoard</a> from the <i>Last Will and Testament</i>.",
          "text": "Talk to a banker (e.g Varrock west / east bank, Varrock Grand Exchange, Draynor) to receive Elvarg's treasure hoard from the Last Will and Testament.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "closure:eew5d3:ho25p4",
              "html": "Certain <a href=\"https://runescape.wiki/w/Banker\" target=\"_blank\" rel=\"noopener\">bankers</a> will not work (e.g <a href=\"https://runescape.wiki/w/Taverley\" target=\"_blank\" rel=\"noopener\">Taverley</a> south-western bank)",
              "text": "Certain bankers will not work (e.g Taverley south-western bank)",
