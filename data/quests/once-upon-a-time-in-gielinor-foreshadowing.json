  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:18urwjc",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Relomia\" target=\"_blank\" rel=\"noopener\">Relomia</a> at the <a href=\"https://runescape.wiki/w/Blue_Moon_Inn\" target=\"_blank\" rel=\"noopener\">Blue Moon Inn</a> in <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>.",
          "text": "Talk to Relomia at the Blue Moon Inn in Varrock.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:znbxg",
          "html": "Take a drink from the <a href=\"https://runescape.wiki/w/Party_table\" target=\"_blank\" rel=\"noopener\">party table</a>.",
          "text": "Take a drink from the party table.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "~",
                  "text": "[Any option]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:leaxvq",
          "html": "<i>Drink</i> the <a href=\"https://runescape.wiki/w/Punch_(Foreshadowing)\" target=\"_blank\" rel=\"noopener\">punch</a> and <i>wear</i> the <a href=\"https://runescape.wiki/w/Party_hat_(Foreshadowing)\" target=\"_blank\" rel=\"noopener\">party hat</a>.",
          "text": "Drink the punch and wear the party hat.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:13nj2sw",
          "html": "Relomia will then tell stories of your adventures. In order to end the dialogue and progress choose the correct statement about the quests.",
          "text": "Relomia will then tell stories of your adventures. In order to end the dialogue and progress choose the correct statement about the quests.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1o8estd",
          "html": "Talk to Relomia again.",
          "text": "Talk to Relomia again.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "It was a wooden stake"
                },
                {
                  "key": "3",
                  "text": "It wasn't called Blacklight!"
                },
                {
                  "key": "4",
                  "text": "It had one head, not three!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:15xczsn",
          "html": "Continue the dialogue with <a href=\"https://runescape.wiki/w/Death\" target=\"_blank\" rel=\"noopener\">Death</a>.",
          "text": "Continue the dialogue with Death.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "closure",
      "title": "Closure",
      "anchor": "Closure",
      "blocks": [
        {
          "type": "step",
          "id": "closure:1r0uwju",
          "html": "Unequip the party hat as this will save time by skipping some dialogue.",
          "text": "Unequip the party hat as this will save time by skipping some dialogue.",
