          "id": "closure:lqzcd",
          "html": "<i>Enter</i> the Closure&#39;s Study, the door to the east of Death&#39;s office.",
          "text": "Enter the Closure's Study, the door to the east of Death's office.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "closure:lqzcd:ulgwjv",
              "html": "If you cannot interact with the door, go back to the lobby and log back in.",
