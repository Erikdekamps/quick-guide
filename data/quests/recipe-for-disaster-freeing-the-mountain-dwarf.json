  "sections": [
    {
      "id": "freeing-the-dwarf",
      "title": "Freeing the Dwarf",
      "anchor": "Freeing_the_Dwarf",
      "blocks": [
        {
          "type": "step",
          "id": "freeing-the-dwarf:1bs59z2",
          "html": "Inspect the <a href=\"https://runescape.wiki/w/Mountain_Dwarf\" target=\"_blank\" rel=\"noopener\">Dwarf</a>.",
          "text": "Inspect the Dwarf.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:170000v",
          "html": "Head to the <a href=\"https://runescape.wiki/w/Rising_Sun_Inn\" target=\"_blank\" rel=\"noopener\">Rising Sun Inn</a> pub in <a href=\"https://runescape.wiki/w/Falador\" target=\"_blank\" rel=\"noopener\">Falador</a>.",
          "text": "Head to the Rising Sun Inn pub in Falador.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:1ybu3eo",
          "html": "Ask <a href=\"https://runescape.wiki/w/Emily\" target=\"_blank\" rel=\"noopener\">Emily</a> about dwarves and ale (wear <a href=\"https://runescape.wiki/w/Ring_of_charos_(a)\" target=\"_blank\" rel=\"noopener\">Ring of charos (a)</a> if you have it).",
          "text": "Ask Emily about dwarves and ale (wear Ring of charos (a) if you have it).",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "What can you tell me about dwarves and ale?"
                },
                {
                  "key": "2",
                  "text": "I could offer you some in return, how about 200 gold?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "freeing-the-dwarf:1ybu3eo:14tfpai",
              "html": "If wearing <a href=\"https://runescape.wiki/w/Ring_of_charos_(a)\" target=\"_blank\" rel=\"noopener\">Ring of charos (a)</a>:",
              "text": "If wearing Ring of charos (a):",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "2",
                      "text": "What can you tell me about dwarves and ale?"
                    },
                    {
                      "key": "3",
                      "text": "(Persuade)I'm really quite trustworthy once you get to know me."
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:jkbkbo",
          "html": "Buy 4 Asgarnian ales from <a href=\"https://runescape.wiki/w/Emily\" target=\"_blank\" rel=\"noopener\">Emily</a>.",
          "text": "Buy 4 Asgarnian ales from Emily.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:w80u98",
          "html": "Add 1 gold coin to each glass of ale. (you can take coins out of your money pouch by right clicking the price checker in your inventory and selecting withdraw)",
          "text": "Add 1 gold coin to each glass of ale. (you can take coins out of your money pouch by right clicking the price checker in your inventory and selecting withdraw)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:1mwrm0g",
          "html": "Head to the tunnel under <a href=\"https://runescape.wiki/w/White_Wolf_Mountain\" target=\"_blank\" rel=\"noopener\">White Wolf Mountain</a> (cave north of <a href=\"https://runescape.wiki/w/Taverley\" target=\"_blank\" rel=\"noopener\">Taverley</a> lodestone).",
          "text": "Head to the tunnel under White Wolf Mountain (cave north of Taverley lodestone).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:lp3nhd",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Rohak\" target=\"_blank\" rel=\"noopener\">Old Dwarf</a>, Rohak. You must finish this dialogue to proceed.",
          "text": "Talk to the Old Dwarf, Rohak. You must finish this dialogue to proceed.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:1d4qejt",
          "html": "Use 4 <a href=\"https://runescape.wiki/w/Asgoldian_ale\" target=\"_blank\" rel=\"noopener\">Asgoldian ales</a> on him and then after the fade, talk to him.<br>You may need to repeat this process if you either: exit the cave before the next step, or do not give him the four ales quickly enough.",
          "text": "Use 4 Asgoldian ales on him and then after the fade, talk to him.You may need to repeat this process if you either: exit the cave before the next step, or do not give him the four ales quickly enough.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:1ei2d38",
          "html": "Talk to Rohak again to give him one-hundred <a href=\"https://runescape.wiki/w/Coins\" target=\"_blank\" rel=\"noopener\">coins</a>, a <a href=\"https://runescape.wiki/w/Bucket_of_milk\" target=\"_blank\" rel=\"noopener\">bucket of milk</a>, an <a href=\"https://runescape.wiki/w/Egg\" target=\"_blank\" rel=\"noopener\">egg</a>, a <a href=\"https://runescape.wiki/w/Pot_of_flour\" target=\"_blank\" rel=\"noopener\">pot of flour</a>, and a <a href=\"https://runescape.wiki/w/Bowl_of_water\" target=\"_blank\" rel=\"noopener\">bowl of water</a>.",
          "text": "Talk to Rohak again to give him one-hundred coins, a bucket of milk, an egg, a pot of flour, and a bowl of water.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:7f5zdu",
          "html": "Quickly pick up the <a href=\"https://runescape.wiki/w/Dwarven_rock_cake\" target=\"_blank\" rel=\"noopener\">Dwarven rock cake</a> whilst wearing gloves.",
          "text": "Quickly pick up the Dwarven rock cake whilst wearing gloves.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "freeing-the-dwarf:7f5zdu:1q6kr87",
              "html": "If the cake is not picked up fast enough, the ingredients are required to make another one.",
              "text": "If the cake is not picked up fast enough, the ingredients are required to make another one.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "freeing-the-dwarf:jk33rt",
          "html": "Cooling the cake:",
          "text": "Cooling the cake:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "freeing-the-dwarf:jk33rt:yt4q2w",
              "html": "If <a href=\"https://runescape.wiki/w/Ice_gloves\" target=\"_blank\" rel=\"noopener\">ice gloves</a> were worn whilst picking up the cake, simply return to <a href=\"https://runescape.wiki/w/Lumbridge\" target=\"_blank\" rel=\"noopener\">Lumbridge</a>.",
              "text": "If ice gloves were worn whilst picking up the cake, simply return to Lumbridge.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "freeing-the-dwarf:jk33rt:xh164g",
              "html": "If ice gloves were not worn, either drop the cake and pick it up with ice gloves equipped or kill an <a href=\"https://runescape.wiki/w/Icefiend\" target=\"_blank\" rel=\"noopener\">icefiend</a> with it in your inventory.",
              "text": "If ice gloves were not worn, either drop the cake and pick it up with ice gloves equipped or kill an icefiend with it in your inventory.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
    {
      "id": "finishing-up",
      "title": "Finishing up",
      "anchor": "Finishing_up",
      "blocks": [
        {
          "type": "step",
          "id": "finishing-up:1wdbdsi",
          "html": "<i>Use</i> the <a href=\"https://runescape.wiki/w/Dwarven_rock_cake_(cooled)\" target=\"_blank\" rel=\"noopener\">cooled rock cake</a> on the Dwarf.",
          "text": "Use the cooled rock cake on the Dwarf.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "finishing-up:1k0rf3j",
          "html": "Subquest complete!",
          "text": "Subquest complete!",
          "dialogue": [],
