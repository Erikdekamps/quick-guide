    {
      "id": "arriving-at-anachronia",
      "title": "Arriving at Anachronia",
      "anchor": "Arriving_at_Anachronia",
      "blocks": [
        {
          "type": "image",
          "src": "https://runescape.wiki/images/thumb/Anachronia_Guide_Map.png/400px-Anachronia_Guide_Map.png?4081e",
          "width": 400,
          "height": 234,
          "alt": "",
          "caption": "Follow this map to reach the bones and base camp",
          "href": "https://runescape.wiki/w/File:Anachronia_Guide_Map.png"
        },
        {
          "type": "step",
          "id": "arriving-at-anachronia:149nsvj",
          "html": "Complete the intro animations until you wind up at the landing zone.",
          "text": "Complete the intro animations until you wind up at the landing zone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "arriving-at-anachronia:416byy",
          "html": "Follow the directions on the map and investigate the <a href=\"https://runescape.wiki/w/Bones_(Anachronia)\" target=\"_blank\" rel=\"noopener\">bones</a> blocking your path.",
          "text": "Follow the directions on the map and investigate the bones blocking your path.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "arriving-at-anachronia:fyuusv",
          "html": "After investigating the second bones, you will be teleported to the base camp.",
          "text": "After investigating the second bones, you will be teleported to the base camp.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "safe-haven-away-from-monsters",
      "title": "Safe haven away from monsters",
      "anchor": "Safe_haven_away_from_monsters",
      "blocks": [
        {
          "type": "step",
          "id": "safe-haven-away-from-monsters:pzyerd",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Giles\" target=\"_blank\" rel=\"noopener\">Giles</a> in the base camp to begin the tutorial.",
          "text": "Talk to Giles in the base camp to begin the tutorial.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "safe-haven-away-from-monsters:sn9gwf",
          "html": "Assign at least one worker to gather <a href=\"https://runescape.wiki/w/Wood_(Anachronia_base_camp)\" target=\"_blank\" rel=\"noopener\">wood</a>, <a href=\"https://runescape.wiki/w/Vines_(Anachronia_base_camp)\" target=\"_blank\" rel=\"noopener\">vines</a> and <a href=\"https://runescape.wiki/w/Stone_(Anachronia_base_camp)\" target=\"_blank\" rel=\"noopener\">stone</a> respectively on the base camp management interface.",
          "text": "Assign at least one worker to gather wood, vines and stone respectively on the base camp management interface.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "safe-haven-away-from-monsters:13b4o15",
          "html": "Continue talking to Giles to skip the wait.",
          "text": "Continue talking to Giles to skip the wait.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "safe-haven-away-from-monsters:5evrl0",
          "html": "When the base camp management interface appears again, build the <a href=\"https://runescape.wiki/w/Town_Hall_(Anachronia_base_camp)\" target=\"_blank\" rel=\"noopener\">Town Hall</a>.",
          "text": "When the base camp management interface appears again, build the Town Hall.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "safe-haven-away-from-monsters:1ivb3p8",
          "html": "<b>Congratulations, tutorial complete!</b>",
          "text": "Congratulations, tutorial complete!",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "building-the-lodestone",
      "title": "Building the lodestone",
      "anchor": "Building_the_lodestone",
      "blocks": [
        {
          "type": "step",
          "id": "building-the-lodestone:xk7ok8",
          "html": "Manage base camp with Giles in the Town Hall on the eastern side of the base camp. Alternatively, you may attempt to build <a href=\"https://runescape.wiki/w/Anachronia_lodestone\" target=\"_blank\" rel=\"noopener\">Anachronia lodestone</a> to open the interface.",
          "text": "Manage base camp with Giles in the Town Hall on the eastern side of the base camp. Alternatively, you may attempt to build Anachronia lodestone to open the interface.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "building-the-lodestone:no87a1",
          "html": "Unassign workers and assign 10 workers to gather <a href=\"https://runescape.wiki/w/Clay_(Anachronia_base_camp)\" target=\"_blank\" rel=\"noopener\">clay</a>.",
          "text": "Unassign workers and assign 10 workers to gather clay.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "building-the-lodestone:aspvin",
          "html": "Wait for about 20 minutes. You may do anything during this period but you need to board <i>the Stormbreaker</i> to Anachronia if you leave the island.",
          "text": "Wait for about 20 minutes. You may do anything during this period but you need to board the Stormbreaker to Anachronia if you leave the island.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "building-the-lodestone:yaaf8m",
          "html": "Manage base camp with Giles again.",
          "text": "Manage base camp with Giles again.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "building-the-lodestone:x1sf1x",
          "html": "Once your workers have collected adequate materials, build the lodestone.",
          "text": "Once your workers have collected adequate materials, build the lodestone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    }
