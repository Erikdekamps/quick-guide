        {
          "type": "step",
          "id": "ritual:au03hm",
          "html": "Go to any furnace and smelt a <a href=\"https://runescape.wiki/w/Demonic_sigil\" target=\"_blank\" rel=\"noopener\">demonic sigil</a>.",
          "text": "Go to any furnace and smelt a demonic sigil.",
