          "substeps": [
            {
              "type": "step",
              "id": "ritual:au03hm:18cxirv",
              "html": "Your black outfit can be discarded at this point and replaced with combat gear. Keep Silverlight for the duration of the quest.",
              "text": "Your black outfit can be discarded at this point and replaced with combat gear. Keep Silverlight for the duration of the quest.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "ritual:1hd9vz6",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Clay_golem\" target=\"_blank\" rel=\"noopener\">clay golem</a> outside the ruins about last night.",
          "text": "Talk to the clay golem outside the ruins about last night.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Did you see anything happen last night?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ritual:p9hbzp",
          "html": "<i>Look in</i> the nearby Broken kilns for a book until you have found the <a href=\"https://runescape.wiki/w/Demonic_tome\" target=\"_blank\" rel=\"noopener\">Demonic tome</a> (there&#39;s a broken kiln north of the Rug Merchant and one behind the walls east of the staircase that are easy to miss).",
          "text": "Look in the nearby Broken kilns for a book until you have found the Demonic tome (there's a broken kiln north of the Rug Merchant and one behind the walls east of the staircase that are easy to miss).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ritual:19d2jqt",
          "html": "Talk to Matthew back in the lair.",
          "text": "Talk to Matthew back in the lair.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ritual:lg0qmx",
          "html": "Go north to talk to Denath and write down the incantation he tells you.",
          "text": "Go north to talk to Denath and write down the incantation he tells you.",
          "dialogue": [
