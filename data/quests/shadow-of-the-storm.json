        {
          "type": "step",
          "id": "starting-out:8cccfg",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Father_Reen\" target=\"_blank\" rel=\"noopener\">Father Reen</a> south of Al Kharid bank.",
          "text": "Talk to Father Reen south of Al Kharid bank.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
