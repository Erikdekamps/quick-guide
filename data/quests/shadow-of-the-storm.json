          "substeps": []
        },
        {
          "type": "step",
          "id": "ritual:163r4qr",
          "html": "Complete the circle and click the sigil to chant the incantation. Be sure to remember it, as you’ll need it again later in the quest.",
          "text": "Complete the circle and click the sigil to chant the incantation. Be sure to remember it, as you’ll need it again later in the quest.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ritual:gw64a7",
          "html": "Be sure to take the sigil from the floor, or you will have to make a new one at a furnace.",
          "text": "Be sure to take the sigil from the floor, or you will have to make a new one at a furnace.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ritual:2cjzwf",
          "html": "<i>Enter</i> the portal and take Tanya&#39;s sigil.",
          "text": "Enter the portal and take Tanya's sigil.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ritual:1spdrvz",
          "html": "Tell Evil Dave to return to the lair - you should have 4 sigils now.",
          "text": "Tell Evil Dave to return to the lair - you should have 4 sigils now.",
