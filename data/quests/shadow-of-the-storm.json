        {
          "type": "step",
          "id": "ritual:tebq2l",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Jennifer\" target=\"_blank\" rel=\"noopener\">Jennifer</a> to get a <a href=\"https://runescape.wiki/w/Demonic_sigil_mould\" target=\"_blank\" rel=\"noopener\">demonic sigil mould</a>.",
