            {
              "type": "step",
              "id": "starting-out:8cccfg:hpu1oa",
              "html": "He will give you <a href=\"https://runescape.wiki/w/Silverlight\" target=\"_blank\" rel=\"noopener\">Silverlight</a> if you&#39;ve dyed or destroyed it.",
              "text": "He will give you Silverlight if you've dyed or destroyed it.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "starting-out:1di1i9i",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Father_Badden\" target=\"_blank\" rel=\"noopener\">Father Badden</a> at <a href=\"https://runescape.wiki/w/Uzer\" target=\"_blank\" rel=\"noopener\">Uzer</a>, east of Shantay Pass. (Optional: take the magic carpet to Uzer)",
          "text": "Talk to Father Badden at Uzer, east of Shantay Pass. (Optional: take the magic carpet to Uzer)",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Reen sent me."
                },
                {
                  "key": "3",
                  "text": "So what do you want me to do?"
                },
                {
                  "key": "1",
                  "text": "How can I do that?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:1rxq13t",
          "html": "Pick and grind a <a href=\"https://runescape.wiki/w/Black_mushroom\" target=\"_blank\" rel=\"noopener\">black mushroom</a> (the closest is just south-east of the stairs east of <a href=\"https://runescape.wiki/w/Father_Badden\" target=\"_blank\" rel=\"noopener\">Father Badden</a>). Use it to dye Silverlight black. You can find some beside the staircase, downstairs east of the stairwell, or in the north east corner of the room, east of <a href=\"https://runescape.wiki/w/Evil_Dave\" target=\"_blank\" rel=\"noopener\">Evil Dave</a>.",
          "text": "Pick and grind a black mushroom (the closest is just south-east of the stairs east of Father Badden). Use it to dye Silverlight black. You can find some beside the staircase, downstairs east of the stairwell, or in the north east corner of the room, east of Evil Dave.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:1t5q3au",
          "html": "Go down the stairs.",
          "text": "Go down the stairs.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "starting-out:1t5q3au:ri4jv3",
              "html": "If you do not have the <a href=\"https://runescape.wiki/w/Strange_implement\" target=\"_blank\" rel=\"noopener\">strange implement</a> from <a href=\"https://runescape.wiki/w/The_Golem\" target=\"_blank\" rel=\"noopener\">The Golem</a> quest, you can pick it up from the ground in the northwest room.",
              "text": "If you do not have the strange implement from The Golem quest, you can pick it up from the ground in the northwest room.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "starting-out:dr6a65",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Evil_Dave\" target=\"_blank\" rel=\"noopener\">Evil Dave</a> wearing your three black items and your dyed Silverlight. He is standing at the entrance to Agrith Naar&#39;s demonic temple in the underground Uzer ruins.",
          "text": "Talk to Evil Dave wearing your three black items and your dyed Silverlight. He is standing at the entrance to Agrith Naar's demonic temple in the underground Uzer ruins.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I want to join your group."
                },
                {
                  "key": "1",
                  "text": "I'm evil!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
