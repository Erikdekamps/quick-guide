    {
      "id": "the-sunken-island",
      "title": "The sunken island",
      "anchor": "The_sunken_island",
      "blocks": [
        {
          "type": "step",
          "id": "the-sunken-island:3bgwdx",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Wizard_Myrtle\" target=\"_blank\" rel=\"noopener\">Wizard Myrtle</a> at the fountain near the entrance to the <a href=\"https://runescape.wiki/w/Wizards%27_Tower\" target=\"_blank\" rel=\"noopener\">Wizards&#39; Tower</a>. (<a href=\"https://runescape.wiki/w/Fairy_ring\" target=\"_blank\" rel=\"noopener\">Fairy ring</a> <b>D</b><b>I</b><b>S</b>)",
          "text": "Talk to Wizard Myrtle at the fountain near the entrance to the Wizards' Tower. (Fairy ring DIS)",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "[Continue]"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "1",
                  "text": "I know Vannaka!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-sunken-island:1m40o47",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Edgeville_Mausoleum\" target=\"_blank\" rel=\"noopener\">Edgeville Mausoleum</a> just south of the bank and talk to <a href=\"https://runescape.wiki/w/Vannaka\" target=\"_blank\" rel=\"noopener\">Vannaka</a>.",
          "text": "Go to the Edgeville Mausoleum just south of the bank and talk to Vannaka.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Talk about Beneath Cursed Tides."
                },
                {
                  "key": "4",
                  "text": "[Continue...]"
                },
                {
                  "key": "1",
                  "text": "Yes, I do."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-sunken-island:nr4djn",
          "html": "Return to the Wizards&#39; Tower, and talk to Wizard Myrtle.",
          "text": "Return to the Wizards' Tower, and talk to Wizard Myrtle.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "What's the plan then?"
                },
                {
                  "key": "1",
                  "text": "How do I get to Mudskipper Point?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-sunken-island:1h8yiwi",
          "html": "Make your way to <a href=\"https://runescape.wiki/w/Mudskipper_Point\" target=\"_blank\" rel=\"noopener\">Mudskipper Point</a>. The fastest route is via <a href=\"https://runescape.wiki/w/Fairy_ring\" target=\"_blank\" rel=\"noopener\">fairy ring</a> <b>A</b><b>I</b><b>Q</b>. Alternatively, you can run south from the <a href=\"https://runescape.wiki/w/Port_Sarim_lodestone\" target=\"_blank\" rel=\"noopener\">Port Sarim lodestone</a>.",
          "text": "Make your way to Mudskipper Point. The fastest route is via fairy ring AIQ. Alternatively, you can run south from the Port Sarim lodestone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-sunken-island:1majz93",
          "html": "Unequip your weapons and dismiss followers and then talk to Wizard Myrtle.",
          "text": "Unequip your weapons and dismiss followers and then talk to Wizard Myrtle.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Sounds perfect, let's do this!"
                },
                {
                  "key": "2",
                  "text": "I'd like to dive to the sunken island."
                },
                {
                  "key": "1",
                  "text": "Yes, I'm ready."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-sunken-island:1majz93:1fwpdi3",
              "html": "If you have completed the <a href=\"https://runescape.wiki/w/Recipe_for_Disaster:_Freeing_Pirate_Pete\" target=\"_blank\" rel=\"noopener\">Recipe for Disaster: Freeing Pirate Pete</a> subquest, or have built any kind of diving suit in the <a href=\"https://runescape.wiki/w/Aquarium\" target=\"_blank\" rel=\"noopener\">Aquarium</a>.",
              "text": "If you have completed the Recipe for Disaster: Freeing Pirate Pete subquest, or have built any kind of diving suit in the Aquarium.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "1",
                      "text": "Sounds perfect, let's do this."
                    },
                    {
                      "key": "1",
                      "text": "Underwater breathing spell."
                    },
                    {
                      "key": "2",
                      "text": "I'd like to dive to the sunken island."
                    },
                    {
                      "key": "1",
                      "text": "Yes, I'm ready."
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "the-sunken-island:1qd8tkk",
          "html": "East of the room, read the message in the bottle for the key and open the door.",
          "text": "East of the room, read the message in the bottle for the key and open the door.",
