    {
      "id": "the-seal",
      "title": "The seal",
      "anchor": "The_seal",
      "blocks": [
        {
          "type": "step",
          "id": "the-seal:1cpc7uk",
          "html": "After being teleported by Chuck, head west to the seals.",
          "text": "After being teleported by Chuck, head west to the seals.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-seal:1p6gvon",
          "html": "<i>Wake up</i> the seal that can be interacted with.",
          "text": "Wake up the seal that can be interacted with.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I'm looking for a polar bear."
                },
                {
                  "key": "1",
                  "text": "How can I entertain you?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-seal:midxbq",
          "html": "Perform the <a href=\"https://runescape.wiki/w/Dance\" target=\"_blank\" rel=\"noopener\">Dance</a> or <a href=\"https://runescape.wiki/w/Jump_For_Joy\" target=\"_blank\" rel=\"noopener\">Jump For Joy</a> <a href=\"https://runescape.wiki/w/Emote\" target=\"_blank\" rel=\"noopener\">emote</a>.",
          "text": "Perform the Dance or Jump For Joy emote.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-seal:1erlxsq",
          "html": "Talk to the seal.",
          "text": "Talk to the seal.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What's wrong with penguins?"
                },
                {
                  "key": "2",
                  "text": "Where does your band live?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-seal:3hlfhl",
          "html": "<i>Travel-Iceberg</i> the smaller boat to the north-east.",
          "text": "Travel-Iceberg the smaller boat to the north-east.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-seal:13azxc7",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Ping_%26_Pong\" target=\"_blank\" rel=\"noopener\">Ping &amp; Pong</a>. You don&#39;t need to be in your tuxedo for this.",
          "text": "Talk to Ping & Pong. You don't need to be in your tuxedo for this.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-seal:4bl8fm",
          "html": "After receiving the items from them, do one of the following:",
          "text": "After receiving the items from them, do one of the following:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-seal:4bl8fm:1acroyo",
              "html": "Option one",
              "text": "Option one",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": [
                {
                  "type": "step",
                  "id": "the-seal:4bl8fm:1acroyo:19vcro",
                  "html": "Use a <a href=\"https://runescape.wiki/w/Clockmaker%27s_bench_4\" target=\"_blank\" rel=\"noopener\">Clockmaker&#39;s bench 4</a> in a <a href=\"https://runescape.wiki/w/Player-owned_house\" target=\"_blank\" rel=\"noopener\">player-owned house</a> to make their <a href=\"https://runescape.wiki/w/Rock_costume\" target=\"_blank\" rel=\"noopener\">rock costume</a>.",
                  "text": "Use a Clockmaker's bench 4 in a player-owned house to make their rock costume.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "the-seal:4bl8fm:1acroyo:8gx31u",
                  "html": "To return, use the <a href=\"https://runescape.wiki/w/Fremennik_Province_lodestone\" target=\"_blank\" rel=\"noopener\">Fremennik Province lodestone</a> and head north to board the ship to <a href=\"https://runescape.wiki/w/Iceberg\" target=\"_blank\" rel=\"noopener\">iceberg</a>.",
                  "text": "To return, use the Fremennik Province lodestone and head north to board the ship to iceberg.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                }
              ]
            },
            {
              "type": "step",
              "id": "the-seal:4bl8fm:a8zziu",
              "html": "Option two",
              "text": "Option two",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": [
                {
                  "type": "step",
                  "id": "the-seal:4bl8fm:a8zziu:vp3s4z",
                  "html": "Head to the north-east corner of the Iceberg and right-click <a href=\"https://runescape.wiki/w/Jim\" target=\"_blank\" rel=\"noopener\">Jim</a>, a well disguised polar bear next to the stepping stones, and select &#39;tuxedo-time&#39;.",
                  "text": "Head to the north-east corner of the Iceberg and right-click Jim, a well disguised polar bear next to the stepping stones, and select 'tuxedo-time'.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "the-seal:4bl8fm:a8zziu:znf4jn",
                  "html": "Head to the north-west and investigate the avalanche of snow. Follow the main hall to the end and talk to the <a href=\"https://runescape.wiki/w/KGP_agent\" target=\"_blank\" rel=\"noopener\">KGP agent</a> in the booth.",
                  "text": "Head to the north-west and investigate the avalanche of snow. Follow the main hall to the end and talk to the KGP agent in the booth.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "the-seal:4bl8fm:a8zziu:16zjiui",
                  "html": "After proceeding through the door, head east and then follow the western wall in the war-room to the western workbench. Craft Ping &amp; Pong&#39;s costumes there.",
                  "text": "After proceeding through the door, head east and then follow the western wall in the war-room to the western workbench. Craft Ping & Pong's costumes there.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "the-seal:4bl8fm:a8zziu:f28ypb",
                  "html": "Head back outside. To get back in to the hallway, <i>Push</i> the <a href=\"https://runescape.wiki/w/Big_button?action=edit&amp;redlink=1\" target=\"_blank\" rel=\"noopener\">big button</a> west of the gate.",
                  "text": "Head back outside. To get back in to the hallway, Push the big button west of the gate.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "the-seal:4bl8fm:a8zziu:154tm4m",
                  "html": "Return to Jim, the polar bear, to get out of tuxedo.",
                  "text": "Return to Jim, the polar bear, to get out of tuxedo.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                }
              ]
            }
          ]
        },
        {
          "type": "step",
          "id": "the-seal:wp8oav",
          "html": "Give Ping &amp; Pong their costumes.",
          "text": "Give Ping & Pong their costumes.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-seal:4sqw74",
          "html": "Board the nearby boat to return to the seals.",
          "text": "Board the nearby boat to return to the seals.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-seal:ymw472",
          "html": "<i>Wake up</i> the seal, bank any items, including your <a href=\"https://runescape.wiki/w/Clockwork_suit\" target=\"_blank\" rel=\"noopener\">clockwork suit</a>, and head to the camp. There is a deposit box option when talking to the seal.",
          "text": "Wake up the seal, bank any items, including your clockwork suit, and head to the camp. There is a deposit box option when talking to the seal.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
