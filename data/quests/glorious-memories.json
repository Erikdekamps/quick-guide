      "anchor": "The_king's_cure",
      "blocks": [
        {
          "type": "bring",
          "needed": [
            {
              "id": "the-king-s-cure:bring:lm31tp",
              "html": "An empty vial",
              "text": "An empty vial"
            },
            {
              "id": "the-king-s-cure:bring:15j7h87",
              "html": "10 earth runes and 1 cosmic rune to cast <a href=\"https://runescape.wiki/w/Lvl-4_Enchant\" target=\"_blank\" rel=\"noopener\">Lvl-4 Enchant</a>",
              "text": "10 earth runes and 1 cosmic rune to cast Lvl-4 Enchant"
            },
            {
              "id": "the-king-s-cure:bring:106nhsk",
              "html": "A plank",
              "text": "A plank"
            },
            {
              "id": "the-king-s-cure:bring:1eccbuv",
              "html": "A staff or pole",
              "text": "A staff or pole"
            },
            {
              "id": "the-king-s-cure:bring:x5rxjp",
              "html": "A clean irit",
              "text": "A clean irit"
            },
            {
              "id": "the-king-s-cure:bring:8en665",
