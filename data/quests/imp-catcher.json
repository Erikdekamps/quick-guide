          ]
        },
        {
          "type": "step",
          "id": "looking-for-imps:8xdk0f",
          "html": "Return and talk to Wizard Mizgog.",
          "text": "Return and talk to Wizard Mizgog.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I've got all four beads."
                }
              ]
