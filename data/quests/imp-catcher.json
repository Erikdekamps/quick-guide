            },
            {
              "type": "step",
              "id": "looking-for-imps:spa6yy:192ua12",
              "html": "Take the <a href=\"https://runescape.wiki/w/Sanguine_bead\" target=\"_blank\" rel=\"noopener\">Sanguine bead</a> it drops.",
              "text": "Take the Sanguine bead it drops.",
              "dialogue": [],
