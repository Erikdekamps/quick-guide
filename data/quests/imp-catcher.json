            }
          ]
        },
        {
          "type": "step",
          "id": "looking-for-imps:spa6yy",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Air_ruins\" target=\"_blank\" rel=\"noopener\">Air ruins</a> (west of <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>; southeast of <a href=\"https://runescape.wiki/w/Barbarian_Village\" target=\"_blank\" rel=\"noopener\">Barbarian Village</a>) and talk to the <a href=\"https://runescape.wiki/w/Sanguine_imp\" target=\"_blank\" rel=\"noopener\">Sanguine imp</a>.",
          "text": "Go to the Air ruins (west of Varrock; southeast of Barbarian Village) and talk to the Sanguine imp.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "looking-for-imps:spa6yy:117trlq",
              "html": "Race the imp around the altar 4 times by clicking and running inside the four different checkpoints when they appear.",
              "text": "Race the imp around the altar 4 times by clicking and running inside the four different checkpoints when they appear.",
              "dialogue": [],
              "images": [],
