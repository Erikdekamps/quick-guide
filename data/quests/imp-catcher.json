  "sections": [
    {
      "id": "looking-for-imps",
      "title": "Looking for imps",
      "anchor": "Looking_for_imps",
      "blocks": [
        {
          "type": "step",
          "id": "looking-for-imps:vb85tq",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Wizard_Mizgog\" target=\"_blank\" rel=\"noopener\">Wizard Mizgog</a> on the 1<sup>st</sup> floor (UK) / 2<sup>nd</sup> floor (US) of the <a href=\"https://runescape.wiki/w/Wizards%27_Tower\" target=\"_blank\" rel=\"noopener\">Wizards&#39; Tower</a>, just southeast of the beam.",
          "text": "Talk to Wizard Mizgog on the 1st floor (UK) / 2nd floor (US) of the Wizards' Tower, just southeast of the beam.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Can I help you?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "looking-for-imps:vb85tq:18o8r5v",
              "html": "Make a <a href=\"https://runescape.wiki/w/Bowl_of_hot_water\" target=\"_blank\" rel=\"noopener\">bowl of hot water</a> if you haven&#39;t already, by filling a <a href=\"https://runescape.wiki/w/Bowl\" target=\"_blank\" rel=\"noopener\">bowl</a> at a water source, then using it on a <a href=\"https://runescape.wiki/w/Cooking_range\" target=\"_blank\" rel=\"noopener\">Cooking range</a> (all available in the Lumbridge Castle kitchen - If you have not done <a href=\"https://runescape.wiki/w/Cook%27s_Assistant\" target=\"_blank\" rel=\"noopener\">Cook&#39;s Assistant</a>, you can use the range in the southeasternmost house in Lumbridge, south of Bob&#39;s Axes). You may also light a fire and use a bowl of water on it.",
              "text": "Make a bowl of hot water if you haven't already, by filling a bowl at a water source, then using it on a Cooking range (all available in the Lumbridge Castle kitchen - If you have not done Cook's Assistant, you can use the range in the southeasternmost house in Lumbridge, south of Bob's Axes). You may also light a fire and use a bowl of water on it.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "looking-for-imps:10whb91",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Water_ruins\" target=\"_blank\" rel=\"noopener\">Water ruins</a> (west side of <a href=\"https://runescape.wiki/w/Lumbridge_Swamp\" target=\"_blank\" rel=\"noopener\">Lumbridge Swamp</a>) and talk to the <a href=\"https://runescape.wiki/w/Phlegmatic_imp\" target=\"_blank\" rel=\"noopener\">Phlegmatic imp</a>.",
          "text": "Go to the Water ruins (west side of Lumbridge Swamp) and talk to the Phlegmatic imp.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Have you tried a bowl of hot water?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "looking-for-imps:10whb91:syndol",
              "html": "Talk to the imp again, with a <a href=\"https://runescape.wiki/w/Bowl_of_hot_water\" target=\"_blank\" rel=\"noopener\">bowl of hot water</a> in your inventory.",
              "text": "Talk to the imp again, with a bowl of hot water in your inventory.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "looking-for-imps:10whb91:juoj94",
              "html": "Take the <a href=\"https://runescape.wiki/w/Phlegmatic_bead\" target=\"_blank\" rel=\"noopener\">Phlegmatic bead</a> it drops.",
              "text": "Take the Phlegmatic bead it drops.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "looking-for-imps:86jrgf",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Fire_ruins\" target=\"_blank\" rel=\"noopener\">Fire ruins</a> (north of <a href=\"https://runescape.wiki/w/Al_Kharid\" target=\"_blank\" rel=\"noopener\">Al Kharid</a>; outside <a href=\"https://runescape.wiki/w/Het%27s_Oasis\" target=\"_blank\" rel=\"noopener\">Het&#39;s Oasis</a>), talk to and fight the <a href=\"https://runescape.wiki/w/Choleric_imp\" target=\"_blank\" rel=\"noopener\">Choleric imp</a>.",
          "text": "Go to the Fire ruins (north of Al Kharid; outside Het's Oasis), talk to and fight the Choleric imp.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "looking-for-imps:86jrgf:1kd9upb",
              "html": "Take the <a href=\"https://runescape.wiki/w/Choleric_bead\" target=\"_blank\" rel=\"noopener\">Choleric bead</a> it drops.",
              "text": "Take the Choleric bead it drops.",
