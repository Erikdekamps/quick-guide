        {
          "type": "step",
          "id": "looking-for-imps:hbealr",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Earth_ruins\" target=\"_blank\" rel=\"noopener\">Earth ruins</a> (north-east of <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>; south of <a href=\"https://runescape.wiki/w/Fort_Forinthry\" target=\"_blank\" rel=\"noopener\">Fort Forinthry</a>) and cheer up the <a href=\"https://runescape.wiki/w/Melancholic_imp\" target=\"_blank\" rel=\"noopener\">Melancholic imp</a>.",
          "text": "Go to the Earth ruins (north-east of Varrock; south of Fort Forinthry) and cheer up the Melancholic imp.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Why would he be disappointed?"
                },
                {
                  "key": "2",
                  "text": "Some days you'll have setbacks. Tomorrow is new day."
                },
                {
                  "key": "1",
                  "text": "Take your time. No one is rushing you to feel better."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "looking-for-imps:hbealr:142uoh3",
              "html": "Take the <a href=\"https://runescape.wiki/w/Melancholic_bead\" target=\"_blank\" rel=\"noopener\">Melancholic bead</a> it drops.",
              "text": "Take the Melancholic bead it drops.",
              "dialogue": [],
              "images": [],
              "tables": [],
