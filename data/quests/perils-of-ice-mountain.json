    {
      "id": "finishing-up",
      "title": "Finishing Up",
      "anchor": "Finishing_Up",
      "blocks": [
        {
          "type": "step",
          "id": "finishing-up:14ftxzs",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Drorkar\" target=\"_blank\" rel=\"noopener\">Drorkar</a> at the <a href=\"https://runescape.wiki/w/Power_Station\" target=\"_blank\" rel=\"noopener\">Power Station</a>.",
          "text": "Talk to Drorkar at the Power Station.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "You've got to shut down this power station."
                },
                {
                  "key": "4",
                  "text": "The Oracle predicted it would cause the end of civilisation!"
                },
                {
                  "key": "4",
                  "text": "I'll go and talk to Nurmof, then."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "finishing-up:1lcis5l",
          "html": "Pickpocket Drorkar for a <a href=\"https://runescape.wiki/w/Dwarven_key\" target=\"_blank\" rel=\"noopener\">Dwarven key</a>.",
          "text": "Pickpocket Drorkar for a Dwarven key.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "finishing-up:yv1v4x",
          "html": "Go in the Dwarven Mines and talk to <a href=\"https://runescape.wiki/w/Nurmof\" target=\"_blank\" rel=\"noopener\">Nurmof</a> in the north-western corner of the mines, at the pickaxe shop.",
          "text": "Go in the Dwarven Mines and talk to Nurmof in the north-western corner of the mines, at the pickaxe shop.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "4",
                  "text": "You've got to shut down the power station!"
                },
                {
                  "key": "1",
                  "text": "What was this other power source?"
                },
                {
                  "key": "3",
                  "text": "Goodbye."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "finishing-up:1ixa2zp",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Brother_Bordiss\" target=\"_blank\" rel=\"noopener\">Brother Bordiss</a> at the <a href=\"https://runescape.wiki/w/Edgeville_Monastery\" target=\"_blank\" rel=\"noopener\">Edgeville Monastery</a>.",
          "text": "Talk to Brother Bordiss at the Edgeville Monastery.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Nurmof says you made plans for an alternative power station."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "finishing-up:19jwlbw",
          "html": "Head back down into the <a href=\"https://runescape.wiki/w/Map:Dwarven_Mine\" target=\"_blank\" rel=\"noopener\">Dwarven Mines</a>, then immediately east into a small alcove.",
          "text": "Head back down into the Dwarven Mines, then immediately east into a small alcove.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "finishing-up:mv9be9",
          "html": "Open the small, bright <a href=\"https://runescape.wiki/w/Chest_(Perils_of_Ice_Mountain)\" target=\"_blank\" rel=\"noopener\">chest</a> against the north wall.",
          "text": "Open the small, bright chest against the north wall.",
