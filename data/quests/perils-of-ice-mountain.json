    {
      "id": "ice-mountain",
      "title": "Ice Mountain",
      "anchor": "Ice_Mountain",
      "blocks": [
        {
          "type": "step",
          "id": "ice-mountain:bcyulv",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Professor_Arblenap\" target=\"_blank\" rel=\"noopener\">Professor Arblenap</a> (the gnome) half way up to the top of <a href=\"https://runescape.wiki/w/Ice_Mountain\" target=\"_blank\" rel=\"noopener\">Ice Mountain</a>.",
          "text": "Talk to Professor Arblenap (the gnome) half way up to the top of Ice Mountain.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What are you doing?"
                },
                {
                  "key": "2",
                  "text": "Can I help?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ice-mountain:5zcry2",
          "html": "Wield the <a href=\"https://runescape.wiki/w/Icefiend_net\" target=\"_blank\" rel=\"noopener\">icefiend net</a> and catch the four <a href=\"https://runescape.wiki/w/Baby_icefiend\" target=\"_blank\" rel=\"noopener\">baby icefiends</a>.",
          "text": "Wield the icefiend net and catch the four baby icefiends.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ice-mountain:1750fu6",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Professor_Arblenap\" target=\"_blank\" rel=\"noopener\">Professor Arblenap</a>.",
          "text": "Talk to Professor Arblenap.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ice-mountain:1i08l2p",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Oracle\" target=\"_blank\" rel=\"noopener\">Oracle</a>, who is just north on the mountain.",
          "text": "Talk to the Oracle, who is just north on the mountain.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What happened to your tent?"
                },
                {
                  "key": "1",
                  "text": "I could fix your tent for you."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ice-mountain:1hintnh",
          "html": "Take the wrecked tent from the base of the mountain, south of the <a href=\"https://runescape.wiki/w/Black_Knights%27_Fortress\" target=\"_blank\" rel=\"noopener\">Black Knights&#39; Fortress</a> entrance and east of the <a href=\"https://runescape.wiki/w/Oracle\" target=\"_blank\" rel=\"noopener\">Oracle</a>. It does not appear as a red dot on the minimap.",
          "text": "Take the wrecked tent from the base of the mountain, south of the Black Knights' Fortress entrance and east of the Oracle. It does not appear as a red dot on the minimap.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ice-mountain:fi11uf",
          "html": "With the <a href=\"https://runescape.wiki/w/Tent\" target=\"_blank\" rel=\"noopener\">tent</a>, two <a href=\"https://runescape.wiki/w/Planks\" target=\"_blank\" rel=\"noopener\">planks</a>, and two <a href=\"https://runescape.wiki/w/Nails\" target=\"_blank\" rel=\"noopener\">nails</a>, use the tent on the remains atop the mountain, next to the Oracle.",
          "text": "With the tent, two planks, and two nails, use the tent on the remains atop the mountain, next to the Oracle.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ice-mountain:1fzary1",
