        {
          "type": "step",
          "id": "getting-started:9qgfxj",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Lakki_the_delivery_dwarf\" target=\"_blank\" rel=\"noopener\">Lakki the delivery dwarf</a>, who can be found to the east of the Invention Guild, north of <a href=\"https://runescape.wiki/w/Falador\" target=\"_blank\" rel=\"noopener\">Falador</a>.",
          "text": "Talk to Lakki the delivery dwarf, who can be found to the east of the Invention Guild, north of Falador.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What's the matter?"
                },
                {
                  "key": "1",
                  "text": "I could help you find the crate."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
