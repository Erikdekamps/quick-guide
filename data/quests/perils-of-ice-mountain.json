        {
          "type": "step",
          "id": "delivery:1c0478g",
          "html": "Along the path west towards Falador are eight bushes you can search. Search each of them until a crate is found.",
          "text": "Along the path west towards Falador are eight bushes you can search. Search each of them until a crate is found.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "delivery:1yiz4jr",
          "html": "Give the <a href=\"https://runescape.wiki/w/Crate_(Perils_of_Ice_Mountain)\" target=\"_blank\" rel=\"noopener\">crate</a> to <a href=\"https://runescape.wiki/w/Drorkar\" target=\"_blank\" rel=\"noopener\">Drorkar</a>, who is in the <a href=\"https://runescape.wiki/w/Power_Station\" target=\"_blank\" rel=\"noopener\">Power Station</a> west of the <a href=\"https://runescape.wiki/w/Dwarven_Mine\" target=\"_blank\" rel=\"noopener\">Dwarven Mines</a>.",
          "text": "Give the crate to Drorkar, who is in the Power Station west of the Dwarven Mines.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                },
                {
                  "key": "2",
                  "text": "Okay."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "delivery:1u5yn94",
          "html": "Head to the <a href=\"https://runescape.wiki/w/Edgeville_Monastery\" target=\"_blank\" rel=\"noopener\">Edgeville Monastery</a> (use the <a href=\"https://runescape.wiki/w/Edgeville_lodestone\" target=\"_blank\" rel=\"noopener\">Edgeville lodestone</a> to save time).",
          "text": "Head to the Edgeville Monastery (use the Edgeville lodestone to save time).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "delivery:pl2hs3",
          "html": "Give the <a href=\"https://runescape.wiki/w/Letter_(Perils_of_Ice_Mountain)\" target=\"_blank\" rel=\"noopener\">letter</a> to <a href=\"https://runescape.wiki/w/Brother_Bordiss\" target=\"_blank\" rel=\"noopener\">Brother Bordiss</a> in the garden.",
          "text": "Give the letter to Brother Bordiss in the garden.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I have a letter for you."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "delivery:1y0tvxb",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Brother_Althric\" target=\"_blank\" rel=\"noopener\">Brother Althric</a>.",
          "text": "Talk to Brother Althric.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Can I help?"
                },
                {
                  "key": "1",
                  "text": "I'll go and get some compost."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "delivery:17y7t66",
          "html": "Use <a href=\"https://runescape.wiki/w/Compost\" target=\"_blank\" rel=\"noopener\">compost</a> on the dying roses, then water them. If your watering can is empty, you may use the fountains in the monastery to fill it.",
          "text": "Use compost on the dying roses, then water them. If your watering can is empty, you may use the fountains in the monastery to fill it.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
