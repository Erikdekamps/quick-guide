    {
      "id": "beginning",
      "title": "Beginning",
      "anchor": "Beginning",
      "blocks": [
        {
          "type": "bring",
          "needed": [],
          "recommended": [
            {
              "id": "beginning:bring:1o1k95h",
              "html": "<a href=\"https://runescape.wiki/w/Rellekka_tablet\" target=\"_blank\" rel=\"noopener\">Rellekka tablet</a> or <a href=\"https://runescape.wiki/w/Enchanted_lyre\" target=\"_blank\" rel=\"noopener\">enchanted lyre</a>",
              "text": "Rellekka tablet or enchanted lyre"
            }
          ]
        },
        {
          "type": "step",
          "id": "beginning:1mxk7h3",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Kharshai\" target=\"_blank\" rel=\"noopener\">Kharshai</a>, located under the helmet shop in <a href=\"https://runescape.wiki/w/Rellekka\" target=\"_blank\" rel=\"noopener\">Rellekka</a>. Agree to help him.",
          "text": "Speak to Kharshai, located under the helmet shop in Rellekka. Agree to help him.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I want to talk about the Mahjarrat memories."
                },
                {
                  "key": "1",
                  "text": "Tell me more."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "1",
                  "text": "Sign the contract."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "beginning:1g0cbt1",
          "html": "With the <a href=\"https://runescape.wiki/w/Engrammeter\" target=\"_blank\" rel=\"noopener\">engrammeter</a>, head to any divination colony of <a href=\"https://runescape.wiki/w/Vibrant_wisp\" target=\"_blank\" rel=\"noopener\">vibrant wisps</a> or higher. Fill it with 500 divine memories.",
          "text": "With the engrammeter, head to any divination colony of vibrant wisps or higher. Fill it with 500 divine memories.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "beginning:1g0cbt1:1xhobad",
              "html": "You may utilise World 79 (Community Divination World) for more frequent enriched springs.",
              "text": "You may utilise World 79 (Community Divination World) for more frequent enriched springs.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "beginning:1iom63r",
          "html": "Visit the locations below, use the charged engrameter to collect the memory.",
          "text": "Visit the locations below, use the charged engrameter to collect the memory.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "beginning:merqkg",
          "html": "Return to Kharshai. Talk to him to give him the memory.",
          "text": "Return to Kharshai. Talk to him to give him the memory.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I want to talk about the Mahjarrat memories."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "beginning:1f2pgte",
          "html": "Recharge the engrammeter with another 500 divine memories, and repeat for the remaining 14 memories.",
          "text": "Recharge the engrammeter with another 500 divine memories, and repeat for the remaining 14 memories.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "text",
          "html": "You must visit Kharshai after finding each memory. The engrammeter cannot be recharged with divine memories until the previous Mahjarrat memory has been transcribed into a book."
        }
      ]
    },
