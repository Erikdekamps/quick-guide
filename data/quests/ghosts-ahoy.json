        {
          "type": "step",
          "id": "the-map:j8prs1",
          "html": "Go inside the shipwreck just north of <a href=\"https://runescape.wiki/w/Alice%27s_farm\" target=\"_blank\" rel=\"noopener\">Alice&#39;s farm</a>, east of the <a href=\"https://runescape.wiki/w/Canifis_lodestone\" target=\"_blank\" rel=\"noopener\">Canifis lodestone</a>.",
          "text": "Go inside the shipwreck just north of Alice's farm, east of the Canifis lodestone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-map:sj9ch9",
          "html": "Climb the ladders to reach the top deck (there is a ladder on the outer cabin wall).",
          "text": "Climb the ladders to reach the top deck (there is a ladder on the outer cabin wall).",
