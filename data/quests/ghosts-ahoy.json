              "text": "Nettle tea"
            },
            {
              "id": "getting-help:bring:156vnb8",
              "html": "<a href=\"https://runescape.wiki/w/Silk\" target=\"_blank\" rel=\"noopener\">Silk</a>",
              "text": "Silk"
            },
            {
              "id": "getting-help:bring:1t2znv5",
              "html": "<a href=\"https://runescape.wiki/w/Thread\" target=\"_blank\" rel=\"noopener\">Thread</a>",
