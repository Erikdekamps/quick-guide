  "sections": [
    {
      "id": "ghostly-trouble",
      "title": "Ghostly trouble",
      "anchor": "Ghostly_trouble",
      "blocks": [
        {
          "type": "bring",
          "needed": [
            {
              "id": "ghostly-trouble:bring:15zkpyc",
              "html": "<a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">Ghostspeak amulet</a>",
              "text": "Ghostspeak amulet"
            }
          ],
          "recommended": []
        },
        {
          "type": "step",
          "id": "ghostly-trouble:su39dm",
          "html": "To enter <a href=\"https://runescape.wiki/w/Port_Phasmatys\" target=\"_blank\" rel=\"noopener\">Port Phasmatys</a>, either pay two <a href=\"https://runescape.wiki/w/Ecto-token\" target=\"_blank\" rel=\"noopener\">ecto-tokens</a> as an entrance fee to pass the <a href=\"https://runescape.wiki/w/Energy_Barrier_(Port_Phasmatys)\" target=\"_blank\" rel=\"noopener\">energy barrier</a> or <a href=\"https://runescape.wiki/w/Charter_ship\" target=\"_blank\" rel=\"noopener\">charter a ship</a> to reach the town. Each entry through the barrier, until the end of the quest, will cost two ecto-tokens.",
          "text": "To enter Port Phasmatys, either pay two ecto-tokens as an entrance fee to pass the energy barrier or charter a ship to reach the town. Each entry through the barrier, until the end of the quest, will cost two ecto-tokens.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghostly-trouble:47wkj5",
          "html": "Equip the <a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">ghostspeak amulet</a>. You need to equip the amulet when you talk to the ghost residents in the town.",
          "text": "Equip the ghostspeak amulet. You need to equip the amulet when you talk to the ghost residents in the town.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghostly-trouble:3ifg3w",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Velorina\" target=\"_blank\" rel=\"noopener\">Velorina</a> at Port Phasmatys, in the northernmost building just east of the entrance.",
          "text": "Talk to Velorina at Port Phasmatys, in the northernmost building just east of the entrance.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Why, what is the matter?"
                },
                {
                  "key": "1",
                  "text": "Yes, I do. It is a very sad story."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghostly-trouble:1cdlaud",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Necrovarus\" target=\"_blank\" rel=\"noopener\">Necrovarus</a> at the <a href=\"https://runescape.wiki/w/Ectofuntus\" target=\"_blank\" rel=\"noopener\">Ectofuntus</a> just outside the town, to the north.",
          "text": "Talk to Necrovarus at the Ectofuntus just outside the town, to the north.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghostly-trouble:b5tfol",
          "html": "If you do not already have a <a href=\"https://runescape.wiki/w/Bucket_of_slime\" target=\"_blank\" rel=\"noopener\">bucket of slime</a>, obtain it now for later use in the quest.",
          "text": "If you do not already have a bucket of slime, obtain it now for later use in the quest.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "ghostly-trouble:b5tfol:ttbtvs",
              "html": "Open and climb down the <a href=\"https://runescape.wiki/w/Trapdoor_(Ectofuntus)\" target=\"_blank\" rel=\"noopener\">trapdoor</a> on the west side of the Ectofuntus to enter the basement. You do not need a bucket to obtain one.",
              "text": "Open and climb down the trapdoor on the west side of the Ectofuntus to enter the basement. You do not need a bucket to obtain one.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "ghostly-trouble:b5tfol:n6yrjd",
              "html": "If you intend to proceed with the quest <a href=\"https://runescape.wiki/w/Vessel_of_the_Harbinger\" target=\"_blank\" rel=\"noopener\">Vessel of the Harbinger</a> after this quest, obtain the second one.",
              "text": "If you intend to proceed with the quest Vessel of the Harbinger after this quest, obtain the second one.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "ghostly-trouble:1p882rm",
          "html": "Talk to Velorina.",
          "text": "Talk to Velorina.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Do you know where this woman can be found?"
