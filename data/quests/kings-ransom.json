          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-holy-grail:86vc2h",
          "html": "<i>Search</i> the table and click the purple cylinder second from the right.",
          "text": "Search the table and click the purple cylinder second from the right.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
