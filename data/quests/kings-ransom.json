            {
              "when": "Talk to Pierre",
              "options": [
                {
                  "key": "2",
                  "text": "Ask about the thread"
                },
                {
                  "key": "3",
                  "text": "Ask about the poison"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "courtroom-drama:7k06fo:dzg1o7",
              "html": "You may need to resize your interface and zoom out before descending the stairs since he appears near the bottom of the screen.",
