    {
      "id": "jailbreaker",
      "title": "Jailbreaker",
      "anchor": "Jailbreaker",
      "blocks": [
        {
          "type": "bring",
          "needed": [
            {
              "id": "jailbreaker:bring:1yw0id0",
              "html": "1 <a href=\"https://runescape.wiki/w/Air_rune\" target=\"_blank\" rel=\"noopener\">air rune</a> and 1 <a href=\"https://runescape.wiki/w/Law_rune\" target=\"_blank\" rel=\"noopener\">law rune</a> for <a href=\"https://runescape.wiki/w/Telekinetic_Grab\" target=\"_blank\" rel=\"noopener\">Telekinetic Grab</a>",
              "text": "1 air rune and 1 law rune for Telekinetic Grab"
            }
          ],
          "recommended": []
        },
        {
          "type": "step",
          "id": "jailbreaker:1294vrc",
          "html": "Go to the northeast of <a href=\"https://runescape.wiki/w/Camelot_Castle\" target=\"_blank\" rel=\"noopener\">Camelot Castle</a>, outside of the castle hedges",
          "text": "Go to the northeast of Camelot Castle, outside of the castle hedges",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "jailbreaker:1caju6o",
          "html": "Search the statue.",
          "text": "Search the statue.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "jailbreaker:66wshj",
          "html": "Talk to Merlin.",
          "text": "Talk to Merlin.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "What do we do now?"
                },
                {
                  "key": "1",
                  "text": "Reclaim Camelot."
                },
                {
                  "key": "2",
                  "text": "Retrieve the Holy Grail."
                },
                {
                  "key": "3",
                  "text": "Save King Arthur."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "jailbreaker:1qvs6br",
          "html": "<i>Reach</i> the vent on the northern wall, it should trigger a cutscene in which the imprisoned knights lift Merlin out. Do not reach for the vent again afterwards.",
          "text": "Reach the vent on the northern wall, it should trigger a cutscene in which the imprisoned knights lift Merlin out. Do not reach for the vent again afterwards.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "jailbreaker:1qvs6br:1qrf3no",
              "html": "If you don&#39;t see a cutscene, then talk to Merlin again and exhaust all options.",
              "text": "If you don't see a cutscene, then talk to Merlin again and exhaust all options.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "jailbreaker:12axnl0",
          "html": "Cast <a href=\"https://runescape.wiki/w/Telekinetic_Grab\" target=\"_blank\" rel=\"noopener\">Telekinetic Grab</a> on the guard fixing his hair outside your cell door. Ask the knights around if you didn&#39;t bring any Telekinetic Grab runes.",
          "text": "Cast Telekinetic Grab on the guard fixing his hair outside your cell door. Ask the knights around if you didn't bring any Telekinetic Grab runes.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "jailbreaker:12axnl0:r7iwd5",
              "html": "Drop trick will work here if you would like an extra <a href=\"https://runescape.wiki/w/Hairclip\" target=\"_blank\" rel=\"noopener\">hairclip</a>.",
              "text": "Drop trick will work here if you would like an extra hairclip.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "jailbreaker:1hh7ama",
          "html": "Use the hairclip on the metal door.",
          "text": "Use the hairclip on the metal door.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "jailbreaker:wje077",
          "html": "Complete the puzzle.",
          "text": "Complete the puzzle.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "jailbreaker:wje077:z8mkru",
              "html": "To complete this puzzle, you must set each of four tumblers to the correct height. The most foolproof way to do this (although not necessarily the quickest) is to set all tumblers to the lowest height and try the lock.",
              "text": "To complete this puzzle, you must set each of four tumblers to the correct height. The most foolproof way to do this (although not necessarily the quickest) is to set all tumblers to the lowest height and try the lock.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "jailbreaker:wje077:130cmz5",
              "html": "If a tumbler shows a green circle, do not change that tumbler anymore.",
              "text": "If a tumbler shows a green circle, do not change that tumbler anymore.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "jailbreaker:wje077:1om1j8f",
              "html": "For the remaining tumblers, they will each show a blue or red circle. Increase those tumblers height by one and try again.",
              "text": "For the remaining tumblers, they will each show a blue or red circle. Increase those tumblers height by one and try again.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "jailbreaker:wje077:mfsfa5",
              "html": "Continue until the lock unlocks. This method will take at most six attempts.",
              "text": "Continue until the lock unlocks. This method will take at most six attempts.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
    {
      "id": "the-holy-grail",
