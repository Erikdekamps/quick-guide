        {
          "type": "step",
          "id": "courtroom-drama:1kq3az2",
          "html": "For the following options, talk to the judge to call a witness, then choose who you would like to call:",
          "text": "For the following options, talk to the judge to call a witness, then choose who you would like to call:",
          "dialogue": [],
          "images": [],
