    {
      "id": "courtroom-drama",
      "title": "Courtroom drama",
      "anchor": "Courtroom_drama",
      "blocks": [
        {
          "type": "step",
          "id": "courtroom-drama:1b3bafl",
          "html": "Dismiss any followers you might have and go down the stairs to begin the trial.",
          "text": "Dismiss any followers you might have and go down the stairs to begin the trial.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes, I'm ready."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "courtroom-drama:7k06fo",
          "html": "Call the <a href=\"https://runescape.wiki/w/Pierre\" target=\"_blank\" rel=\"noopener\">dog handler</a> as a witness",
          "text": "Call the dog handler as a witness",
          "dialogue": [
            {
              "when": null,
