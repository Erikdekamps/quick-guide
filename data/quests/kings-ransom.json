        },
        {
          "type": "step",
          "id": "the-sinclairs:jboy3e",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Seers%27_Village_Courthouse\" target=\"_blank\" rel=\"noopener\">Seers&#39; Village Courthouse</a>, directly south from the mansion gates.",
          "text": "Go to the Seers' Village Courthouse, directly south from the mansion gates.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
