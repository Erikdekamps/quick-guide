        {
          "type": "step",
          "id": "flambeed:1masdg2",
          "html": "<a href=\"https://runescape.wiki/w/Ice_gloves\" target=\"_blank\" rel=\"noopener\">Ice gloves</a> must be used if using a weapon. Be sure to have a backpack space for your weapon, which will automatically be unequipped when engaging <a href=\"https://runescape.wiki/w/Flambeed\" target=\"_blank\" rel=\"noopener\">Flambeed</a>. If you do not have backpack space when Flambeed spawns, your ice gloves might be sent to your bank to make room for your weapon in the backpack.",
          "text": "Ice gloves must be used if using a weapon. Be sure to have a backpack space for your weapon, which will automatically be unequipped when engaging Flambeed. If you do not have backpack space when Flambeed spawns, your ice gloves might be sent to your bank to make room for your weapon in the backpack.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "flambeed:63nbqb",
          "html": "Using <a href=\"https://runescape.wiki/w/Water_spells\" target=\"_blank\" rel=\"noopener\">water spells</a> or <a href=\"https://runescape.wiki/w/Ranged\" target=\"_blank\" rel=\"noopener\">ranged</a> attack is effective against him.",
          "text": "Using water spells or ranged attack is effective against him.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
