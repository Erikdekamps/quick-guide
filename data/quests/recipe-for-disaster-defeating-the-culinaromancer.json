  "sections": [
    {
      "id": "notes",
      "title": "Notes",
      "anchor": "Notes",
      "blocks": [
        {
          "type": "step",
          "id": "notes:5dsuxg",
          "html": "It is recommended to bring good <a href=\"https://runescape.wiki/w/Food\" target=\"_blank\" rel=\"noopener\">food</a> and possibly <a href=\"https://runescape.wiki/w/Super_potions\" target=\"_blank\" rel=\"noopener\">super potions</a>.",
          "text": "It is recommended to bring good food and possibly super potions.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "notes:1aw87aw",
          "html": "<a href=\"https://runescape.wiki/w/Prayers\" target=\"_blank\" rel=\"noopener\">Prayers</a> and <a href=\"https://runescape.wiki/w/Ancient_Curses\" target=\"_blank\" rel=\"noopener\">Ancient Curses</a>, <a href=\"https://runescape.wiki/w/Summoning_familiars\" target=\"_blank\" rel=\"noopener\">Summoning familiars</a>, and <a href=\"https://runescape.wiki/w/Cannons\" target=\"_blank\" rel=\"noopener\">cannons</a> cannot be used.",
          "text": "Prayers and Ancient Curses, Summoning familiars, and cannons cannot be used.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "notes:ptyawo",
          "html": "Each boss spawns immediately after its predecessor is defeated.",
          "text": "Each boss spawns immediately after its predecessor is defeated.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "notes:1dhcoec",
          "html": "Leaving the boss area and restocking after each boss is allowed.",
          "text": "Leaving the boss area and restocking after each boss is allowed.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "notes:1880c4c",
          "html": "If killed, your <a href=\"https://runescape.wiki/w/Gravestone\" target=\"_blank\" rel=\"noopener\">gravestone</a> will appear right outside the <a href=\"https://runescape.wiki/w/Culinaromancer\" target=\"_blank\" rel=\"noopener\">Culinaromancer</a> portal.",
          "text": "If killed, your gravestone will appear right outside the Culinaromancer portal.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "notes:v03mz1",
          "html": "The <a href=\"https://runescape.wiki/w/Gelatinnoth_Mother\" target=\"_blank\" rel=\"noopener\">Gelatinnoth Mother</a> <b>cannot</b> be damaged with necromancy attack. She can be damaged with poison damage from <a href=\"https://runescape.wiki/w/Putrid_Guardian_(Putrid_Zombie)\" target=\"_blank\" rel=\"noopener\">Putrid Zombie</a>.",
          "text": "The Gelatinnoth Mother cannot be damaged with necromancy attack. She can be damaged with poison damage from Putrid Zombie.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
