    {
      "id": "flambeed",
      "title": "Flambeed",
      "anchor": "Flambeed",
      "blocks": [
        {
          "type": "text",
          "html": "Main article: <a href=\"https://runescape.wiki/w/Flambeed\" target=\"_blank\" rel=\"noopener\">Flambeed</a>"
