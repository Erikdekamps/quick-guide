        },
        {
          "type": "step",
          "id": "first-scorpion:c0i1rh",
          "html": "Teleport to the Seers&#39; Village lodestone, run east, and speak to a <a href=\"https://runescape.wiki/w/Seer\" target=\"_blank\" rel=\"noopener\">Seer</a> (south-west of the bank). (You have to wait for a while until dialogue appears again)",
          "text": "Teleport to the Seers' Village lodestone, run east, and speak to a Seer (south-west of the bank). (You have to wait for a while until dialogue appears again)",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Talk about Scorpion Catcher."
                },
                {
                  "key": "2",
                  "text": "Your friend Thormac sent me to speak to you."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "first-scorpion:hy1tnf",
          "html": "Bring the scorpion cage and go into <a href=\"https://runescape.wiki/w/Taverley_Dungeon\" target=\"_blank\" rel=\"noopener\">Taverley Dungeon</a> and enter the <a href=\"https://runescape.wiki/w/Poison_spider\" target=\"_blank\" rel=\"noopener\">poison spider</a> area. You need to use the dusty key on the blue dragon door and follow the dungeon around past the black demons.",
          "text": "Bring the scorpion cage and go into Taverley Dungeon and enter the poison spider area. You need to use the dusty key on the blue dragon door and follow the dungeon around past the black demons.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "first-scorpion:hy1tnf:1xhm1du",
              "html": "Note if you don&#39;t have a dusty key yet, defeat the <a href=\"https://runescape.wiki/w/Jailer\" target=\"_blank\" rel=\"noopener\">jailer</a> east of the <a href=\"https://runescape.wiki/w/Black_Knights%27_Base\" target=\"_blank\" rel=\"noopener\">Black Knights&#39; Base</a>, and pick up his dropped key. There will be a prisoner named <a href=\"https://runescape.wiki/w/Velrak_the_explorer\" target=\"_blank\" rel=\"noopener\">Velrak the explorer</a> who thanks you for freeing him and will give you the dusty key to you who is south of the jailer.",
              "text": "Note if you don't have a dusty key yet, defeat the jailer east of the Black Knights' Base, and pick up his dropped key. There will be a prisoner named Velrak the explorer who thanks you for freeing him and will give you the dusty key to you who is south of the jailer.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "first-scorpion:16w6m6r",
          "html": "Directly south of the level 80 Agility shortcut, search the <a href=\"https://runescape.wiki/w/Old_wall\" target=\"_blank\" rel=\"noopener\">old wall</a> to enter a small room.",
          "text": "Directly south of the level 80 Agility shortcut, search the old wall to enter a small room.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "first-scorpion:16w6m6r:14demyy",
              "html": "If the wall does not open go back to the <a href=\"https://runescape.wiki/w/Seer\" target=\"_blank\" rel=\"noopener\">Seer</a> and make sure to finish the dialogue.",
              "text": "If the wall does not open go back to the Seer and make sure to finish the dialogue.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "first-scorpion:1gmnhym",
          "html": "Use the <a href=\"https://runescape.wiki/w/Scorpion_cage\" target=\"_blank\" rel=\"noopener\">scorpion cage</a> on the <a href=\"https://runescape.wiki/w/Kharid_scorpion\" target=\"_blank\" rel=\"noopener\">Kharid scorpion</a>.",
          "text": "Use the scorpion cage on the Kharid scorpion.",
