  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:zjtjx5",
          "html": "Make sure you have 5 free inventory spaces.",
          "text": "Make sure you have 5 free inventory spaces.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1ne2f8n",
          "html": "Head to the <a href=\"https://runescape.wiki/w/Cave_Entrance_(Goblin_Cave)\" target=\"_blank\" rel=\"noopener\">cave entrance</a> located just east of the Fishing Guild&#39;s entrance. <a href=\"https://runescape.wiki/w/Manor_farm_Teleport\" target=\"_blank\" rel=\"noopener\">Manor farm Teleport</a> is a quick teleport nearby. Enter the cave and walk north-west until you find two goblin guards guarding the entrance to the temple.",
          "text": "Head to the cave entrance located just east of the Fishing Guild's entrance. Manor farm Teleport is a quick teleport nearby. Enter the cave and walk north-west until you find two goblin guards guarding the entrance to the temple.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1aqjgxw",
          "html": "Drink one dose of the <a href=\"https://runescape.wiki/w/Goblin_potion\" target=\"_blank\" rel=\"noopener\">goblin potion</a> and climb down the stairs to the north. Do not equip anything when in goblin form.",
          "text": "Drink one dose of the goblin potion and climb down the stairs to the north. Do not equip anything when in goblin form.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1qp797w",
          "html": "Once in the temple, enter the crypt through the door to the north. Equip your <a href=\"https://runescape.wiki/w/Ring_of_visibility\" target=\"_blank\" rel=\"noopener\">ring of visibility</a> and <a href=\"https://runescape.wiki/w/Amulet_of_ghostspeak\" target=\"_blank\" rel=\"noopener\">amulet of ghostspeak</a>.",
          "text": "Once in the temple, enter the crypt through the door to the north. Equip your ring of visibility and amulet of ghostspeak.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:1qp797w:1pyqojo",
              "html": "If you have received the ability to see into the Shadow Realm from Sliske, you do not need to equip the ring to see Hopespear.",
              "text": "If you have received the ability to see into the Shadow Realm from Sliske, you do not need to equip the ring to see Hopespear.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:acfpdc",
          "html": "Speak to the <a href=\"https://runescape.wiki/w/Ghost_(Hopespear)\" target=\"_blank\" rel=\"noopener\">Ghost</a>.",
          "text": "Speak to the Ghost.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I'm [Player name]"
                },
                {
                  "key": "4",
                  "text": "Tell me about the prophecy."
                },
                {
                  "key": "4",
                  "text": "Tell me more about the Chosen Commander."
                },
                {
                  "key": "3",
                  "text": "Tell me about the Big High War God."
                },
                {
                  "key": "2",
                  "text": "Why are you here?"
                },
                {
                  "key": "2",
                  "text": "I visited Yu'Biusk."
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "1",
                  "text": "What is it?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "1",
                  "text": "I'll do that."
