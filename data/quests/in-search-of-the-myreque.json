          "type": "step",
          "id": "getting-started:mg8lej",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Vanstrom_Klause\" target=\"_blank\" rel=\"noopener\">Vanstrom Klause</a> in the <a href=\"https://runescape.wiki/w/Hair_of_the_Dog\" target=\"_blank\" rel=\"noopener\">Hair of the Dog</a> tavern in <a href=\"https://runescape.wiki/w/Canifis\" target=\"_blank\" rel=\"noopener\">Canifis</a>.",
          "text": "Talk to Vanstrom Klause in the Hair of the Dog tavern in Canifis.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
