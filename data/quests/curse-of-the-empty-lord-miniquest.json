        {
          "type": "step",
          "id": "getting-started:1ncgr8f",
          "html": "Make sure you are wearing your <a href=\"https://runescape.wiki/w/Ring_of_visibility\" target=\"_blank\" rel=\"noopener\">ring of visibility</a> and your <a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">ghostspeak amulet</a>.",
          "text": "Make sure you are wearing your ring of visibility and your ghostspeak amulet.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1qrc6ac",
          "html": "Speak to the <a href=\"https://runescape.wiki/w/Mysterious_ghost_(Valdez)\" target=\"_blank\" rel=\"noopener\">Mysterious ghost</a> near <a href=\"https://runescape.wiki/w/Glarial%27s_tombstone\" target=\"_blank\" rel=\"noopener\">Glarial&#39;s tombstone</a> northwest of the <a href=\"https://runescape.wiki/w/Fishing_Guild\" target=\"_blank\" rel=\"noopener\">Fishing Guild</a>.",
