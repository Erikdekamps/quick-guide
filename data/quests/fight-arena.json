        {
          "type": "step",
          "id": "keys:1rp9s4v",
          "html": "Use the keys on Sammy&#39;s cell door north of <a href=\"https://runescape.wiki/w/Lazy_Khazard_Guard\" target=\"_blank\" rel=\"noopener\">Lazy Khazard Guard</a>.",
          "text": "Use the keys on Sammy's cell door north of Lazy Khazard Guard.",
