      "blocks": [
        {
          "type": "step",
          "id": "keys:hzz8ru",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Lazy_Khazard_Guard\" target=\"_blank\" rel=\"noopener\">Lazy Khazard Guard</a> sitting in the south-eastern corner of the jail.",
          "text": "Talk to the Lazy Khazard Guard sitting in the south-eastern corner of the jail.",
