      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:1othoye",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Lady_Servil\" target=\"_blank\" rel=\"noopener\">Lady Servil</a> west of the <a href=\"https://runescape.wiki/w/Ardougne_Monastery\" target=\"_blank\" rel=\"noopener\">Monastery</a> which is south of <a href=\"https://runescape.wiki/w/Ardougne\" target=\"_blank\" rel=\"noopener\">Ardougne</a>.",
          "text": "Talk to Lady Servil west of the Monastery which is south of Ardougne.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1mxoagu",
          "html": "Head east and into the northeasternmost building (south of the monastery).",
          "text": "Head east and into the northeasternmost building (south of the monastery).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:10coee1",
          "html": "<i>Borrow</i> the <a href=\"https://runescape.wiki/w/Khazard_armour\" target=\"_blank\" rel=\"noopener\">Khazard armour</a> from the northeasternmost <a href=\"https://runescape.wiki/w/Suit_of_armour_(Fight_Arena)\" target=\"_blank\" rel=\"noopener\">suit of armour</a>.",
          "text": "Borrow the Khazard armour from the northeasternmost suit of armour.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:z1y5la",
          "html": "Equip the armour and enter the prison south of the building where you got the equipment (east of the big circle of the arena in the map).",
          "text": "Equip the armour and enter the prison south of the building where you got the equipment (east of the big circle of the arena in the map).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
