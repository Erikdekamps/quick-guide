        {
          "type": "step",
          "id": "keys:15t6juk",
          "html": "Run back and talk to the <a href=\"https://runescape.wiki/w/Lazy_Khazard_Guard\" target=\"_blank\" rel=\"noopener\">Lazy Khazard Guard</a>. Wait for him to pass out and then <i>Steal keys</i> from the table.",
          "text": "Run back and talk to the Lazy Khazard Guard. Wait for him to pass out and then Steal keys from the table.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
