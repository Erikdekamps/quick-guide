          "substeps": []
        },
        {
          "type": "step",
          "id": "keys:h3qgfa",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Angor\" target=\"_blank\" rel=\"noopener\">Angor</a> in the bar to the west, and buy a bottle of <a href=\"https://runescape.wiki/w/Khali_brew\" target=\"_blank\" rel=\"noopener\">Khali brew</a> for five <a href=\"https://runescape.wiki/w/Coins\" target=\"_blank\" rel=\"noopener\">coins</a>.",
          "text": "Talk to Angor in the bar to the west, and buy a bottle of Khali brew for five coins.",
