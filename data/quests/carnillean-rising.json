        {
          "type": "step",
          "id": "getting-started:1wfj1lt",
          "html": "Outside the Carnillean Mansion south-west of East Ardougne, talk to <a href=\"https://runescape.wiki/w/Xenia\" target=\"_blank\" rel=\"noopener\">Xenia</a>.",
          "text": "Outside the Carnillean Mansion south-west of East Ardougne, talk to Xenia.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Yes, I remember you."
                },
                {
                  "key": "1",
                  "text": "Thanks for fixing it!"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:17y07tq",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Ceril_Carnillean\" target=\"_blank\" rel=\"noopener\">Ceril Carnillean</a>.",
          "text": "Talk to Ceril Carnillean.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "So, you want me to turn Philipe into an adventurer."
                },
                {
                  "key": "1",
                  "text": "How do you expect me to create a quest?"
                },
                {
                  "key": "1",
                  "text": "Where can I find all that stuff?"
                },
                {
                  "key": "4",
                  "text": "I'll come back later."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:prfr4p",
          "html": "Search the bookcase in the room with <a href=\"https://runescape.wiki/w/Henryeta_Carnillean\" target=\"_blank\" rel=\"noopener\">Henryeta Carnillean</a> for a book about the Carnillean family.",
          "text": "Search the bookcase in the room with Henryeta Carnillean for a book about the Carnillean family.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1i1xr8w",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Butler_Crichton\" target=\"_blank\" rel=\"noopener\">Butler Crichton</a>.",
          "text": "Talk to Butler Crichton.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Sir Ceril says you'll help me create a quest."
                },
                {
                  "key": "1",
                  "text": "Yes, let's go."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:7gwxlk",
          "html": "Head into the basement and <i>enter</i> the hole on the east wall (cutscene will begin), then head back to the house.",
