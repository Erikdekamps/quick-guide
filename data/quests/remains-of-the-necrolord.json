  "sections": [
    {
      "id": "starting-out",
      "title": "Starting out",
      "anchor": "Starting_out",
      "blocks": [
        {
          "type": "step",
          "id": "starting-out:1e472j6",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Death\" target=\"_blank\" rel=\"noopener\">Death</a> in the <a href=\"https://runescape.wiki/w/City_of_Um\" target=\"_blank\" rel=\"noopener\">City of Um</a>.",
          "text": "Talk to Death in the City of Um.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:bim16m",
          "html": "Talk to the following three <a href=\"https://runescape.wiki/w/Listless_dead\" target=\"_blank\" rel=\"noopener\">listless dead</a> around <a href=\"https://runescape.wiki/w/Daemonheim\" target=\"_blank\" rel=\"noopener\">Daemonheim</a> to free them:",
          "text": "Talk to the following three listless dead around Daemonheim to free them:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "starting-out:bim16m:byq05k",
              "html": "West of the fountain south of the <a href=\"https://runescape.wiki/w/Ring_of_kinship\" target=\"_blank\" rel=\"noopener\">ring of kinship</a>&#39;s teleport location.",
              "text": "West of the fountain south of the ring of kinship's teleport location.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "starting-out:bim16m:hruh8k",
              "html": "Beside the entrance to the <a href=\"https://runescape.wiki/w/Kal%27gerion_resource_dungeon\" target=\"_blank\" rel=\"noopener\">Kal&#39;gerion resource dungeon</a> (<a href=\"https://runescape.wiki/w/Dungeoneering_cape\" target=\"_blank\" rel=\"noopener\">Dungeoneering cape</a> teleport).",
              "text": "Beside the entrance to the Kal'gerion resource dungeon (Dungeoneering cape teleport).",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "0",
                      "text": "More..."
                    },
                    {
                      "key": "9",
                      "text": "Kal'gerion demon dungeon"
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "starting-out:bim16m:4aopu2",
              "html": "Along the east coast, at the <a href=\"https://runescape.wiki/w/Marmaros_%26_Gorgonite_Mine\" target=\"_blank\" rel=\"noopener\">Marmaros &amp; Gorgonite Mine</a> north of the <a href=\"https://runescape.wiki/w/Fremennik_ship_(Shadow_reef)\" target=\"_blank\" rel=\"noopener\">Fremennik ship (Shadow reef)</a>.",
              "text": "Along the east coast, at the Marmaros & Gorgonite Mine north of the Fremennik ship (Shadow reef).",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
    {
      "id": "exploring-the-floors-of-daemonheim",
      "title": "Exploring the floors of Daemonheim",
      "anchor": "Exploring_the_floors_of_Daemonheim",
      "blocks": [
        {
          "type": "step",
          "id": "exploring-the-floors-of-daemonheim:1hlhjo2",
          "html": "Teleport with the <a href=\"https://runescape.wiki/w/Ring_of_kinship\" target=\"_blank\" rel=\"noopener\">ring of kinship</a> again and talk to <a href=\"https://runescape.wiki/w/Necrolord_(Yudura)\" target=\"_blank\" rel=\"noopener\">Lord Yudura</a> (with <a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">ghostspeak amulet</a> equipped if you haven&#39;t completed the <a href=\"https://runescape.wiki/w/Hard_Morytania_achievements\" target=\"_blank\" rel=\"noopener\">hard Morytania achievements</a>).",
          "text": "Teleport with the ring of kinship again and talk to Lord Yudura (with ghostspeak amulet equipped if you haven't completed the hard Morytania achievements).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "exploring-the-floors-of-daemonheim:1hlhjo2:1ktrbl4",
              "html": "Lord Yudura is located immediately at the teleport location, but may be difficult to see, as he blends into the snow. Using High Contrast Mode can be helpful.",
              "text": "Lord Yudura is located immediately at the teleport location, but may be difficult to see, as he blends into the snow. Using High Contrast Mode can be helpful.",
