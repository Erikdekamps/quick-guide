            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "attack-of-the-trolls:1tg6zza",
          "html": "Smith two <a href=\"https://runescape.wiki/w/Steel_chainbody\" target=\"_blank\" rel=\"noopener\">steel chainbodies</a>.",
