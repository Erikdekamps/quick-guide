        {
          "type": "step",
          "id": "attack-of-the-trolls:3ifcno",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Doric\" target=\"_blank\" rel=\"noopener\">Doric</a> in his hut north of <a href=\"https://runescape.wiki/w/Falador\" target=\"_blank\" rel=\"noopener\">Falador</a>.",
          "text": "Speak to Doric in his hut north of Falador.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Do you have any more Smithing tasks for me?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
