  "sections": [
    {
      "id": "getting-the-ring",
      "title": "Getting the ring",
      "anchor": "Getting_the_ring",
      "blocks": [
        {
          "type": "image",
          "src": "https://runescape.wiki/images/thumb/Gunnar%27s_Ground_-_Depressed_Dororan.png/300px-Gunnar%27s_Ground_-_Depressed_Dororan.png?913d2",
          "width": 300,
          "height": 169,
          "alt": "",
          "caption": "Dororan, looking very depressed.",
          "href": "https://runescape.wiki/w/File:Gunnar%27s_Ground_-_Depressed_Dororan.png"
        },
        {
          "type": "step",
          "id": "getting-the-ring:1xodv5r",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Dororan\" target=\"_blank\" rel=\"noopener\">Dororan</a> near the eastern entrance to <a href=\"https://runescape.wiki/w/Barbarian_Village\" target=\"_blank\" rel=\"noopener\">Barbarian Village</a>.",
          "text": "Speak to Dororan near the eastern entrance to Barbarian Village.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "1",
                  "text": "Yes"
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "2",
                  "text": "Get to the point."
                },
                {
                  "key": "1",
                  "text": "There must be something you can do."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-ring:1w8ewct",
          "html": "You will receive a scroll containing a <a href=\"https://runescape.wiki/w/Love_poem\" target=\"_blank\" rel=\"noopener\">love poem</a>, go to <a href=\"https://runescape.wiki/w/Edgeville\" target=\"_blank\" rel=\"noopener\">Edgeville</a> and speak to <a href=\"https://runescape.wiki/w/Jeffery\" target=\"_blank\" rel=\"noopener\">Jeffery</a> near the furnace.",
          "text": "You will receive a scroll containing a love poem, go to Edgeville and speak to Jeffery near the furnace.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I'm here about a gold ring."
                },
                {
                  "key": "1",
                  "text": "I was hoping you would trade me a gold ring."
                },
                {
                  "key": "1",
                  "text": "This splendid love poem."
                },
                {
                  "key": "1",
                  "text": "Yes, he did."
                },
                {
                  "key": "1",
                  "text": "Just a plain, gold ring."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-ring:jjqdxg",
          "html": "Take the <a href=\"https://runescape.wiki/w/Ring_from_Jeffery\" target=\"_blank\" rel=\"noopener\">gold ring</a> back to <a href=\"https://runescape.wiki/w/Dororan\" target=\"_blank\" rel=\"noopener\">Dororan</a>.",
          "text": "Take the gold ring back to Dororan.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What do you want me to engrave?"
                },
                {
                  "key": "2",
                  "text": "That sounds simple enough."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-ring:1p9gfki",
          "html": "Click the &#39;engrave&#39; option on the <a href=\"https://runescape.wiki/w/Dororan%27s_engraved_ring\" target=\"_blank\" rel=\"noopener\">ring</a> (tool belt chisel works), and show it to <a href=\"https://runescape.wiki/w/Dororan\" target=\"_blank\" rel=\"noopener\">Dororan</a>.",
          "text": "Click the 'engrave' option on the ring (tool belt chisel works), and show it to Dororan.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "It's come out perfectly."
                },
                {
                  "key": "1",
                  "text": "Of course."
                },
                {
                  "key": "1",
                  "text": "Very well."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "promoting-the-courtship",
      "title": "Promoting the courtship",
      "anchor": "Promoting_the_courtship",
      "blocks": [
        {
          "type": "image",
          "src": "https://runescape.wiki/images/thumb/Gunnar%27s_Ground_-_Showing_Gudrun_the_ring.png/300px-Gunnar%27s_Ground_-_Showing_Gudrun_the_ring.png?c6278",
          "width": 300,
          "height": 231,
          "alt": "",
          "caption": "Showing the ring to Gudrun.",
          "href": "https://runescape.wiki/w/File:Gunnar%27s_Ground_-_Showing_Gudrun_the_ring.png"
        },
        {
          "type": "step",
          "id": "promoting-the-courtship:sc6ywk",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Gudrun\" target=\"_blank\" rel=\"noopener\">Gudrun</a> (west of Dororan), but avoid telling her that Dororan is a dwarf.",
          "text": "Speak to Gudrun (west of Dororan), but avoid telling her that Dororan is a dwarf.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                },
                {
                  "key": "1",
                  "text": "The ring isn't from me!"
                },
                {
                  "key": "1",
                  "text": "A great poet."
                },
                {
                  "key": "1",
                  "text": "So, you want me to talk to your father?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "promoting-the-courtship:lglkb6",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Gunthor\" target=\"_blank\" rel=\"noopener\">Gunthor</a>, found in the longhall.",
          "text": "Talk to Gunthor, found in the longhall.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I need to speak with you, chieftain."
                },
                {
                  "key": "1",
                  "text": "Your daughter seeks permission to court an outlander."
                },
                {
                  "key": "1",
                  "text": "You're barbarians"
                },
                {
                  "key": "1",
                  "text": "Please wait a moment."
                },
                {
                  "key": "1",
                  "text": "I'm going!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "promoting-the-courtship:iix3hk",
          "html": "Return and talk to <a href=\"https://runescape.wiki/w/Gudrun\" target=\"_blank\" rel=\"noopener\">Gudrun</a>.",
          "text": "Return and talk to Gudrun.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "What should we do now?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "the-poem",
      "title": "The poem",
      "anchor": "The_poem",
      "blocks": [
        {
          "type": "step",
          "id": "the-poem:2x9z3h",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Dororan\" target=\"_blank\" rel=\"noopener\">Dororan</a>.",
          "text": "Speak to Dororan.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "No, she liked the ring."
                },
                {
                  "key": "2",
                  "text": "What are we going to do?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-poem:cn0ltz",
          "html": "Help him with his poem.",
          "text": "Help him with his poem.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I'm sure that's not true."
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "5",
                  "text": "More words"
                },
                {
                  "key": "3",
                  "text": "Stray."
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "5",
                  "text": "More words"
                },
                {
                  "key": "1",
                  "text": "Threat."
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "5",
                  "text": "More words"
                },
                {
                  "key": "3",
                  "text": "Swept to war."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-poem:cn0ltz:scoxxm",
              "html": "The phrases are &quot;stray&quot;, &quot;threat&quot;, and &quot;swept to war&quot;.",
              "text": "The phrases are \"stray\", \"threat\", and \"swept to war\".",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
