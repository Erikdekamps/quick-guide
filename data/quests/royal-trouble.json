      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:krlp2a",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Advisor_Ghrim\" target=\"_blank\" rel=\"noopener\">Advisor Ghrim</a> in <a href=\"https://runescape.wiki/w/Miscellania\" target=\"_blank\" rel=\"noopener\">Miscellania</a>.",
          "text": "Speak to Advisor Ghrim in Miscellania.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Has anything been happening in the kingdom recently?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:krlp2a:4prhyd",
              "html": "Fast access via <a href=\"https://runescape.wiki/w/Ring_of_Wealth\" target=\"_blank\" rel=\"noopener\">Ring of Wealth</a> (or higher tier luck enhancer rings, which offer unlimited teleports), <a href=\"https://runescape.wiki/w/Fairy_ring\" target=\"_blank\" rel=\"noopener\">fairy ring</a> <b>C</b><b>I</b><b>P</b>, or the <a href=\"https://runescape.wiki/w/Sailor\" target=\"_blank\" rel=\"noopener\">sailor</a> near the larger boat north of the Rellekka market.",
              "text": "Fast access via Ring of Wealth (or higher tier luck enhancer rings, which offer unlimited teleports), fairy ring CIP, or the sailor near the larger boat north of the Rellekka market.",
