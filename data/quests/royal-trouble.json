      "blocks": [
        {
          "type": "step",
          "id": "fixing-the-lift:avzvhj",
          "html": "Pick up the <a href=\"https://runescape.wiki/w/Engine\" target=\"_blank\" rel=\"noopener\">engine</a>, 3 <a href=\"https://runescape.wiki/w/Pulley_beam\" target=\"_blank\" rel=\"noopener\">pulley beams</a>, 3 <a href=\"https://runescape.wiki/w/Beam\" target=\"_blank\" rel=\"noopener\">beams</a>, and 2 <a href=\"https://runescape.wiki/w/Rope\" target=\"_blank\" rel=\"noopener\">rope</a> from the crates.",
          "text": "Pick up the engine, 3 pulley beams, 3 beams, and 2 rope from the crates.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "fixing-the-lift:avzvhj:kb1x6f",
              "html": "There is a bug where sometimes you won&#39;t be able to pick up the engine. Leave the dungeon and come back, or try to use area loot.",
              "text": "There is a bug where sometimes you won't be able to pick up the engine. Leave the dungeon and come back, or try to use area loot.",
