        {
          "type": "step",
          "id": "obtaining-blueberry-pie:7yt09e",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Lupe\" target=\"_blank\" rel=\"noopener\">Lupe</a> in her shop, <a href=\"https://runescape.wiki/w/Soul_Supplies\" target=\"_blank\" rel=\"noopener\">Soul Supplies</a>, the general store of the <a href=\"https://runescape.wiki/w/City_of_Um\" target=\"_blank\" rel=\"noopener\">City of Um</a>.",
          "text": "Talk to Lupe in her shop, Soul Supplies, the general store of the City of Um.",
