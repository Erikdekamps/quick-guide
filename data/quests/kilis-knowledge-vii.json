          "substeps": []
        },
        {
          "type": "step",
          "id": "obtaining-blueberry-pie:1bwqldq",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Kharen\" target=\"_blank\" rel=\"noopener\">Kharen</a> near her <a href=\"https://runescape.wiki/w/Gondola\" target=\"_blank\" rel=\"noopener\">gondola</a>, just north of Lupe.",
