        {
          "type": "step",
          "id": "getting-started:nv5f1v",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Sir_Prysin\" target=\"_blank\" rel=\"noopener\">Sir Prysin</a> in a house north-west of the church.",
