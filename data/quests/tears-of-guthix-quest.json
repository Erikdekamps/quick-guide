          "href": ""
        },
        {
          "type": "bring",
          "needed": [
            {
              "id": "getting-started:bring:7futal",
              "html": "Oil-filled <a href=\"https://runescape.wiki/w/Bullseye_lantern_(oil)\" target=\"_blank\" rel=\"noopener\">bullseye lantern</a>",
              "text": "Oil-filled bullseye lantern"
            },
            {
              "id": "getting-started:bring:1x80dsn",
              "html": "Cut <a href=\"https://runescape.wiki/w/Sapphire\" target=\"_blank\" rel=\"noopener\">sapphire</a>",
              "text": "Cut sapphire"
            },
            {
              "id": "getting-started:bring:1662z7z",
              "html": "<a href=\"https://runescape.wiki/w/Rope\" target=\"_blank\" rel=\"noopener\">Rope</a> (if this is your first visit to Lumbridge Swamp Caves)",
              "text": "Rope (if this is your first visit to Lumbridge Swamp Caves)"
            }
          ],
          "recommended": [
            {
              "id": "getting-started:bring:19cmxre",
              "html": "<a href=\"https://runescape.wiki/w/Spiny_helmet\" target=\"_blank\" rel=\"noopener\">Spiny helmet</a>/<a href=\"https://runescape.wiki/w/Slayer_helmet\" target=\"_blank\" rel=\"noopener\">slayer helmet</a> or food",
              "text": "Spiny helmet/slayer helmet or food"
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:v447wa",
          "html": "<i>Use</i> a cut <a href=\"https://runescape.wiki/w/Sapphire\" target=\"_blank\" rel=\"noopener\">sapphire</a> on an oil filled <a href=\"https://runescape.wiki/w/Bullseye_lantern_(oil)\" target=\"_blank\" rel=\"noopener\">bullseye lantern</a>.",
          "text": "Use a cut sapphire on an oil filled bullseye lantern.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1qmsr98",
          "html": "<i>Light</i> the <a href=\"https://runescape.wiki/w/Sapphire_lantern\" target=\"_blank\" rel=\"noopener\">sapphire lantern</a>.",
          "text": "Light the sapphire lantern.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:wa3evk",
          "html": "Travel to the <a href=\"https://runescape.wiki/w/Dark_hole_under_tree\" target=\"_blank\" rel=\"noopener\">dark hole under tree</a> slightly north west of the <a href=\"https://runescape.wiki/w/Water_altar\" target=\"_blank\" rel=\"noopener\">water altar</a> in <a href=\"https://runescape.wiki/w/Lumbridge_Swamp\" target=\"_blank\" rel=\"noopener\">Lumbridge Swamp</a>.",
          "text": "Travel to the dark hole under tree slightly north west of the water altar in Lumbridge Swamp.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:62wsap",
          "html": "<i>Climb down</i> the hole to access <a href=\"https://runescape.wiki/w/Lumbridge_Swamp_Caves\" target=\"_blank\" rel=\"noopener\">Lumbridge Swamp Caves</a>.",
          "text": "Climb down the hole to access Lumbridge Swamp Caves.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:62wsap:1vvco5o",
              "html": "If this is your first visit, <i>Use</i> the rope on the tree.",
              "text": "If this is your first visit, Use the rope on the tree.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "getting-started:62wsap:urufnx",
              "html": "<b>Recommended</b>: Equip a spiny helmet/slayer helmet to negate damage from <a href=\"https://runescape.wiki/w/Wall_beast\" target=\"_blank\" rel=\"noopener\">wall beasts</a>, or use a movement ability like <a href=\"https://runescape.wiki/w/Surge\" target=\"_blank\" rel=\"noopener\">Surge</a> or <a href=\"https://runescape.wiki/w/Dive\" target=\"_blank\" rel=\"noopener\">Dive</a> to prevent the wall beasts from attacking.",
              "text": "Recommended: Equip a spiny helmet/slayer helmet to negate damage from wall beasts, or use a movement ability like Surge or Dive to prevent the wall beasts from attacking.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:beuxgu",
          "html": "Run to the south east end of the cavern.",
          "text": "Run to the south east end of the cavern.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:4ck8zs",
          "html": "<i>Jump-across</i> the stepping stone to the south (see shortcut icon on the map shown)",
          "text": "Jump-across the stepping stone to the south (see shortcut icon on the map shown)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1s2nzqy",
          "html": "<i>Enter</i> the tunnel.",
          "text": "Enter the tunnel.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
