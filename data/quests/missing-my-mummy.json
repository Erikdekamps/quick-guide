        {
          "type": "step",
          "id": "pharaoh-s-pyramid:615v6f",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Leela\" target=\"_blank\" rel=\"noopener\">Leela</a>, north of the <a href=\"https://runescape.wiki/w/Draynor_Village\" target=\"_blank\" rel=\"noopener\">Draynor Village</a> jail.",
          "text": "Talk to Leela, north of the Draynor Village jail.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "pharaoh-s-pyramid:615v6f:xaq34g",
              "html": "If Leela does not show up in Draynor Village, you need to complete the <a href=\"https://runescape.wiki/w/Stolen_Hearts\" target=\"_blank\" rel=\"noopener\">Stolen Hearts</a> and <a href=\"https://runescape.wiki/w/Diamond_in_the_Rough\" target=\"_blank\" rel=\"noopener\">Diamond in the Rough</a> quests first, even if <a href=\"https://runescape.wiki/w/Icthlarin%27s_Little_Helper\" target=\"_blank\" rel=\"noopener\">Icthlarin&#39;s Little Helper</a> is already completed.",
              "text": "If Leela does not show up in Draynor Village, you need to complete the Stolen Hearts and Diamond in the Rough quests first, even if Icthlarin's Little Helper is already completed.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "pharaoh-s-pyramid:1wgh12u",
          "html": "Enter the flat-topped pyramid <a href=\"https://runescape.wiki/w/Uzer_Mastaba\" target=\"_blank\" rel=\"noopener\">Uzer Mastaba</a> from the west side, south of <a href=\"https://runescape.wiki/w/Uzer\" target=\"_blank\" rel=\"noopener\">Uzer</a>.",
          "text": "Enter the flat-topped pyramid Uzer Mastaba from the west side, south of Uzer.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "pharaoh-s-pyramid:1wgh12u:1kfrgfe",
              "html": "Teleport to the fairy ring <b>D</b><b>L</b><b>Q</b> and then run east.",
              "text": "Teleport to the fairy ring DLQ and then run east.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "pharaoh-s-pyramid:1wgh12u:160lbsy",
              "html": "Teleport to <a href=\"https://runescape.wiki/w/Al_Kharid\" target=\"_blank\" rel=\"noopener\">Al Kharid</a> and go south to <a href=\"https://runescape.wiki/w/Shantay%27s_Pass\" target=\"_blank\" rel=\"noopener\">Shantay&#39;s Pass</a> (Or use <a href=\"https://runescape.wiki/w/Amulet_of_glory\" target=\"_blank\" rel=\"noopener\">amulet of glory</a>&#39;s teleport to Al Kharid).",
              "text": "Teleport to Al Kharid and go south to Shantay's Pass (Or use amulet of glory's teleport to Al Kharid).",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "pharaoh-s-pyramid:1wgh12u:y791gp",
              "html": "Use the <a href=\"https://runescape.wiki/w/Magic_carpet\" target=\"_blank\" rel=\"noopener\">magic carpet</a> network to get to <a href=\"https://runescape.wiki/w/Uzer\" target=\"_blank\" rel=\"noopener\">Uzer</a>.",
              "text": "Use the magic carpet network to get to Uzer.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "pharaoh-s-pyramid:1wgh12u:1bczifg",
              "html": "Teleport with the <a href=\"https://runescape.wiki/w/Traveller%27s_necklace\" target=\"_blank\" rel=\"noopener\">traveller&#39;s necklace</a> to desert <a href=\"https://runescape.wiki/w/Eagles%27_eyrie\" target=\"_blank\" rel=\"noopener\">eagles&#39; eyrie</a>.",
              "text": "Teleport with the traveller's necklace to desert eagles' eyrie.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "pharaoh-s-pyramid:8r2p21",
          "html": "In the initial east chamber, rummage and kill the skeleton for a <a href=\"https://runescape.wiki/w/Canopic_jar_(Missing_My_Mummy)\" target=\"_blank\" rel=\"noopener\">canopic jar</a>.",
          "text": "In the initial east chamber, rummage and kill the skeleton for a canopic jar.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "pharaoh-s-pyramid:1riokr",
          "html": "Head north-west and through the imposing doors to the south.",
          "text": "Head north-west and through the imposing doors to the south.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "pharaoh-s-pyramid:1k7bd5m",
          "html": "Kill the four skeletons in the room for a <a href=\"https://runescape.wiki/w/Mummy_hand\" target=\"_blank\" rel=\"noopener\">mummy hand</a> and the <a href=\"https://runescape.wiki/w/Scroll_of_the_dead\" target=\"_blank\" rel=\"noopener\">scroll of the dead</a>. The mummy hand and scroll of the dead don&#39;t appear in area loot, you need to right click to take them.",
          "text": "Kill the four skeletons in the room for a mummy hand and the scroll of the dead. The mummy hand and scroll of the dead don't appear in area loot, you need to right click to take them.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "pharaoh-s-pyramid:1d2imsr",
          "html": "Return to Leela in Draynor Village.",
          "text": "Return to Leela in Draynor Village.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "5",
                  "text": "I think I can deal with this myself."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
