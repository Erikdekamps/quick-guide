    {
      "id": "raising-his-spirit",
      "title": "Raising his spirit",
      "anchor": "Raising_his_spirit",
      "blocks": [
        {
          "type": "step",
          "id": "raising-his-spirit:9nf4ii",
          "html": "Talk to repeatedly to raise his spirits:",
          "text": "Talk to repeatedly to raise his spirits:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "raising-his-spirit:9nf4ii:p3rmzr",
              "html": "Of the four chat options, choose the one that appears on the table below.",
              "text": "Of the four chat options, choose the one that appears on the table below.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "raising-his-spirit:9nf4ii:1cns7q9",
              "html": "Select the response according to the table.",
              "text": "Select the response according to the table.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "raising-his-spirit:9nf4ii:5p81uq",
              "html": "Repeat until a short cutscene plays and he sits up.",
              "text": "Repeat until a short cutscene plays and he sits up.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "table",
          "label": "Answer #1 · Answer #2",
          "head": [
            "Answer #1",
            "Answer #2"
          ],
          "rows": [
            [
              "You seem like a nice guy.",
              "Just being honest."
            ],
            [
              "When we get out of here I&#39;ll buy you a drink!",
              "Whatever and wherever you want - my treat."
            ],
            [
              "I&#39;m very impressed you managed to get into this cave.",
              "I would have given up personally."
            ],
            [
              "You&#39;ll survive this easily.",
              "Think of all the places you can visit when you get out!"
            ],
            [
              "What are you going to do when you get out of here?",
              "That&#39;s up to you. You could travel with me!"
            ],
            [
              "It&#39;s a good thing you have me to look after you.",
              "Not that I&#39;m bragging or anything."
            ],
            [
              "Not long now and you&#39;ll be back on your feet!",
              "On whether you mind me helping you further."
            ],
            [
              "You&#39;re sounding much better.",
              "If you need anything, just let me know."
            ],
            [
              "It&#39;s quite cosy in here.",
              "The perfect environment for getting back on your feet!"
            ],
            [
              "You&#39;re very safe in this little cave.",
              "The suqah will never fit through that tunnel."
            ],
            [
              "Just don&#39;t worry.",
              "Of course."
            ],
            [
              "You&#39;re looking better now.",
              "Well, you look and sound more lively."
            ],
            [
              "Are you looking forward to getting out?",
              "That&#39;s the spirit!"
            ],
            [
              "Tell me a bit about yourself.",
              "Fishing!"
            ]
          ]
        },
        {
          "type": "step",
          "id": "raising-his-spirit:15q1lyo",
          "html": "Feed him <b>6</b> more food.",
          "text": "Feed him 6 more food.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "raising-his-spirit:1sz6foy",
          "html": "Talk to him and raise his spirit as before until he stands up.",
          "text": "Talk to him and raise his spirit as before until he stands up.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "raising-his-spirit:1f0vme9",
          "html": "Exit the cave and climb up the ladder.",
          "text": "Exit the cave and climb up the ladder.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "raising-his-spirit:1f0vme9:183x6we",
