        {
          "type": "step",
          "id": "getting-to-elena:v1pm77",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Bravek\" target=\"_blank\" rel=\"noopener\">Bravek</a>.",
          "text": "Talk to Bravek.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "This is really important though!"
                },
                {
                  "key": "3",
                  "text": "Do you know what's in the cure?"
