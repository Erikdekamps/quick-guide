        {
          "type": "step",
          "id": "getting-started:dzyhuw",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Edmond\" target=\"_blank\" rel=\"noopener\">Edmond</a> who is located at a house north of the <a href=\"https://runescape.wiki/w/Ardougne_Castle\" target=\"_blank\" rel=\"noopener\">Ardougne Castle</a> and <a href=\"https://runescape.wiki/w/Flying_Horse_Inn\" target=\"_blank\" rel=\"noopener\">Flying Horse Inn</a> in <a href=\"https://runescape.wiki/w/East_Ardougne\" target=\"_blank\" rel=\"noopener\">East Ardougne</a>.",
          "text": "Talk to Edmond who is located at a house north of the Ardougne Castle and Flying Horse Inn in East Ardougne.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What's happened to her?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1vx4l9d",
          "html": "Talk to his wife <a href=\"https://runescape.wiki/w/Alrena\" target=\"_blank\" rel=\"noopener\">Alrena</a> directly east in the house and give her the <a href=\"https://runescape.wiki/w/Dwellberries\" target=\"_blank\" rel=\"noopener\">dwellberries</a>.",
          "text": "Talk to his wife Alrena directly east in the house and give her the dwellberries.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:64bkkd",
          "html": "Pick up the <a href=\"https://runescape.wiki/w/Picture\" target=\"_blank\" rel=\"noopener\">picture</a> of <a href=\"https://runescape.wiki/w/Elena\" target=\"_blank\" rel=\"noopener\">Elena</a> from the table in the eastern room of their house.",
          "text": "Pick up the picture of Elena from the table in the eastern room of their house.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
