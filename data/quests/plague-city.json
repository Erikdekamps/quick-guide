    {
      "id": "breaking-in",
      "title": "Breaking in",
      "anchor": "Breaking_in",
      "blocks": [
        {
          "type": "step",
          "id": "breaking-in:1gqxbkj",
          "html": "Talk to Edmond.",
          "text": "Talk to Edmond.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "breaking-in:qsv1un",
          "html": "Equip the <a href=\"https://runescape.wiki/w/Gas_mask\" target=\"_blank\" rel=\"noopener\">gas mask</a>.",
          "text": "Equip the gas mask.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "breaking-in:b0rv1l",
          "html": "In his garden, use all 4 <a href=\"https://runescape.wiki/w/Buckets_of_water\" target=\"_blank\" rel=\"noopener\">buckets of water</a> on the <a href=\"https://runescape.wiki/w/Mud_patch\" target=\"_blank\" rel=\"noopener\">mud patch</a> in the south part of his garden, between the cabbages and potatoes.",
          "text": "In his garden, use all 4 buckets of water on the mud patch in the south part of his garden, between the cabbages and potatoes.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "breaking-in:b3e17b",
          "html": "Bring all of the required items with you before you enter the mud patch. Once inside the city, there is no bank nearby. If you leave the city, you will need to re-enter the mud patch and climb through the pipe to return.",
          "text": "Bring all of the required items with you before you enter the mud patch. Once inside the city, there is no bank nearby. If you leave the city, you will need to re-enter the mud patch and climb through the pipe to return.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "breaking-in:1xcbx4i",
          "html": "<i>Dig</i> the mud patch.",
          "text": "Dig the mud patch.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "breaking-in:1u98yq6",
          "html": "Go south and try to open the grill on the pipe.",
          "text": "Go south and try to open the grill on the pipe.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "breaking-in:dx9fqw",
          "html": "<i>Use</i> a rope on the grill and talk to Edmond.",
          "text": "Use a rope on the grill and talk to Edmond.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "breaking-in:3n9se5",
          "html": "Make sure the gas mask obtained earlier is equipped and climb up the pipe.",
          "text": "Make sure the gas mask obtained earlier is equipped and climb up the pipe.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
