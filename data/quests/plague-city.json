        {
          "type": "step",
          "id": "the-search-for-elena:kqnfap",
          "html": "Use the picture on <a href=\"https://runescape.wiki/w/Jethick\" target=\"_blank\" rel=\"noopener\">Jethick</a>, who is found walking around the town square, and tell him that you will help return the book.",
          "text": "Use the picture on Jethick, who is found walking around the town square, and tell him that you will help return the book.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes, I'll return it for you"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-search-for-elena:kqnfap:vxyu7e",
              "html": "Optional: Talk to the nearby <a href=\"https://runescape.wiki/w/Recruiter\" target=\"_blank\" rel=\"noopener\">Recruiter</a> for one of <a href=\"https://runescape.wiki/w/Easy_Ardougne_achievements\" target=\"_blank\" rel=\"noopener\">easy Ardougne achievements</a>, <a href=\"https://runescape.wiki/w/Red_Revolution\" target=\"_blank\" rel=\"noopener\">Red Revolution</a>.",
              "text": "Optional: Talk to the nearby Recruiter for one of easy Ardougne achievements, Red Revolution.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "the-search-for-elena:122jf0m",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Martha_Rehnison\" target=\"_blank\" rel=\"noopener\">Martha Rehnison</a> <b>and</b> <a href=\"https://runescape.wiki/w/Ted_Rehnison\" target=\"_blank\" rel=\"noopener\">Ted Rehnison</a> (speak to both) in their house, north of the town hall building, bordered by the northern wall.",
          "text": "Talk to Martha Rehnison and Ted Rehnison (speak to both) in their house, north of the town hall building, bordered by the northern wall.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-search-for-elena:1vzrdxm",
          "html": "Go up the ladder and talk to <a href=\"https://runescape.wiki/w/Milli_Rehnison\" target=\"_blank\" rel=\"noopener\">Milli Rehnison</a>.",
          "text": "Go up the ladder and talk to Milli Rehnison.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-search-for-elena:1sw3me3",
          "html": "Exit the house and go south of the town square.",
          "text": "Exit the house and go south of the town square.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-search-for-elena:1sw3me3:127nkeo",
              "html": "Optional: Pray at the altar in the church for one of <a href=\"https://runescape.wiki/w/Easy_Ardougne_achievements\" target=\"_blank\" rel=\"noopener\">easy Ardougne achievements</a>, <a href=\"https://runescape.wiki/w/Preaching_to_the_Infected\" target=\"_blank\" rel=\"noopener\">Preaching to the Infected</a>.",
              "text": "Optional: Pray at the altar in the church for one of easy Ardougne achievements, Preaching to the Infected.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "the-search-for-elena:1i5ou16",
          "html": "Go to the central southern house with spooky stairs and attempt to open one of the doors with a big <b>X</b>.",
          "text": "Go to the central southern house with spooky stairs and attempt to open one of the doors with a big X.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "But I think a kidnap victim is in here."
                },
                {
                  "key": "2",
                  "text": "I want to check anyway."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
