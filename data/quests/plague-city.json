        {
          "type": "step",
          "id": "getting-to-elena:10m554a",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Clerk\" target=\"_blank\" rel=\"noopener\">Clerk</a> on the ground floor (UK) / 1<sup>st</sup> floor (US), and tell him it&#39;s urgent.",
          "text": "Talk to the Clerk on the ground floor (UK) / 1st floor (US), and tell him it's urgent.",
          "dialogue": [
