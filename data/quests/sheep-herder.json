        {
          "type": "step",
          "id": "herding-the-sheep:4jpro3",
          "html": "Return to the lodestone and go west until you reach the fenced enclosure with a stone building and incinerator (looks like a furnace). It is south of the fishing guild.",
          "text": "Return to the lodestone and go west until you reach the fenced enclosure with a stone building and incinerator (looks like a furnace). It is south of the fishing guild.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "herding-the-sheep:16ue57l",
          "html": "Equip the <a href=\"https://runescape.wiki/w/Plague_jacket\" target=\"_blank\" rel=\"noopener\">plague jacket</a> and <a href=\"https://runescape.wiki/w/Plague_trousers\" target=\"_blank\" rel=\"noopener\">trousers</a> and enter the gate.",
          "text": "Equip the plague jacket and trousers and enter the gate.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "herding-the-sheep:1qohkof",
          "html": "Pick up the <a href=\"https://runescape.wiki/w/Cattleprod\" target=\"_blank\" rel=\"noopener\">cattleprod</a> inside the stone enclosure, equip it.",
          "text": "Pick up the cattleprod inside the stone enclosure, equip it.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "herding-the-sheep:eftm8u",
          "html": "Prod 1 of each colour sheep in and through the incinerator pen&#39;s gate. If the sheep are stuck, simply switch worlds.",
          "text": "Prod 1 of each colour sheep in and through the incinerator pen's gate. If the sheep are stuck, simply switch worlds.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "text",
          "html": "Sheep<br>Location<br>Blue sheep<br>North-west of the incinerator, just past the <a href=\"https://runescape.wiki/w/Warrior_Woman\" target=\"_blank\" rel=\"noopener\">Warrior Woman</a> camp.<br>Yellow sheep<br>North of the incinerator, in front of the Fishing Guild.<br>Green sheep<br>East of the incinerator, near a Mysterious Statue.<br>Red sheep<br>South of the incinerator, in front of Ardougne North bank."
        }
      ]
