  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:w85mqw",
          "html": "Enter the well in <a href=\"https://runescape.wiki/w/Pollnivneach\" target=\"_blank\" rel=\"noopener\">Pollnivneach</a>.",
          "text": "Enter the well in Pollnivneach.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:zmahpp",
          "html": "In the room with <a href=\"https://runescape.wiki/w/Mighty_banshee\" target=\"_blank\" rel=\"noopener\">mighty banshees</a>, pass the mystic barrier to the southwest and climb down the stairs. The quest is just about killing 4 bosses in their specific locations. Below is a recommended order.",
          "text": "In the room with mighty banshees, pass the mystic barrier to the southwest and climb down the stairs. The quest is just about killing 4 bosses in their specific locations. Below is a recommended order.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:sffmsc",
          "html": "<a href=\"https://runescape.wiki/w/Mightiest_turoth\" target=\"_blank\" rel=\"noopener\">Mightiest turoth</a> (SW - bottom left barrier)",
          "text": "Mightiest turoth (SW - bottom left barrier)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:sffmsc:vn904a",
              "html": "Use <a href=\"https://runescape.wiki/w/Slayer_Dart\" target=\"_blank\" rel=\"noopener\">Slayer Dart</a> and Protect from Melee prayer. If you stand far away from the <a href=\"https://runescape.wiki/w/Mightiest_turoth\" target=\"_blank\" rel=\"noopener\">Mightiest turoth</a>, it will use Ranged-based attacks on you. Ignore the minions.",
              "text": "Use Slayer Dart and Protect from Melee prayer. If you stand far away from the Mightiest turoth, it will use Ranged-based attacks on you. Ignore the minions.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "getting-started:sffmsc:1dyvjxn",
              "html": "If you choose to use melee, do not forget to bring a leaf-bladed spear or sword.",
              "text": "If you choose to use melee, do not forget to bring a leaf-bladed spear or sword.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:svhln9",
          "html": "<a href=\"https://runescape.wiki/w/Kurask_overlord\" target=\"_blank\" rel=\"noopener\">Kurask overlord</a> (NW - top left barrier)",
          "text": "Kurask overlord (NW - top left barrier)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:svhln9:v3hnha",
              "html": "Use same strategies as above.",
              "text": "Use same strategies as above.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:vteftk",
          "html": "<a href=\"https://runescape.wiki/w/Basilisk_boss\" target=\"_blank\" rel=\"noopener\">Basilisk boss</a> (SE - bottom right barrier)",
          "text": "Basilisk boss (SE - bottom right barrier)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:vteftk:130xngl",
              "html": "Use melee and wield the mirror shield.",
              "text": "Use melee and wield the mirror shield.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "getting-started:vteftk:191x7rs",
              "html": "Use Protect from Magic prayer. Also watch your stats as they will be drained with each attack. Bring a restore potion.",
              "text": "Use Protect from Magic prayer. Also watch your stats as they will be drained with each attack. Bring a restore potion.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "getting-started:vteftk:1dpy1io",
              "html": "Take a dose of Super strength potion and Super attack potion, a Combat potion, or Super warmaster&#39;s potion to help.",
              "text": "Take a dose of Super strength potion and Super attack potion, a Combat potion, or Super warmaster's potion to help.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:1r5unb9",
          "html": "<a href=\"https://runescape.wiki/w/Monstrous_cave_crawler\" target=\"_blank\" rel=\"noopener\">Monstrous cave crawler</a> (NE - top right barrier)",
          "text": "Monstrous cave crawler (NE - top right barrier)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:1r5unb9:l83hj6",
              "html": "Use melee and Protect from Ranged prayer. The poison from its ranged attack severely reduces the duration of any antipoison potions, including super antipoison. Every second or third hit poisons the player even with potions. An anti-poison totem will not work.",
              "text": "Use melee and Protect from Ranged prayer. The poison from its ranged attack severely reduces the duration of any antipoison potions, including super antipoison. Every second or third hit poisons the player even with potions. An anti-poison totem will not work.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "text",
          "html": "Miniquest Complete!"
        }
      ]
    }
