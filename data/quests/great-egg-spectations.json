  "items": {
    "required": {
      "note": "Items from the <a href=\"https://runescape.wiki/w/Tool_belt\" target=\"_blank\" rel=\"noopener\">tool belt</a> are not listed unless they do not work or are not automatically added.",
      "items": [
        {
          "id": "req:pyvkak",
          "html": "<a href=\"https://runescape.wiki/w/Sliced_banana\" target=\"_blank\" rel=\"noopener\">Sliced banana</a> (obtained by picking a <a href=\"https://runescape.wiki/w/Banana_Tree\" target=\"_blank\" rel=\"noopener\">Banana Tree</a> in <a href=\"https://runescape.wiki/w/Musa_Point\" target=\"_blank\" rel=\"noopener\">Musa Point</a> during the quest)",
          "text": "Sliced banana (obtained by picking a Banana Tree in Musa Point during the quest)",
          "alternatives": []
        },
        {
          "id": "req:12j2tu3",
          "html": "<a href=\"https://runescape.wiki/w/Nuts\" target=\"_blank\" rel=\"noopener\">Nuts</a> (can be purchased from the <a href=\"https://runescape.wiki/w/Pet_Shop_(Taverley)\" target=\"_blank\" rel=\"noopener\">Pet Shops in Taverley</a> or <a href=\"https://runescape.wiki/w/Pet_Shop_(Yanille)\" target=\"_blank\" rel=\"noopener\">Yanille</a>)",
          "text": "Nuts (can be purchased from the Pet Shops in Taverley or Yanille)",
          "alternatives": []
        },
        {
          "id": "req:1x636pt",
          "html": "<a href=\"https://runescape.wiki/w/Grapes\" target=\"_blank\" rel=\"noopener\">Grapes</a> (can be purchased from the <a href=\"https://runescape.wiki/w/Culinaromancer%27s_Chest\" target=\"_blank\" rel=\"noopener\">Culinaromancer&#39;s Chest</a>)",
          "text": "Grapes (can be purchased from the Culinaromancer's Chest)",
          "alternatives": []
        },
        {
          "id": "req:lqu3cm",
          "html": "<a href=\"https://runescape.wiki/w/Biscuits\" target=\"_blank\" rel=\"noopener\">Biscuits</a> (can be made at level 32 Cooking with a <a href=\"https://runescape.wiki/w/Pot_of_flour\" target=\"_blank\" rel=\"noopener\">pot of flour</a> and <a href=\"https://runescape.wiki/w/Pat_of_butter\" target=\"_blank\" rel=\"noopener\">pat of butter</a> after <a href=\"https://runescape.wiki/w/Chef%27s_Assistant\" target=\"_blank\" rel=\"noopener\">Chef&#39;s Assistant</a>, butter can be made at level 38 Cooking or purchased from the <a href=\"https://runescape.wiki/w/Culinaromancer%27s_Chest\" target=\"_blank\" rel=\"noopener\">Culinaromancer&#39;s Chest</a> or <a href=\"https://runescape.wiki/w/The_Village_Grocery\" target=\"_blank\" rel=\"noopener\">The Village Grocery</a>)",
          "text": "Biscuits (can be made at level 32 Cooking with a pot of flour and pat of butter after Chef's Assistant, butter can be made at level 38 Cooking or purchased from the Culinaromancer's Chest or The Village Grocery)",
          "alternatives": []
        }
      ]
    },
    "recommended": {
      "note": "",
      "items": [
        {
          "id": "rec:28xfx3",
          "html": "<a href=\"https://runescape.wiki/w/Amulet_of_glory\" target=\"_blank\" rel=\"noopener\">Amulet of glory</a> for quick teleport to <a href=\"https://runescape.wiki/w/Musa_Point\" target=\"_blank\" rel=\"noopener\">Musa Point</a>",
          "text": "Amulet of glory for quick teleport to Musa Point",
          "alternatives": []
        },
        {
          "id": "rec:al2z4u",
          "html": "Runes to cast the <a href=\"https://runescape.wiki/w/Teleport_falador\" target=\"_blank\" rel=\"noopener\">Teleport falador</a> spell or access to the <a href=\"https://runescape.wiki/w/Falador_lodestone\" target=\"_blank\" rel=\"noopener\">Falador lodestone</a>",
          "text": "Runes to cast the Teleport falador spell or access to the Falador lodestone",
          "alternatives": []
        },
        {
          "id": "rec:183qc62",
          "html": "<a href=\"https://runescape.wiki/w/Mystical_sand_seed\" target=\"_blank\" rel=\"noopener\">Mystical sand seed</a> or <a href=\"https://runescape.wiki/w/Sand_seed\" target=\"_blank\" rel=\"noopener\">sand seed</a> for quick teleport to the <a href=\"https://runescape.wiki/w/Garden_of_Kharid\" target=\"_blank\" rel=\"noopener\">Garden of Kharid</a>",
          "text": "Mystical sand seed or sand seed for quick teleport to the Garden of Kharid",
