        {
          "type": "step",
          "id": "glough:gvtcjk",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Captain_Errdo\" target=\"_blank\" rel=\"noopener\">Captain Errdo</a> just north of the cells to get to <a href=\"https://runescape.wiki/w/Karamja\" target=\"_blank\" rel=\"noopener\">Karamja</a>.",
          "text": "Talk to the Captain Errdo just north of the cells to get to Karamja.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Take me to Karamja, please."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "glough:gvtcjk:y6h5p5",
              "html": "<b>Beware if you are low level, there are multiple level 57 <a href=\"https://runescape.wiki/w/Jogre\" target=\"_blank\" rel=\"noopener\">Jogres</a> here so be ready.</b>",
              "text": "Beware if you are low level, there are multiple level 57 Jogres here so be ready.",
