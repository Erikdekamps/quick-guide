              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "glough:1c5k57g",
          "html": "Run east and attempt to open the gate.",
          "text": "Run east and attempt to open the gate.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "glough:1kz65ys",
          "html": "Tell him you work for Glough, Ka-Lu-Min is the password.",
          "text": "Tell him you work for Glough, Ka-Lu-Min is the password.",
          "dialogue": [
            {
              "when": null,
              "options": [
