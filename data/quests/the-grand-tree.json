        {
          "type": "step",
          "id": "glough:6r48hk",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Femi\" target=\"_blank\" rel=\"noopener\">Femi</a> at the <a href=\"https://runescape.wiki/w/Gnome_Stronghold\" target=\"_blank\" rel=\"noopener\">Gnome Stronghold</a> gates to enter inside.",
          "text": "Talk to Femi at the Gnome Stronghold gates to enter inside.",
