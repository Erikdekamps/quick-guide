        {
          "type": "step",
          "id": "the-crisis:1204qjl",
          "html": "Take the bark sample and book to <a href=\"https://runescape.wiki/w/Hazelmere\" target=\"_blank\" rel=\"noopener\">Hazelmere</a>; he lives east of <a href=\"https://runescape.wiki/w/Yanille\" target=\"_blank\" rel=\"noopener\">Yanille</a> (pictured).",
          "text": "Take the bark sample and book to Hazelmere; he lives east of Yanille (pictured).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-crisis:1204qjl:1cv6rzy",
              "html": "If you have <a href=\"https://runescape.wiki/w/A_Fairy_Tale_II_-_Cure_a_Queen\" target=\"_blank\" rel=\"noopener\">A Fairy Tale II - Cure a Queen</a> completed, you can use code <b>C</b><b>L</b><b>S</b>, otherwise teleport to the Yanille lodestone.",
              "text": "If you have A Fairy Tale II - Cure a Queen completed, you can use code CLS, otherwise teleport to the Yanille lodestone.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "the-crisis:zy2f2d",
          "html": "Up the ladder, talk to Hazelmere.",
          "text": "Up the ladder, talk to Hazelmere.",
