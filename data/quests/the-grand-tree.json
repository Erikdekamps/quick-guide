          "text": "Once inside, run east to the south dock.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "glough:15a4l1v",
          "html": "Either kill the foreman, or talk to him and answer his questions.",
          "text": "Either kill the foreman, or talk to him and answer his questions.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Sadly his wife is no longer with us!"
                },
                {
                  "key": "2",
                  "text": "He loves worm holes."
                },
