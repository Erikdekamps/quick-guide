    "recommended": {
      "note": "",
      "items": [
        {
          "id": "rec:1wyrn1r",
          "html": "25 <a href=\"https://runescape.wiki/w/Agility\" target=\"_blank\" rel=\"noopener\">Agility</a>",
          "text": "25 Agility",
          "alternatives": []
        },
        {
          "id": "rec:jhxsl6",
          "html": "Teleportation runes to <a href=\"https://runescape.wiki/w/Ardougne\" target=\"_blank\" rel=\"noopener\">Ardougne</a> and <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>, <a href=\"https://runescape.wiki/w/Ardougne_cloak_1\" target=\"_blank\" rel=\"noopener\">Ardougne cloak 1</a> or better (requires <a href=\"https://runescape.wiki/w/Easy_Ardougne_achievements\" target=\"_blank\" rel=\"noopener\">easy Ardougne achievements</a>), alternatively activated <a href=\"https://runescape.wiki/w/Ardougne_lodestone\" target=\"_blank\" rel=\"noopener\">Ardougne</a> and <a href=\"https://runescape.wiki/w/Varrock_lodestone\" target=\"_blank\" rel=\"noopener\">Varrock lodestone</a>.",
          "text": "Teleportation runes to Ardougne and Varrock, Ardougne cloak 1 or better (requires easy Ardougne achievements), alternatively activated Ardougne and Varrock lodestone.",
          "alternatives": []
        },
        {
          "id": "rec:1hpbcgw",
          "html": "<a href=\"https://runescape.wiki/w/Memory_strand\" target=\"_blank\" rel=\"noopener\">Memory strands</a> in the <a href=\"https://runescape.wiki/w/Currency_pouch\" target=\"_blank\" rel=\"noopener\">currency pouch</a> to teleport just north campsite.",
          "text": "Memory strands in the currency pouch to teleport just north campsite.",
          "alternatives": []
        },
        {
          "id": "rec:jzbhss",
          "html": "Ability to use <a href=\"https://runescape.wiki/w/Spirit_Tree\" target=\"_blank\" rel=\"noopener\">Spirit Tree</a>.",
          "text": "Ability to use Spirit Tree.",
          "alternatives": []
        },
        {
          "id": "rec:xfgd1d",
          "html": "<a href=\"https://runescape.wiki/w/Dramen_staff\" target=\"_blank\" rel=\"noopener\">Dramen staff</a> or <a href=\"https://runescape.wiki/w/Lunar_staff\" target=\"_blank\" rel=\"noopener\">Lunar staff</a> with the ability to use fairy rings (Not required if <a href=\"https://runescape.wiki/w/A_Fairy_Tale_III_-_Battle_at_Ork%27s_Rift\" target=\"_blank\" rel=\"noopener\">A Fairy Tale III - Battle at Ork&#39;s Rift</a> has been completed).",
          "text": "Dramen staff or Lunar staff with the ability to use fairy rings (Not required if A Fairy Tale III - Battle at Ork's Rift has been completed).",
          "alternatives": []
        },
        {
          "id": "rec:1nil6rb",
          "html": "<a href=\"https://runescape.wiki/w/Energy_potion\" target=\"_blank\" rel=\"noopener\">Energy potions</a> or <a href=\"https://runescape.wiki/w/Explorer%27s_ring\" target=\"_blank\" rel=\"noopener\">Explorer&#39;s ring</a> or <a href=\"https://runescape.wiki/w/Spirit_terrorbird\" target=\"_blank\" rel=\"noopener\">Spirit terrorbird</a> with <a href=\"https://runescape.wiki/w/Spirit_Terrorbird_scroll_(Tireless_Run)\" target=\"_blank\" rel=\"noopener\">Tireless Run scrolls</a>. (highly recommended)",
          "text": "Energy potions or Explorer's ring or Spirit terrorbird with Tireless Run scrolls. (highly recommended)",
          "alternatives": []
        },
        {
          "id": "rec:1s3yxjl",
          "html": "<a href=\"https://runescape.wiki/w/The_Book_of_Char\" target=\"_blank\" rel=\"noopener\">The Book of Char</a> can be useful as you can teleport right outside the mountain where the quest plays out once a day (requires <a href=\"https://runescape.wiki/w/The_Firemaker%27s_Curse\" target=\"_blank\" rel=\"noopener\">The Firemaker&#39;s Curse</a>).",
          "text": "The Book of Char can be useful as you can teleport right outside the mountain where the quest plays out once a day (requires The Firemaker's Curse).",
          "alternatives": []
        },
        {
          "id": "rec:18q734o",
          "html": "Access to <a href=\"https://runescape.wiki/w/Eagles%27_Peak_lodestone\" target=\"_blank\" rel=\"noopener\">Eagles&#39; Peak lodestone</a>.",
          "text": "Access to Eagles' Peak lodestone.",
          "alternatives": []
        }
      ]
    }
  },
  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:1ol30ls",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Charlie\" target=\"_blank\" rel=\"noopener\">Charlie</a> in <a href=\"https://runescape.wiki/w/Ardougne_Zoo\" target=\"_blank\" rel=\"noopener\">Ardougne Zoo</a>. (Make sure you finish the dialog, or you will not be able to inspect the books in the next step).",
          "text": "Talk to Charlie in Ardougne Zoo. (Make sure you finish the dialog, or you will not be able to inspect the books in the next step).",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Ah, you sound like someone who needs a quest doing!"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
