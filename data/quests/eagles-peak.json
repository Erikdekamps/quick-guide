              "text": "1 Yellow dye"
            }
          ],
          "recommended": []
        },
        {
          "type": "step",
          "id": "the-disguise:1hy2ny6",
          "html": "Head to the south-east corner of <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a> to the <a href=\"https://runescape.wiki/w/Fancy_Clothes_Store\" target=\"_blank\" rel=\"noopener\">Fancy Clothes Store</a>.",
          "text": "Head to the south-east corner of Varrock to the Fancy Clothes Store.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-disguise:i91uk3",
          "html": "Talk to the Fancy-Dress shop owner.",
          "text": "Talk to the Fancy-Dress shop owner.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Well, specifically I'm after a couple of bird costumes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-disguise:vh7va6",
          "html": "Have the owner make you two <a href=\"https://runescape.wiki/w/Eagle_cape\" target=\"_blank\" rel=\"noopener\">eagle capes</a> and two <a href=\"https://runescape.wiki/w/Fake_beak\" target=\"_blank\" rel=\"noopener\">fake beaks</a>.",
          "text": "Have the owner make you two eagle capes and two fake beaks.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I've got the feathers and the materials you requested."
                },
                {
                  "key": "1",
                  "text": "Okay, here are the materials. Eagle me up."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-disguise:ivt3x6",
          "html": "Equip your disguise (eagle cape and fake beak) and go back to the <a href=\"https://runescape.wiki/w/Eagle%27s_Peak_cave\" target=\"_blank\" rel=\"noopener\">Eagle&#39;s Peak cave</a>.",
          "text": "Equip your disguise (eagle cape and fake beak) and go back to the Eagle's Peak cave.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
