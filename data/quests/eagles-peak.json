          "href": "https://runescape.wiki/w/Eagles'_Peak/Quick_guide"
        },
        {
          "type": "step",
          "id": "eagles-peak:1c9x91m",
          "html": "Head to <a href=\"https://runescape.wiki/w/Eagles%27_Peak_(location)\" target=\"_blank\" rel=\"noopener\">Eagles&#39; Peak</a> west of the <a href=\"https://runescape.wiki/w/Tree_Gnome_Stronghold\" target=\"_blank\" rel=\"noopener\">Tree Gnome Stronghold</a>.",
          "text": "Head to Eagles' Peak west of the Tree Gnome Stronghold.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "eagles-peak:1c9x91m:1yvhxzg",
              "html": "If Eagles&#39; Peak lodestone is activated, teleport to it and run northwest.",
              "text": "If Eagles' Peak lodestone is activated, teleport to it and run northwest.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "eagles-peak:1c9x91m:2j7102",
              "html": "Alternatively, teleport to the Memorial of Guthix using memory strands in the currency pouch and run southeast.",
              "text": "Alternatively, teleport to the Memorial of Guthix using memory strands in the currency pouch and run southeast.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "eagles-peak:746qd0",
          "html": "Go to the northern side of the mountain&#39;s base to a campsite.",
          "text": "Go to the northern side of the mountain's base to a campsite.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "eagles-peak:1fsbk7w",
          "html": "Inspect the books for a <a href=\"https://runescape.wiki/w/Bird_book\" target=\"_blank\" rel=\"noopener\">Bird book</a>.",
          "text": "Inspect the books for a Bird book.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "eagles-peak:oah1g4",
          "html": "Read the book to obtain a <a href=\"https://runescape.wiki/w/Metal_feather\" target=\"_blank\" rel=\"noopener\">Metal feather</a>.",
          "text": "Read the book to obtain a Metal feather.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "eagles-peak:sywegr",
          "html": "Climb the rocks attached to the mountain next to the campsite (25 Agility needed).",
          "text": "Climb the rocks attached to the mountain next to the campsite (25 Agility needed).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "eagles-peak:sywegr:1a4o6s4",
              "html": "Alternatively, if Eagles&#39; Peak lodestone is activated, teleport to it, and run west up the mountain.",
              "text": "Alternatively, if Eagles' Peak lodestone is activated, teleport to it, and run west up the mountain.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "eagles-peak:qszxht",
          "html": "Use the metal feather on the rocky outcrop.",
          "text": "Use the metal feather on the rocky outcrop.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "eagles-peak:rykjrq",
          "html": "Enter the cave, then head south until a cutscene with <a href=\"https://runescape.wiki/w/Nickolaus\" target=\"_blank\" rel=\"noopener\">Nickolaus</a> plays.",
          "text": "Enter the cave, then head south until a cutscene with Nickolaus plays.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "eagles-peak:wi6stj",
          "html": "Shout-to Nickolaus.",
          "text": "Shout-to Nickolaus.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "The Ardougne zookeeper sent me to find you."
                },
                {
                  "key": "2",
                  "text": "So it's not that you're trapped then?"
                },
                {
                  "key": "1",
                  "text": "Could I help at all?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "eagles-peak:1i8rsu5",
          "html": "Pick up 10 eagle feathers in the dungeon (called &quot;giant feathers&quot; on the floor).",
          "text": "Pick up 10 eagle feathers in the dungeon (called \"giant feathers\" on the floor).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "the-disguise",
      "title": "The disguise",
