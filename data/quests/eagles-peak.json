          "type": "bring",
          "needed": [
            {
              "id": "the-disguise:bring:1t7oerw",
              "html": "10 <a href=\"https://runescape.wiki/w/Eagle_feather\" target=\"_blank\" rel=\"noopener\">eagle feathers</a>",
              "text": "10 eagle feathers"
            },
            {
              "id": "the-disguise:bring:5pnamv",
