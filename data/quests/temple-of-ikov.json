        {
          "type": "step",
          "id": "inside-the-temple:1fbv69",
          "html": "Talk to Lucien in or around the bar north of <a href=\"https://runescape.wiki/w/Ardougne_Castle\" target=\"_blank\" rel=\"noopener\">Ardougne Castle</a>. He will give you a <a href=\"https://runescape.wiki/w/Pendant_of_Lucien\" target=\"_blank\" rel=\"noopener\">pendant of Lucien</a>.",
          "text": "Talk to Lucien in or around the bar north of Ardougne Castle. He will give you a pendant of Lucien.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I'm a mighty hero!"
                },
                {
                  "key": "2",
                  "text": "That sounds like a laugh!"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-the-temple:ofjoju",
          "html": "Bank all items not needed for the quest until your weight is less than 4.5 kg.",
          "text": "Bank all items not needed for the quest until your weight is less than 4.5 kg.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-the-temple:h4eokb",
          "html": "With a light source and the <a href=\"https://runescape.wiki/w/Pendant_of_Lucien\" target=\"_blank\" rel=\"noopener\">pendant of Lucien</a>, go to the <a href=\"https://runescape.wiki/w/Temple_of_Ikov_(dungeon)\" target=\"_blank\" rel=\"noopener\">Temple of Ikov</a>, which is located north-east of the <a href=\"https://runescape.wiki/w/Ardougne_lodestone\" target=\"_blank\" rel=\"noopener\">Ardougne lodestone</a>.",
          "text": "With a light source and the pendant of Lucien, go to the Temple of Ikov, which is located north-east of the Ardougne lodestone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-the-temple:gfjjkc",
          "html": "Go down the ladder.",
          "text": "Go down the ladder.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-the-temple:1dmx582",
          "html": "If you don&#39;t have <a href=\"https://runescape.wiki/w/Boots_of_lightness\" target=\"_blank\" rel=\"noopener\">boots of lightness</a>:",
          "text": "If you don't have boots of lightness:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "inside-the-temple:1dmx582:oo3gtp",
              "html": "Inside the temple, run west and down the stairs.",
              "text": "Inside the temple, run west and down the stairs.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "inside-the-temple:1dmx582:wjak21",
              "html": "Cut through the web in the north-east corner and take the boots of lightness.",
              "text": "Cut through the web in the north-east corner and take the boots of lightness.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "inside-the-temple:1dmx582:11dta1p",
              "html": "Go back upstairs",
              "text": "Go back upstairs",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "inside-the-temple:11ozrf1",
          "html": "Equip the boots and the pendant of Lucien. Check that your weight is now 0 kg or less. You may need to un-equip and then re-equip something to make your weight visibly change if it didn&#39;t change when you equipped the boots.",
          "text": "Equip the boots and the pendant of Lucien. Check that your weight is now 0 kg or less. You may need to un-equip and then re-equip something to make your weight visibly change if it didn't change when you equipped the boots.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-the-temple:7nxrdq",
          "html": "Enter the north gate.",
          "text": "Enter the north gate.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-the-temple:hc0rmw",
          "html": "Take the bridge across the lava and pick up the lever located in the southern part of the room, in front of the crates.",
          "text": "Take the bridge across the lava and pick up the lever located in the southern part of the room, in front of the crates.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-the-temple:j191mj",
          "html": "Near where you first entered the dungeon, use the lever on the lever bracket, which is mounted on the wall just west of the ladder returning to the surface. You must complete the dialogue, or the lever will not be placed.",
          "text": "Near where you first entered the dungeon, use the lever on the lever bracket, which is mounted on the wall just west of the ladder returning to the surface. You must complete the dialogue, or the lever will not be placed.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-the-temple:w8v3yp",
          "html": "Pull the lever.",
          "text": "Pull the lever.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
