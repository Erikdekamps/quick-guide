  "sections": [
    {
      "id": "tunnels-under-sophanem",
      "title": "Tunnels under Sophanem",
      "anchor": "Tunnels_under_Sophanem",
      "blocks": [
        {
          "type": "image",
          "src": "https://runescape.wiki/images/thumb/Sophanem_Dungeon_map.png/300px-Sophanem_Dungeon_map.png?ba22a",
          "width": 300,
          "height": 347,
          "alt": "",
          "caption": "",
          "href": ""
        },
        {
          "type": "step",
          "id": "tunnels-under-sophanem:dkspuw",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/High_Priest_of_Sophanem\" target=\"_blank\" rel=\"noopener\">High Priest</a> in Sophanem.",
          "text": "Talk to the High Priest in Sophanem.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            },
            {
              "when": "Then after the cutscene",
              "options": [
                {
                  "key": "5",
                  "text": "Is there any way into Menaphos from below?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "tunnels-under-sophanem:1uvoah6",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Jex\" target=\"_blank\" rel=\"noopener\">Jex</a> in front of the building in the north-east corner of the city.",
          "text": "Talk to Jex in front of the building in the north-east corner of the city.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "tunnels-under-sophanem:wp12gd",
          "html": "Climb down the ladder in the church east of Jex, and down again in the second trapdoor.",
          "text": "Climb down the ladder in the church east of Jex, and down again in the second trapdoor.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "tunnels-under-sophanem:wp12gd:1eq59rt",
              "html": "You can speak to one of the Sophanem Guards here if you still need a torch, they will sell you one for 200 coins.",
              "text": "You can speak to one of the Sophanem Guards here if you still need a torch, they will sell you one for 200 coins.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "tunnels-under-sophanem:wp12gd:fxdu4x",
              "html": "Protect from magic prayers and auto-retaliate <b>off</b> is recommended.",
              "text": "Protect from magic prayers and auto-retaliate off is recommended.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "tunnels-under-sophanem:evlqk1",
          "html": "Follow the red line through the maze (pictured right). You can avoid traps by clicking on them, or walking around them where appropriate.",
          "text": "Follow the red line through the maze (pictured right). You can avoid traps by clicking on them, or walking around them where appropriate.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "tunnels-under-sophanem:evlqk1:dm4mi5",
              "html": "You can use the <a href=\"https://runescape.wiki/w/High_contrast_mode\" target=\"_blank\" rel=\"noopener\">high contrast mode</a> to make the traps easier to spot, except for the pitfalls.",
              "text": "You can use the high contrast mode to make the traps easier to spot, except for the pitfalls.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "tunnels-under-sophanem:evlqk1:lkfxtz",
              "html": "For high level players you can take the ladder in the north, marked (2) on the map.",
              "text": "For high level players you can take the ladder in the north, marked (2) on the map.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "tunnels-under-sophanem:evlqk1:dtvplz",
              "html": "Then run south west to ladder marked (6) to skip most of the maze.",
              "text": "Then run south west to ladder marked (6) to skip most of the maze.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "tunnels-under-sophanem:evlqk1:q9qvkt",
              "html": "Run east while avoiding the traps, north, and then west again and climb down the ladder.",
              "text": "Run east while avoiding the traps, north, and then west again and climb down the ladder.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "tunnels-under-sophanem:1huon5n",
          "html": "Run towards the larger room.",
          "text": "Run towards the larger room.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "tunnels-under-sophanem:1u7fgbh",
          "html": "Search Kaleef&#39;s body and read the parchment.",
          "text": "Search Kaleef's body and read the parchment.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "tunnels-under-sophanem:1twndxa",
          "html": "Talk to Maisa to the west.",
          "text": "Talk to Maisa to the west.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Draynor Village"
                },
                {
                  "key": "4",
                  "text": "Ozan and Leela."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "osman",
      "title": "Osman",
      "anchor": "Osman",
      "blocks": [
        {
          "type": "step",
          "id": "osman:zj76t1",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Osman\" target=\"_blank\" rel=\"noopener\">Osman</a> inside the <a href=\"https://runescape.wiki/w/Al_Kharid_palace\" target=\"_blank\" rel=\"noopener\">Al Kharid palace</a>.",
          "text": "Talk to Osman inside the Al Kharid palace.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I want to talk to you about Sophanem."
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "3",
                  "text": "It would drive a wedge between the Menaphite cities."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "osman:1sx6vnj",
          "html": "Prepare to fight a level 86 foe - a <a href=\"https://runescape.wiki/w/Giant_scarab\" target=\"_blank\" rel=\"noopener\">giant scarab</a>.",
          "text": "Prepare to fight a level 86 foe - a giant scarab.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "osman:1vetc7w",
          "html": "Talk to Osman outside the northern Sophanem gate.",
          "text": "Talk to Osman outside the northern Sophanem gate.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I know of a secret entrance to the north."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "osman:gak9f7",
          "html": "Run all the way back to Kaleef&#39;s body.",
          "text": "Run all the way back to Kaleef's body.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "the-final-fight",
      "title": "The final fight",
      "anchor": "The_final_fight",
      "blocks": [
        {
          "type": "step",
          "id": "the-final-fight:675z06",
          "html": "Kill the giant scarab and take the <a href=\"https://runescape.wiki/w/Keris\" target=\"_blank\" rel=\"noopener\">Keris</a>.",
          "text": "Kill the giant scarab and take the Keris.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-final-fight:675z06:gkoato",
              "html": "Optional: Players with level 50 Attack may head back up the ladder and kill a scarab mage or locust rider with the Keris dagger. This completes the <a href=\"https://runescape.wiki/w/Ludikeris\" target=\"_blank\" rel=\"noopener\">Ludikeris</a> achievement.",
              "text": "Optional: Players with level 50 Attack may head back up the ladder and kill a scarab mage or locust rider with the Keris dagger. This completes the Ludikeris achievement.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "the-final-fight:wpx7mw",
          "html": "Return to Sophanem and talk to the High Priest (there is no shortcut back, teleporting is possible).",
          "text": "Return to Sophanem and talk to the High Priest (there is no shortcut back, teleporting is possible).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-final-fight:fvxipr",
          "html": "Quest complete!",
          "text": "Quest complete!",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    }
