    "items": [
      {
        "html": "1 <a href=\"https://runescape.wiki/w/Quest_points\" target=\"_blank\" rel=\"noopener\">quest point</a>",
        "text": "1 quest point",
        "subs": []
      },
      {
        "html": "7,000 experience",
        "text": "7,000 experience",
        "subs": []
      },
      {
        "html": "2 × 7,000 experience <a href=\"https://runescape.wiki/w/Combat_lamp_(Contact!)\" target=\"_blank\" rel=\"noopener\">lamp</a> in a choice of <a href=\"https://runescape.wiki/w/Attack\" target=\"_blank\" rel=\"noopener\">Attack</a>, <a href=\"https://runescape.wiki/w/Strength\" target=\"_blank\" rel=\"noopener\">Strength</a>, <a href=\"https://runescape.wiki/w/Defence\" target=\"_blank\" rel=\"noopener\">Defence</a>, <a href=\"https://runescape.wiki/w/Constitution\" target=\"_blank\" rel=\"noopener\">Constitution</a>, <a href=\"https://runescape.wiki/w/Ranged\" target=\"_blank\" rel=\"noopener\">Ranged</a>, <a href=\"https://runescape.wiki/w/Magic\" target=\"_blank\" rel=\"noopener\">Magic</a> or <a href=\"https://runescape.wiki/w/Summoning\" target=\"_blank\" rel=\"noopener\">Summoning</a> (Summoning must be level 30 or higher)",
        "text": "2 × 7,000 experience lamp in a choice of Attack, Strength, Defence, Constitution, Ranged, Magic or Summoning (Summoning must be level 30 or higher)",
        "subs": [
          "If you destroy the experience lamp, another may be obtained by talking to the <a href=\"https://runescape.wiki/w/High_Priest_(Sophanem)\" target=\"_blank\" rel=\"noopener\">High Priest</a>"
        ]
      },
      {
        "html": "<a href=\"https://runescape.wiki/w/Keris\" target=\"_blank\" rel=\"noopener\">Keris</a>, a dagger which is very effective against <a href=\"https://runescape.wiki/w/Kalphites\" target=\"_blank\" rel=\"noopener\">Kalphites</a> and <a href=\"https://runescape.wiki/w/Scarab_(disambiguation)\" target=\"_blank\" rel=\"noopener\">Scarabs</a>",
        "text": "Keris, a dagger which is very effective against Kalphites and Scarabs",
        "subs": []
      },
      {
        "html": "Access to <a href=\"https://runescape.wiki/w/Sophanem_bank\" target=\"_blank\" rel=\"noopener\">Sophanem bank</a> under the Temple of Lesser Deities in the north-east corner (useful for <a href=\"https://runescape.wiki/w/Pyramid_Plunder\" target=\"_blank\" rel=\"noopener\">Pyramid Plunder</a>)",
        "text": "Access to Sophanem bank under the Temple of Lesser Deities in the north-east corner (useful for Pyramid Plunder)",
        "subs": []
      },
      {
        "html": "<a href=\"https://runescape.wiki/w/Coenus\" target=\"_blank\" rel=\"noopener\">Coenus</a> will allow a one-way passage from <a href=\"https://runescape.wiki/w/Menaphos\" target=\"_blank\" rel=\"noopener\">Menaphos</a> to <a href=\"https://runescape.wiki/w/Sophanem\" target=\"_blank\" rel=\"noopener\">Sophanem</a>.",
        "text": "Coenus will allow a one-way passage from Menaphos to Sophanem.",
        "subs": []
      }
    ],
