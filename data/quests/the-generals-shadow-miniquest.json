  "sections": [
    {
      "id": "ghosting",
      "title": "Ghosting",
      "anchor": "Ghosting",
      "blocks": [
        {
          "type": "step",
          "id": "ghosting:13yoq4q",
          "html": "Equip all <a href=\"https://runescape.wiki/w/Ghostly_robe_outfit\" target=\"_blank\" rel=\"noopener\">ghostly robe outfit</a>, the <a href=\"https://runescape.wiki/w/Ring_of_visibility\" target=\"_blank\" rel=\"noopener\">ring of visibility</a> and a <a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">ghostspeak amulet</a> or <a href=\"https://runescape.wiki/w/Cramulet\" target=\"_blank\" rel=\"noopener\">cramulet</a>.",
          "text": "Equip all ghostly robe outfit, the ring of visibility and a ghostspeak amulet or cramulet.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:1wsyhea",
          "html": "South of the <a href=\"https://runescape.wiki/w/Fremennik_Province_lodestone\" target=\"_blank\" rel=\"noopener\">Fremennik Province lodestone</a> and just south-west of the <a href=\"https://runescape.wiki/w/Swaying_tree\" target=\"_blank\" rel=\"noopener\">swaying tree</a>, find and then talk to the ghost of General Khazard.",
          "text": "South of the Fremennik Province lodestone and just south-west of the swaying tree, find and then talk to the ghost of General Khazard.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Uh, well, you don't really have eyes, so how can you tell?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "ghosting:1wsyhea:ugnt4",
              "html": "Khazard, and all of the ghost scouts you&#39;ll locate next, cannot be seen on the minimap and have a fair-sized wander radius.",
              "text": "Khazard, and all of the ghost scouts you'll locate next, cannot be seen on the minimap and have a fair-sized wander radius.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "ghosting:1wsyhea:13q3dxr",
              "html": "It is recommended to use the <a href=\"https://runescape.wiki/w/Skyboxes_and_filters\" target=\"_blank\" rel=\"noopener\">skybox</a> bloodstone if the player has completed <a href=\"https://runescape.wiki/w/The_Lord_of_Vampyrium\" target=\"_blank\" rel=\"noopener\">The Lord of Vampyrium</a> quest but can be done without, or use High Contrast Mode under Accessibility Options.",
              "text": "It is recommended to use the skybox bloodstone if the player has completed The Lord of Vampyrium quest but can be done without, or use High Contrast Mode under Accessibility Options.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "ghosting:106h8qh",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Sin_Seer\" target=\"_blank\" rel=\"noopener\">Sin Seer</a> in <a href=\"https://runescape.wiki/w/Seers%27_Village\" target=\"_blank\" rel=\"noopener\">Seers&#39; Village</a>. She is upstairs in the spinning wheel house.",
          "text": "Talk to Sin Seer in Seers' Village. She is upstairs in the spinning wheel house.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Bribe"
                },
                {
                  "key": "1",
                  "text": "Here's the money."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:1ixb329",
          "html": "Return to General Khazard.",
          "text": "Return to General Khazard.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:1qh0uo0",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Scout_(Tai_Bwo_Wannai)\" target=\"_blank\" rel=\"noopener\">ghost scout</a> south-east of <a href=\"https://runescape.wiki/w/Tai_Bwo_Wannai\" target=\"_blank\" rel=\"noopener\">Tai Bwo Wannai</a> (search between the <a href=\"https://runescape.wiki/w/Hardwood_grove\" target=\"_blank\" rel=\"noopener\">hardwood grove</a> and the drakolith mine).",
          "text": "Talk to the ghost scout south-east of Tai Bwo Wannai (search between the hardwood grove and the drakolith mine).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:106vm5r",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Scout_(Tree_Gnome_Stronghold)\" target=\"_blank\" rel=\"noopener\">ghost scout</a> south of the <a href=\"https://runescape.wiki/w/Tree_Gnome_Stronghold\" target=\"_blank\" rel=\"noopener\">Tree Gnome Stronghold</a> entrance (east of the <a href=\"https://runescape.wiki/w/Outpost\" target=\"_blank\" rel=\"noopener\">Outpost</a>).",
          "text": "Talk to the ghost scout south of the Tree Gnome Stronghold entrance (east of the Outpost).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:86o3hv",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Scout_(Falador)\" target=\"_blank\" rel=\"noopener\">ghost scout</a> in the area between <a href=\"https://runescape.wiki/w/Falador\" target=\"_blank\" rel=\"noopener\">Falador</a> and <a href=\"https://runescape.wiki/w/Draynor_Manor\" target=\"_blank\" rel=\"noopener\">Draynor Manor</a>.",
          "text": "Talk to the ghost scout in the area between Falador and Draynor Manor.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:1u0fur4",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Scout_(Shantay_Pass)\" target=\"_blank\" rel=\"noopener\">ghost scout</a> south of the <a href=\"https://runescape.wiki/w/Shantay_Pass\" target=\"_blank\" rel=\"noopener\">Shantay Pass</a>.",
          "text": "Talk to the ghost scout south of the Shantay Pass.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:1ixb329-2",
          "html": "Return to General Khazard.",
          "text": "Return to General Khazard.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:142g5vy",
          "html": "Prepare for battle before fighting against a level 91 enemy.",
          "text": "Prepare for battle before fighting against a level 91 enemy.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:1lqbkzc",
          "html": "Enter the goblin cave east of the <a href=\"https://runescape.wiki/w/Fishing_Guild\" target=\"_blank\" rel=\"noopener\">Fishing Guild</a>.",
          "text": "Enter the goblin cave east of the Fishing Guild.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:ys7abv",
          "html": "Run to the northeast &quot;room&quot; and enter the crack in the southern wall.",
          "text": "Run to the northeast \"room\" and enter the crack in the southern wall.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghosting:kph4e4",
          "html": "Kill the Bouncer. You&#39;ll throw the <a href=\"https://runescape.wiki/w/Severed_leg\" target=\"_blank\" rel=\"noopener\">severed leg</a> when its health reaches 0.",
          "text": "Kill the Bouncer. You'll throw the severed leg when its health reaches 0.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "ghosting:kph4e4:1s46v5m",
              "html": "If Bouncer&#39;s health is stuck at 0, the player should leave the room, dismiss any familiars, and reenter to try killing Bouncer again. Once at 0 health, continue clicking on him until your character automatically throws the severed leg.",
              "text": "If Bouncer's health is stuck at 0, the player should leave the room, dismiss any familiars, and reenter to try killing Bouncer again. Once at 0 health, continue clicking on him until your character automatically throws the severed leg.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "ghosting:1eh5umu",
          "html": "Miniquest complete!",
          "text": "Miniquest complete!",
          "dialogue": [],
