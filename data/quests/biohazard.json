        {
          "type": "step",
          "id": "getting-started:ceouvr",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Elena\" target=\"_blank\" rel=\"noopener\">Elena</a> in a house just west of the <a href=\"https://runescape.wiki/w/East_Ardougne\" target=\"_blank\" rel=\"noopener\">East Ardougne</a> north bank, across the river.",
          "text": "Talk to Elena in a house just west of the East Ardougne north bank, across the river.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:e01lvl",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Jerico\" target=\"_blank\" rel=\"noopener\">Jerico</a>, who is in the building south of the Ardougne north bank.",
          "text": "Talk to Jerico, who is in the building south of the Ardougne north bank.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1e53159",
          "html": "Search the cupboard in Jerico&#39;s house for some <a href=\"https://runescape.wiki/w/Bird_feed\" target=\"_blank\" rel=\"noopener\">bird feed</a>.",
          "text": "Search the cupboard in Jerico's house for some bird feed.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:w0nudl",
          "html": "Go to the outside eastern wall of Jerico&#39;s house and pick up a <a href=\"https://runescape.wiki/w/Pigeon_cage\" target=\"_blank\" rel=\"noopener\">pigeon cage</a>.",
          "text": "Go to the outside eastern wall of Jerico's house and pick up a pigeon cage.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:15ggpre",
          "html": "Go back across the river, west of the castle to the <a href=\"https://runescape.wiki/w/West_Ardougne\" target=\"_blank\" rel=\"noopener\">West Ardougne</a> gate.",
          "text": "Go back across the river, west of the castle to the West Ardougne gate.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:2vvkd8",
          "html": "Use bird feed on the watchtower fence (the spears, highlighted in red on your minimap) where several <a href=\"https://runescape.wiki/w/Mourner\" target=\"_blank\" rel=\"noopener\">Mourners</a> are perched above.",
          "text": "Use bird feed on the watchtower fence (the spears, highlighted in red on your minimap) where several Mourners are perched above.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:p4qo9q",
          "html": "Open the pigeon cage.",
          "text": "Open the pigeon cage.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1aidymj",
          "html": "Go south along the wall and talk to <a href=\"https://runescape.wiki/w/Omart\" target=\"_blank\" rel=\"noopener\">Omart</a>. Make sure to finish the dialogue",
          "text": "Go south along the wall and talk to Omart. Make sure to finish the dialogue",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Okay, Let's do this"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
