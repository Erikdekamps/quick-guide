        },
        {
          "type": "step",
          "id": "members-only:d7ynlc",
          "html": "Teleport to <a href=\"https://runescape.wiki/w/Anachronia_lodestone\" target=\"_blank\" rel=\"noopener\">Anachronia lodestone</a> to collect the <a href=\"https://runescape.wiki/w/Foot_(Benedict%27s_World_Tour)\" target=\"_blank\" rel=\"noopener\">foot</a> slightly south-east of the lodestone.",
          "text": "Teleport to Anachronia lodestone to collect the foot slightly south-east of the lodestone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "members-only:8yfkwo",
          "html": "Head west of the <a href=\"https://runescape.wiki/w/Menaphos\" target=\"_blank\" rel=\"noopener\">Menaphos</a> gates to pass through the <a href=\"https://runescape.wiki/w/World_window\" target=\"_blank\" rel=\"noopener\">world window</a> and continue slightly north to collect the <a href=\"https://runescape.wiki/w/Frogburger_(Benedict%27s_World_Tour)\" target=\"_blank\" rel=\"noopener\">frogburger</a>. Alternatively, teleport to <a href=\"https://runescape.wiki/w/Mazcab\" target=\"_blank\" rel=\"noopener\">Mazcab</a> directly and run south.",
          "text": "Head west of the Menaphos gates to pass through the world window and continue slightly north to collect the frogburger. Alternatively, teleport to Mazcab directly and run south.",
