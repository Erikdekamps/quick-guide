        {
          "type": "step",
          "id": "to-fight-a-god:15jmzyh",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Adrasteia\" target=\"_blank\" rel=\"noopener\">Adrasteia</a> in the library on the 1<sup>st</sup> floor (UK) / 2<sup>nd</sup> floor (US) of <a href=\"https://runescape.wiki/w/White_Knights%27_Castle\" target=\"_blank\" rel=\"noopener\">White Knights&#39; Castle</a> in <a href=\"https://runescape.wiki/w/Falador\" target=\"_blank\" rel=\"noopener\">Falador</a>.",
