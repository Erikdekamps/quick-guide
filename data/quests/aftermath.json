          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "to-fight-a-god:1ogiuu7",
          "html": "Enter <a href=\"https://runescape.wiki/w/Senntisten\" target=\"_blank\" rel=\"noopener\">Senntisten</a> through the <a href=\"https://runescape.wiki/w/Ancient_door_(Senntisten)\" target=\"_blank\" rel=\"noopener\">ancient door</a> at the <a href=\"https://runescape.wiki/w/Varrock_Dig_Site\" target=\"_blank\" rel=\"noopener\">Varrock Dig Site</a>.",
          "text": "Enter Senntisten through the ancient door at the Varrock Dig Site.",
