    {
      "id": "fish-finding",
      "title": "Fish Finding",
      "anchor": "Fish_Finding",
      "blocks": [
        {
          "type": "step",
          "id": "fish-finding:1q4m2zu",
          "html": "Head back to the Fishing Guild and talk to Jones.",
          "text": "Head back to the Fishing Guild and talk to Jones.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Lead the way!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "fish-finding:172s28o",
          "html": "Track the Thalassus via the wreckage. Dismiss your follower if you have one.",
          "text": "Track the Thalassus via the wreckage. Dismiss your follower if you have one.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "fish-finding:172s28o:1rwpdj3",
              "html": "The track is always the same during the same session, even after a reset.",
              "text": "The track is always the same during the same session, even after a reset.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "fish-finding:1c24odx",
          "html": "Optional: Each shipwreck has some loot, but you can only take 3 &quot;items&quot; in total by choose the loot option on the shipwreck.",
          "text": "Optional: Each shipwreck has some loot, but you can only take 3 \"items\" in total by choose the loot option on the shipwreck.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "fish-finding:1c24odx:187es06",
              "html": "The remaining loot will sink when the loot window has been closed for that specific shipwreck.",
              "text": "The remaining loot will sink when the loot window has been closed for that specific shipwreck.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
