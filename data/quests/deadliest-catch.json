          "recommended": []
        },
        {
          "type": "step",
          "id": "getting-started:bak69m",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Jones_the_fisherman\" target=\"_blank\" rel=\"noopener\">Jones the fisherman</a> outside the <a href=\"https://runescape.wiki/w/Fishing_Guild\" target=\"_blank\" rel=\"noopener\">Fishing Guild</a> bank.",
          "text": "Talk to Jones the fisherman outside the Fishing Guild bank.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "1",
                  "text": "You need an extra rower?"
                },
                {
                  "key": "2",
                  "text": "You need a giant harpoon?"
                },
                {
                  "key": "3",
                  "text": "You need a particular sea chart?"
                },
                {
                  "key": "4",
                  "text": "Can you tell me more about the Thalassus?"
                },
                {
                  "key": "2",
                  "text": "That's horrible!"
                },
                {
                  "key": "5",
                  "text": "Actually, I'll be right back."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:11o2mno",
          "html": "Pickpocket the <a href=\"https://runescape.wiki/w/Master_fisher\" target=\"_blank\" rel=\"noopener\">Master fisher</a> (near the guild entrance) for the sea chart. This may take several attempts.",
          "text": "Pickpocket the Master fisher (near the guild entrance) for the sea chart. This may take several attempts.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
