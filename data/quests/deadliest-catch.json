    {
      "id": "preparing-a-hunt",
      "title": "Preparing a Hunt",
      "anchor": "Preparing_a_Hunt",
      "blocks": [
        {
          "type": "step",
          "id": "preparing-a-hunt:7xw3ku",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Linza\" target=\"_blank\" rel=\"noopener\">Linza</a> who is east of the Fishing Guild in <a href=\"https://runescape.wiki/w/Hemenster\" target=\"_blank\" rel=\"noopener\">Hemenster</a>.",
          "text": "Talk to Linza who is east of the Fishing Guild in Hemenster.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "preparing-a-hunt:1rum280",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Tower_of_Life_(building)\" target=\"_blank\" rel=\"noopener\">Tower of Life</a> south of <a href=\"https://runescape.wiki/w/Ardougne\" target=\"_blank\" rel=\"noopener\">Ardougne</a>. (Fairy ring <b>D</b><b>J</b><b>P</b> or <a href=\"https://runescape.wiki/w/Kandarin_monastery_Teleport\" target=\"_blank\" rel=\"noopener\">Kandarin monastery Teleport</a>)",
          "text": "Go to the Tower of Life south of Ardougne. (Fairy ring DJP or Kandarin monastery Teleport)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "preparing-a-hunt:k9tv2e",
          "html": "Talk to <a href=\"https://runescape.wiki/w/%27The_Guns%27\" target=\"_blank\" rel=\"noopener\">&#39;The Guns&#39;</a>.",
          "text": "Talk to 'The Guns'.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "preparing-a-hunt:qe1f9o",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Bonafido\" target=\"_blank\" rel=\"noopener\">Bonafido</a> for <a href=\"https://runescape.wiki/w/Builder%27s_tea\" target=\"_blank\" rel=\"noopener\">builder&#39;s tea</a>.",
          "text": "Talk to Bonafido for builder's tea.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "preparing-a-hunt:mpnvs5",
          "html": "East of the tower, pick the southern most of the 3 lowland heather bunch directly east of the Tower of Life. Only one is needed.",
          "text": "East of the tower, pick the southern most of the 3 lowland heather bunch directly east of the Tower of Life. Only one is needed.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "preparing-a-hunt:1tf40x0",
          "html": "Use the heather on the tea.",
          "text": "Use the heather on the tea.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "preparing-a-hunt:k9tv2e-2",
          "html": "Talk to &#39;The Guns&#39;.",
          "text": "Talk to 'The Guns'.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
