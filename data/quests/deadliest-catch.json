    {
      "id": "the-mermaids",
      "title": "The Mermaids",
      "anchor": "The_Mermaids",
      "blocks": [
        {
          "type": "step",
          "id": "the-mermaids:kb7493",
          "html": "Talk to the group of mermaids.",
          "text": "Talk to the group of mermaids.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "The Thalassus has eaten Jones the mighty fisherman."
                },
                {
                  "key": "1",
                  "text": "It should, he's been hunting for decades."
                },
                {
                  "key": "3",
                  "text": "Very horrid! After he's killed the Thalassus, he'll probably come after you."
                },
                {
                  "key": "2",
                  "text": "Trust me, I'm a great adventurer, I should know."
                },
                {
                  "key": "3",
                  "text": "Did I mention Jones has a harpoon with him?"
                },
                {
                  "key": "1",
                  "text": "It's no ordinary harpoon."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
