      "anchor": "The_puzzles",
      "blocks": [
        {
          "type": "text",
          "html": "The tests may not appear in this particular order, and you may not receive all of the tests."
        },
        {
          "type": "step",
          "id": "the-puzzles:i70jr2",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Sir_Tiffy_Cashien\" target=\"_blank\" rel=\"noopener\">Sir Tiffy Cashien</a> without any items equipped or in the inventory. He can be found in the <a href=\"https://runescape.wiki/w/Falador_Park\" target=\"_blank\" rel=\"noopener\">Falador Park</a>.",
          "text": "Talk to Sir Tiffy Cashien without any items equipped or in the inventory. He can be found in the Falador Park.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Yes, let's go!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-puzzles:1axrq0u",
          "html": "Optionally, sit on the bench next to Sir Tiffy Cashien to complete the achievement: <a href=\"https://runescape.wiki/w/Tiffy_Time\" target=\"_blank\" rel=\"noopener\">Tiffy Time</a>.",
          "text": "Optionally, sit on the bench next to Sir Tiffy Cashien to complete the achievement: Tiffy Time.",
