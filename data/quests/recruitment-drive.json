          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Lady Table"
        },
        {
          "type": "step",
          "id": "the-puzzles:1uzbcec",
          "html": "In this room there will be eleven statues when there should be twelve. The goal is to study the statues then, when the twelfth one is returned, pick the one that was originally missing.",
          "text": "In this room there will be eleven statues when there should be twelve. The goal is to study the statues then, when the twelfth one is returned, pick the one that was originally missing.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-puzzles:1uzbcec:1pxfrgl",
              "html": "Easy method: look for the colour (bronze, silver, gold) of statue that only has 2 statues instead of 3, then note which weapon of that colour is missing out of the 4 possibilities (sword, halberd, great axe, or mace.)",
              "text": "Easy method: look for the colour (bronze, silver, gold) of statue that only has 2 statues instead of 3, then note which weapon of that colour is missing out of the 4 possibilities (sword, halberd, great axe, or mace.)",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "the-puzzles:1uzbcec:osy251",
              "html": "Alternative method: the moment it shows 12 statues, take a screenshot. Then open the screenshot and compare which was missing and click it.",
              "text": "Alternative method: the moment it shows 12 statues, take a screenshot. Then open the screenshot and compare which was missing and click it.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "the-puzzles:1tpqb3v",
          "html": "Find the statue that wasn&#39;t there originally and touch it.",
          "text": "Find the statue that wasn't there originally and touch it.",
