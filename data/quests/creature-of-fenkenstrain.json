    {
      "id": "decapitated-head",
      "title": "Decapitated head",
      "anchor": "Decapitated_head",
      "blocks": [
        {
          "type": "step",
          "id": "decapitated-head:8d60ox",
          "html": "Equip your <a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">ghostspeak amulet</a>.",
          "text": "Equip your ghostspeak amulet.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:12e10xp",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Gardener_Ghost\" target=\"_blank\" rel=\"noopener\">Gardener Ghost</a> on the ground floor (UK) / 1<sup>st</sup> floor (US) in the northern side.",
          "text": "Talk to the Gardener Ghost on the ground floor (UK) / 1st floor (US) in the northern side.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "What happened to your head?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:1qg86gg",
          "html": "Lead him south-east into the <a href=\"https://runescape.wiki/w/Haunted_Woods\" target=\"_blank\" rel=\"noopener\">Haunted Woods</a>. (Don&#39;t worry about him getting stuck he will teleport back to you)",
          "text": "Lead him south-east into the Haunted Woods. (Don't worry about him getting stuck he will teleport back to you)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:5j6x4q",
          "html": "Periodically talk to him for directions and dig at graves by choosing the &quot;Dig&quot; option until the <a href=\"https://runescape.wiki/w/Decapitated_head_(Creature_of_Fenkenstrain)\" target=\"_blank\" rel=\"noopener\">decapitated head</a> is found.",
          "text": "Periodically talk to him for directions and dig at graves by choosing the \"Dig\" option until the decapitated head is found.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "decapitated-head:5j6x4q:uiouv1",
              "html": "The grave is about 10 squares east and 5 squares south of the fairy ring. Choose the &quot;Dig&quot; option on the nearby grave.",
              "text": "The grave is about 10 squares east and 5 squares south of the fairy ring. Choose the \"Dig\" option on the nearby grave.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Pickled brain"
        },
        {
          "type": "step",
          "id": "decapitated-head:stthcv",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Hair_of_the_Dog\" target=\"_blank\" rel=\"noopener\">tavern</a> in <a href=\"https://runescape.wiki/w/Canifis\" target=\"_blank\" rel=\"noopener\">Canifis</a>.",
          "text": "Go to the tavern in Canifis.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:2f3eza",
          "html": "Take a <a href=\"https://runescape.wiki/w/Pickled_brain\" target=\"_blank\" rel=\"noopener\">pickled brain</a> off the table for 50 coins or by using <a href=\"https://runescape.wiki/w/Telekinetic_Grab\" target=\"_blank\" rel=\"noopener\">Telekinetic Grab</a> on it.",
          "text": "Take a pickled brain off the table for 50 coins or by using Telekinetic Grab on it.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "decapitated-head:2f3eza:drrwp7",
              "html": "Telekinetic grabbing the brain completes a <a href=\"https://runescape.wiki/w/Morytania_achievements#Medium_achievements\" target=\"_blank\" rel=\"noopener\">medium Morytania achievement</a>, <a href=\"https://runescape.wiki/w/Brain_Bending\" target=\"_blank\" rel=\"noopener\">Brain Bending</a>.",
              "text": "Telekinetic grabbing the brain completes a medium Morytania achievement, Brain Bending.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "decapitated-head:18wgqil",
          "html": "Use the <a href=\"https://runescape.wiki/w/Decapitated_head_(Creature_of_Fenkenstrain)\" target=\"_blank\" rel=\"noopener\">decapitated head</a> on the pickled brain.",
          "text": "Use the decapitated head on the pickled brain.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Arms, legs and torso"
        },
        {
          "type": "step",
          "id": "decapitated-head:17qrl9n",
          "html": "Head east of <a href=\"https://runescape.wiki/w/Fenkenstrain%27s_Castle\" target=\"_blank\" rel=\"noopener\">Fenkenstrain&#39;s Castle</a> to the tombstones just west of the <a href=\"https://runescape.wiki/w/Musician\" target=\"_blank\" rel=\"noopener\">Musician</a>.",
          "text": "Head east of Fenkenstrain's Castle to the tombstones just west of the Musician.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:1g6kxz2",
          "html": "Use the star amulet on the easternmost memorial.",
          "text": "Use the star amulet on the easternmost memorial.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:bm9kn9",
          "html": "Push the memorial to enter <a href=\"https://runescape.wiki/w/Fenkenstrain%27s_Dungeon\" target=\"_blank\" rel=\"noopener\">Fenkenstrain&#39;s Dungeon</a>.",
          "text": "Push the memorial to enter Fenkenstrain's Dungeon.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:2cs59i",
          "html": "Kill an <a href=\"https://runescape.wiki/w/Experiment\" target=\"_blank\" rel=\"noopener\">experiment</a> creature with a wolf&#39;s body and woman&#39;s head and pick up the <a href=\"https://runescape.wiki/w/Cavern_key\" target=\"_blank\" rel=\"noopener\">cavern key</a>.",
          "text": "Kill an experiment creature with a wolf's body and woman's head and pick up the cavern key.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:17e4snv",
          "html": "Continue north-west and open the entrance.",
          "text": "Continue north-west and open the entrance.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:ch27pp",
          "html": "Go up the ladder.",
          "text": "Go up the ladder.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "decapitated-head:c6adif",
          "html": "Go north and right-click dig on all 3 of the graves to obtain <a href=\"https://runescape.wiki/w/Torso_(Creature_of_Fenkenstrain)\" target=\"_blank\" rel=\"noopener\">torso</a>, <a href=\"https://runescape.wiki/w/Arms\" target=\"_blank\" rel=\"noopener\">arms</a> and <a href=\"https://runescape.wiki/w/Legs\" target=\"_blank\" rel=\"noopener\">legs</a>",
          "text": "Go north and right-click dig on all 3 of the graves to obtain torso, arms and legs",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
