        {
          "type": "step",
          "id": "lightning:d2eeq8",
          "html": "Use the 3 garden canes on the brush for an <a href=\"https://runescape.wiki/w/Extended_brush\" target=\"_blank\" rel=\"noopener\">extended brush</a>, consuming 3 spools of bronze wire.",
          "text": "Use the 3 garden canes on the brush for an extended brush, consuming 3 spools of bronze wire.",
