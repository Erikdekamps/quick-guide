      "id": "under-arrest",
      "title": "Under arrest",
      "anchor": "Under_arrest",
      "blocks": [
        {
          "type": "step",
          "id": "under-arrest:owtcfg",
          "html": "Enter the tunnel between the two black statues, north-east of <a href=\"https://runescape.wiki/w/Rellekka\" target=\"_blank\" rel=\"noopener\">Rellekka</a>, close to fairy ring <b>D</b><b>K</b><b>S</b>. (teleport to the <a href=\"https://runescape.wiki/w/Fremennik_Province\" target=\"_blank\" rel=\"noopener\">Fremennik Province</a> and run north-east)",
          "text": "Enter the tunnel between the two black statues, north-east of Rellekka, close to fairy ring DKS. (teleport to the Fremennik Province and run north-east)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "under-arrest:11wu54x",
          "html": "Go through cave entrance east to <a href=\"https://runescape.wiki/w/Keldagrim\" target=\"_blank\" rel=\"noopener\">Keldagrim</a>.",
          "text": "Go through cave entrance east to Keldagrim.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "under-arrest:zb8nfy",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Dwarven_Boatman\" target=\"_blank\" rel=\"noopener\">Dwarven Boatman</a> inside the cave, not <a href=\"https://runescape.wiki/w/Dwarven_Ferryman\" target=\"_blank\" rel=\"noopener\">Dwarven Ferryman</a>.",
          "text": "Talk to the Dwarven Boatman inside the cave, not Dwarven Ferryman.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "under-arrest:1jmtu09",
          "html": "Go west to the Black Guard H.Q.. Enter the building and talk to <a href=\"https://runescape.wiki/w/Commander_Veldaban\" target=\"_blank\" rel=\"noopener\">Commander Veldaban</a>. The chat instance should end with you accepting the quest.",
          "text": "Go west to the Black Guard H.Q.. Enter the building and talk to Commander Veldaban. The chat instance should end with you accepting the quest.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "under-arrest:s9xha8",
          "html": "Exit the house, go north-east across the bridge and talk to <a href=\"https://runescape.wiki/w/Blasidar_the_Sculptor\" target=\"_blank\" rel=\"noopener\">Blasidar the Sculptor</a> just north-west of the brewery.",
          "text": "Exit the house, go north-east across the bridge and talk to Blasidar the Sculptor just north-west of the brewery.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Yes, I will do this."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
