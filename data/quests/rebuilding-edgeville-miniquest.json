      "blocks": [
        {
          "type": "step",
          "id": "checklist:1b0d8mh",
          "html": "Start by talking to <a href=\"https://runescape.wiki/w/Vannaka\" target=\"_blank\" rel=\"noopener\">Vannaka</a> near the lever teleport from <a href=\"https://runescape.wiki/w/Edgeville\" target=\"_blank\" rel=\"noopener\">Edgeville</a>, for a <a href=\"https://runescape.wiki/w/To-Do_list_(Rebuilding_Edgeville)\" target=\"_blank\" rel=\"noopener\">To-Do list</a>..",
          "text": "Start by talking to Vannaka near the lever teleport from Edgeville, for a To-Do list..",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Did you see what attacked Edgeville?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "checklist:1m0tz1t",
          "html": "Head to Aggie&#39;s house which is north-west of the <a href=\"https://runescape.wiki/w/Draynor_Village\" target=\"_blank\" rel=\"noopener\">Draynor Village</a> bank and take the <a href=\"https://runescape.wiki/w/Broom_(scenery)\" target=\"_blank\" rel=\"noopener\">broom</a> when Aggie is not looking at you to obtain <a href=\"https://runescape.wiki/w/Aggie%27s_broom_(uncharged)\" target=\"_blank\" rel=\"noopener\">Aggie&#39;s broom (uncharged)</a>.",
          "text": "Head to Aggie's house which is north-west of the Draynor Village bank and take the broom when Aggie is not looking at you to obtain Aggie's broom (uncharged).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "checklist:m9jtk5",
          "html": "Charge the uncharged broom with 100 water runes to obtain <a href=\"https://runescape.wiki/w/Aggie%27s_broom\" target=\"_blank\" rel=\"noopener\">Aggie&#39;s broom</a>.",
          "text": "Charge the uncharged broom with 100 water runes to obtain Aggie's broom.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "checklist:s5ntv3",
