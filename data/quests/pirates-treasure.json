        {
          "type": "step",
          "id": "the-smuggling-job:15cfp8l",
          "html": "Head inside the <a href=\"https://runescape.wiki/w/Karamja_Wines,_Spirits,_and_Beers\" target=\"_blank\" rel=\"noopener\">pub</a>.",
          "text": "Head inside the pub.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-smuggling-job:1sdlgtj",
          "html": "Buy one <a href=\"https://runescape.wiki/w/Karamjan_rum\" target=\"_blank\" rel=\"noopener\">Karamjan rum</a> from <a href=\"https://runescape.wiki/w/Zembo\" target=\"_blank\" rel=\"noopener\">Zembo</a>.",
          "text": "Buy one Karamjan rum from Zembo.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-smuggling-job:1x8wcns",
          "html": "Do <b>not</b> leave the island yet or more rum will have to be obtained.",
          "text": "Do not leave the island yet or more rum will have to be obtained.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-smuggling-job:ehriyl",
          "html": "Pick 10 <a href=\"https://runescape.wiki/w/Banana\" target=\"_blank\" rel=\"noopener\">bananas</a> from the <a href=\"https://runescape.wiki/w/Banana_Tree\" target=\"_blank\" rel=\"noopener\">Banana Trees</a> to the north-west.",
          "text": "Pick 10 bananas from the Banana Trees to the north-west.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-smuggling-job:1m07vyq",
          "html": "Go east to the house by the docks.",
          "text": "Go east to the house by the docks.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-smuggling-job:ojwzyb",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Luthas\" target=\"_blank\" rel=\"noopener\">Luthas</a> about the <a href=\"https://runescape.wiki/w/Customs_officer\" target=\"_blank\" rel=\"noopener\">officer</a>.",
          "text": "Talk to Luthas about the officer.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "That customs officer is annoying isn't she?"
                }
              ]
            },
            {
              "when": "Then talk to him a second time to ask for a job",
              "options": [
                {
                  "key": "1",
                  "text": "Could you offer me employment on your plantation?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-smuggling-job:vj0lij",
          "html": "On the east side of Luthas&#39; house will be a wooden crate.",
          "text": "On the east side of Luthas' house will be a wooden crate.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-smuggling-job:1vv58pk",
          "html": "<i>Use</i> the Karamjan rum on the crate, then right-click <i>Fill</i> the crate.",
          "text": "Use the Karamjan rum on the crate, then right-click Fill the crate.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
