    {
      "id": "retrieving-the-rum",
      "title": "Retrieving the rum",
      "anchor": "Retrieving_the_rum",
      "blocks": [
        {
          "type": "step",
          "id": "retrieving-the-rum:1fns49a",
          "html": "Head to <a href=\"https://runescape.wiki/w/Wydin%27s_Food_Store\" target=\"_blank\" rel=\"noopener\">Wydin&#39;s Food Store</a> in Port Sarim.",
          "text": "Head to Wydin's Food Store in Port Sarim.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "retrieving-the-rum:1bwwne7",
          "html": "Equip your <a href=\"https://runescape.wiki/w/White_apron\" target=\"_blank\" rel=\"noopener\">white apron</a> and attempt to open the door to the back room.",
          "text": "Equip your white apron and attempt to open the door to the back room.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Well, can I get a job here?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "retrieving-the-rum:1bwwne7:l6dnq3",
              "html": "A free <a href=\"https://runescape.wiki/w/White_apron\" target=\"_blank\" rel=\"noopener\">white apron</a> can be obtained from the back wall in the <a href=\"https://runescape.wiki/w/Gerrant%27s_Fishy_Business\" target=\"_blank\" rel=\"noopener\">fishing store</a>.",
              "text": "A free white apron can be obtained from the back wall in the fishing store.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "retrieving-the-rum:ho9lvv",
          "html": "Search the crate with the banana on it.",
          "text": "Search the crate with the banana on it.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "retrieving-the-rum:1nbnvqw",
          "html": "With the rum, return to <a href=\"https://runescape.wiki/w/Redbeard_Frank\" target=\"_blank\" rel=\"noopener\">Redbeard Frank</a> for a <a href=\"https://runescape.wiki/w/Chest_key_(Pirate%27s_Treasure)\" target=\"_blank\" rel=\"noopener\">chest key</a>.",
          "text": "With the rum, return to Redbeard Frank for a chest key.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Ok thanks, I'll go and get it."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
