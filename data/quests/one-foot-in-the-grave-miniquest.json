  "sections": [
    {
      "id": "off-to-see-the-wizard",
      "title": "Off to see the wizard",
      "anchor": "Off_to_see_the_wizard",
      "blocks": [
        {
          "type": "step",
          "id": "off-to-see-the-wizard:k0xrrl",
          "html": "Check your bank for a <a href=\"https://runescape.wiki/w/Hand_(Back_to_my_Roots)\" target=\"_blank\" rel=\"noopener\">Hand</a>.",
          "text": "Check your bank for a Hand.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "off-to-see-the-wizard:k0xrrl:jvijrh",
              "html": "You may obtain one from an <a href=\"https://runescape.wiki/w/RPDT_employee\" target=\"_blank\" rel=\"noopener\">RPDT employee</a> in <a href=\"https://runescape.wiki/w/East_Ardougne\" target=\"_blank\" rel=\"noopener\">East Ardougne</a> or by killing creatures in the <a href=\"https://runescape.wiki/w/Jade_vine_maze\" target=\"_blank\" rel=\"noopener\">jade vine maze</a> (at least one empty backpack space is required to obtain it as a drop).",
              "text": "You may obtain one from an RPDT employee in East Ardougne or by killing creatures in the jade vine maze (at least one empty backpack space is required to obtain it as a drop).",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "off-to-see-the-wizard:7vljbi",
          "html": "With the hand, head to the <a href=\"https://runescape.wiki/w/Wizards%27_Guild\" target=\"_blank\" rel=\"noopener\">Wizards&#39; Guild</a> in <a href=\"https://runescape.wiki/w/Yanille\" target=\"_blank\" rel=\"noopener\">Yanille</a> and <i>ring</i> the <a href=\"https://runescape.wiki/w/Bell_(Wizards%27_Guild)\" target=\"_blank\" rel=\"noopener\">bell</a> outside on the eastern side of the guild.",
          "text": "With the hand, head to the Wizards' Guild in Yanille and ring the bell outside on the eastern side of the guild.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "off-to-see-the-wizard:suonll",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Zavistic_Rarve\" target=\"_blank\" rel=\"noopener\">Zavistic Rarve</a>.",
          "text": "Speak to Zavistic Rarve.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I have a rather sandy problem that I'd like to palm off on you"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
