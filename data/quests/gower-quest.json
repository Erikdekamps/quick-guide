      "id": "gower-s-farm",
      "title": "Gower's Farm",
      "anchor": "Gower's_Farm",
      "blocks": [
        {
          "type": "step",
          "id": "gower-s-farm:1opcoje",
          "html": "Speak to the Gowers at their <a href=\"https://runescape.wiki/w/Gower_farm\" target=\"_blank\" rel=\"noopener\">farm</a> next to rats and a cabbage patch south-east of the <a href=\"https://runescape.wiki/w/Varrock_lodestone\" target=\"_blank\" rel=\"noopener\">Varrock lodestone</a>.",
          "text": "Speak to the Gowers at their farm next to rats and a cabbage patch south-east of the Varrock lodestone.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "So about that quest, then?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:1w1zs3r",
          "html": "Search the crate in the room to the west to obtain <a href=\"https://runescape.wiki/w/Pure_essence_(Gower_Quest)\" target=\"_blank\" rel=\"noopener\">pure essence</a>.",
          "text": "Search the crate in the room to the west to obtain pure essence.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:igaqu1",
          "html": "Search the largest <a href=\"https://runescape.wiki/w/Water_barrel_(Gower_Quest)\" target=\"_blank\" rel=\"noopener\">water barrel</a> to the west of the southern entrance to obtain a <a href=\"https://runescape.wiki/w/Brussels_sprout\" target=\"_blank\" rel=\"noopener\">brussels sprout</a>.",
          "text": "Search the largest water barrel to the west of the southern entrance to obtain a brussels sprout.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:m76n7t",
          "html": "Search the <a href=\"https://runescape.wiki/w/Scarecrow_(Gower_Quest)\" target=\"_blank\" rel=\"noopener\">scarecrow</a> in the south-western part of the farm with the cabbages to obtain a <a href=\"https://runescape.wiki/w/Cruciferous_mounting\" target=\"_blank\" rel=\"noopener\">cruciferous mounting</a>.",
          "text": "Search the scarecrow in the south-western part of the farm with the cabbages to obtain a cruciferous mounting.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:1avuuy4",
          "html": "Search the <a href=\"https://runescape.wiki/w/Food_trough_(Gower_Quest)\" target=\"_blank\" rel=\"noopener\">food trough</a> on the east side of the farm in the area with the giant rats to obtain a <a href=\"https://runescape.wiki/w/Broccoli_root\" target=\"_blank\" rel=\"noopener\">broccoli root</a>.",
          "text": "Search the food trough on the east side of the farm in the area with the giant rats to obtain a broccoli root.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:3ls3se",
          "html": "Spin the broccoli root into broccoli string on the <a href=\"https://runescape.wiki/w/Spinning_wheel\" target=\"_blank\" rel=\"noopener\">spinning wheel</a> in the main room.",
          "text": "Spin the broccoli root into broccoli string on the spinning wheel in the main room.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:16ufw17",
          "html": "Use the brussels sprout on the cruciferous mounting to make it into an <a href=\"https://runescape.wiki/w/Brassican_amulet_(unstrung)\" target=\"_blank\" rel=\"noopener\">unstrung brassican amulet</a>.",
          "text": "Use the brussels sprout on the cruciferous mounting to make it into an unstrung brassican amulet.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:vg25dz",
          "html": "Use the &quot;Flip&quot; option on the pure essence to turn it into a <a href=\"https://runescape.wiki/w/Life_rune\" target=\"_blank\" rel=\"noopener\">life rune</a>.",
          "text": "Use the \"Flip\" option on the pure essence to turn it into a life rune.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:hpt59b",
          "html": "Use the broccoli string on the unstrung brassican amulet to create a <a href=\"https://runescape.wiki/w/Brassican_amulet\" target=\"_blank\" rel=\"noopener\">brassican amulet</a>.",
          "text": "Use the broccoli string on the unstrung brassican amulet to create a brassican amulet.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:1juvri6",
          "html": "Use the life rune on the brassican amulet to enchant it into a <a href=\"https://runescape.wiki/w/Cabbagespeak_amulet\" target=\"_blank\" rel=\"noopener\">cabbagespeak amulet</a>.",
          "text": "Use the life rune on the brassican amulet to enchant it into a cabbagespeak amulet.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:1u9ylvs",
          "html": "Equip the amulet and talk to <a href=\"https://runescape.wiki/w/Crispy_the_Cabbage\" target=\"_blank\" rel=\"noopener\">Crispy the Cabbage</a> south-west on the cabbage field.",
          "text": "Equip the amulet and talk to Crispy the Cabbage south-west on the cabbage field.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:1jnd0wu",
          "html": "Talk to the Gower brothers inside of the house.",
          "text": "Talk to the Gower brothers inside of the house.",
          "dialogue": [
            {
              "when": null,
