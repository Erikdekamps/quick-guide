          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:162yp8v",
          "html": "Speak to the Cabbages again.",
          "text": "Speak to the Cabbages again.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "gower-s-farm:1se937w",
          "html": "Speak to Andrew to receive the <a href=\"https://runescape.wiki/w/Disk_of_returning_(Gower_Quest)\" target=\"_blank\" rel=\"noopener\">disk of returning</a>.",
          "text": "Speak to Andrew to receive the disk of returning.",
