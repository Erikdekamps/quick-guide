          "html": "Talk to <a href=\"https://runescape.wiki/w/Aga\" target=\"_blank\" rel=\"noopener\">Aga</a> in the room to the north.",
          "text": "Talk to Aga in the room to the north.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "So... how's your... um... love life?"
                },
                {
                  "key": "1",
                  "text": "Errr... I've got to go."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "hitch:107v9e1",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Arrg\" target=\"_blank\" rel=\"noopener\">Arrg</a> in the same room.",
          "text": "Talk to Arrg in the same room.",
          "dialogue": [
