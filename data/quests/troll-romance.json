          "type": "step",
          "id": "hitch:ietugj",
          "html": "Go to the middle level of the <a href=\"https://runescape.wiki/w/Troll_Stronghold_(area)\" target=\"_blank\" rel=\"noopener\">Troll Stronghold</a>.",
          "text": "Go to the middle level of the Troll Stronghold.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "hitch:ietugj:s2vjhs",
              "html": "Enter the <a href=\"https://runescape.wiki/w/Cave_entrance_(Troll_Country)\" target=\"_blank\" rel=\"noopener\">cave entrance</a> from <a href=\"https://runescape.wiki/w/Trollheim\" target=\"_blank\" rel=\"noopener\">Trollheim</a> and go down one level.",
              "text": "Enter the cave entrance from Trollheim and go down one level.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "hitch:ietugj:ujkkrm",
              "html": "Otherwise, enter the <a href=\"https://runescape.wiki/w/Secret_Entrance_(Troll_Stronghold)\" target=\"_blank\" rel=\"noopener\">secret entrance</a> from the entrance to <a href=\"https://runescape.wiki/w/Fremennik_Slayer_Dungeon\" target=\"_blank\" rel=\"noopener\">Fremennik Slayer Dungeon</a> (fairy ring code <b>A</b><b>J</b><b>R</b>) or <a href=\"https://runescape.wiki/w/Death_Plateau_(location)\" target=\"_blank\" rel=\"noopener\">Death Plateau</a> and go up one level.",
              "text": "Otherwise, enter the secret entrance from the entrance to Fremennik Slayer Dungeon (fairy ring code AJR) or Death Plateau and go up one level.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "hitch:110dqy2",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Ug\" target=\"_blank\" rel=\"noopener\">Ug</a> on the middle level of the Troll Stronghold. Offer him your help.",
          "text": "Talk to Ug on the middle level of the Troll Stronghold. Offer him your help.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Awww, you poor troll. What seems to be the problem?"
                },
                {
                  "key": "3",
                  "text": "Don't worry now. I'll see what I can do."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
