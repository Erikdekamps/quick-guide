      "blocks": [
        {
          "type": "step",
          "id": "finishing-up:vvl8ze",
          "html": "In the outpost, talk to <a href=\"https://runescape.wiki/w/Nulodion\" target=\"_blank\" rel=\"noopener\">Nulodion</a>. He is standing right next to the <a href=\"https://runescape.wiki/w/Dwarf_multicannon\" target=\"_blank\" rel=\"noopener\">Dwarf multicannon</a>, outside of the entrance to the <a href=\"https://runescape.wiki/w/Dwarven_Mine\" target=\"_blank\" rel=\"noopener\">Dwarven Mine</a> north of Falador.",
          "text": "In the outpost, talk to Nulodion. He is standing right next to the Dwarf multicannon, outside of the entrance to the Dwarven Mine north of Falador.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "finishing-up:vvl8ze:1r3k4lx",
              "html": "If you drop the ammo mould he gives you and speak to him again he will give you another. The second ammo mould can be added to your <a href=\"https://runescape.wiki/w/Tool_belt\" target=\"_blank\" rel=\"noopener\">tool belt</a> after the quest (with 35 Smithing) to save having to revisit him.",
              "text": "If you drop the ammo mould he gives you and speak to him again he will give you another. The second ammo mould can be added to your tool belt after the quest (with 35 Smithing) to save having to revisit him.",
