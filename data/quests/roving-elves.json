  "sections": [
    {
      "id": "islwyn-and-eluned",
      "title": "Islwyn and Eluned",
      "anchor": "Islwyn_and_Eluned",
      "blocks": [
        {
          "type": "step",
          "id": "islwyn-and-eluned:1iwo34p",
          "html": "Bank all your combat equipment.",
          "text": "Bank all your combat equipment.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:85i53m",
          "html": "Track down and talk to <a href=\"https://runescape.wiki/w/Islwyn\" target=\"_blank\" rel=\"noopener\">Islwyn</a>.",
          "text": "Track down and talk to Islwyn.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "1",
                  "text": "Tell the truth?"
                },
                {
                  "key": "1",
                  "text": "Maybe I could help."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "islwyn-and-eluned:85i53m:1g7pbrl",
              "html": "Islwyn and Eluned move locations regularly: either south-west of <a href=\"https://runescape.wiki/w/Lletya\" target=\"_blank\" rel=\"noopener\">Lletya</a> or north-east of the <a href=\"https://runescape.wiki/w/Tyras_Camp\" target=\"_blank\" rel=\"noopener\">Tyras Camp</a>. Simply hop worlds until you find them.",
              "text": "Islwyn and Eluned move locations regularly: either south-west of Lletya or north-east of the Tyras Camp. Simply hop worlds until you find them.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:1qocmon",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Eluned\" target=\"_blank\" rel=\"noopener\">Eluned</a>.",
          "text": "Talk to Eluned.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:ub2n4g",
          "html": "<i>Use</i> <a href=\"https://runescape.wiki/w/Glarial%27s_pebble\" target=\"_blank\" rel=\"noopener\">Glarial&#39;s pebble</a> on <a href=\"https://runescape.wiki/w/Glarial%27s_tombstone\" target=\"_blank\" rel=\"noopener\">Glarial&#39;s tombstone</a> north-west of the <a href=\"https://runescape.wiki/w/Fishing_Guild\" target=\"_blank\" rel=\"noopener\">Fishing Guild</a>.",
          "text": "Use Glarial's pebble on Glarial's tombstone north-west of the Fishing Guild.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "islwyn-and-eluned:ub2n4g:vczusp",
              "html": "If you&#39;re holding any combat equipment or logs, you&#39;ll receive the message: <i>It fits perfectly, but nothing happens.</i>",
              "text": "If you're holding any combat equipment or logs, you'll receive the message: It fits perfectly, but nothing happens.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "islwyn-and-eluned:ub2n4g:g4ok0p",
              "html": "If needed, reclaim Glarial&#39;s pebble from <a href=\"https://runescape.wiki/w/Golrie\" target=\"_blank\" rel=\"noopener\">Golrie</a> in <a href=\"https://runescape.wiki/w/Gnome_Village_Dungeon\" target=\"_blank\" rel=\"noopener\">Gnome Village Dungeon</a>.",
              "text": "If needed, reclaim Glarial's pebble from Golrie in Gnome Village Dungeon.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "1",
                      "text": "Yes please!"
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "islwyn-and-eluned:ub2n4g:1kxzj57",
              "html": "You can also reclaim Glarial&#39;s pebble from the <a href=\"https://runescape.wiki/w/Storage_Chest\" target=\"_blank\" rel=\"noopener\">Storage Chest</a> in <a href=\"https://runescape.wiki/w/May%27s_Quest_Caravan\" target=\"_blank\" rel=\"noopener\">May&#39;s Quest Caravan</a>.",
              "text": "You can also reclaim Glarial's pebble from the Storage Chest in May's Quest Caravan.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:1u8jnw5",
          "html": "Kill a <a href=\"https://runescape.wiki/w/Moss_giant_(Glarial%27s_Tomb)\" target=\"_blank\" rel=\"noopener\">moss giant</a> and pick up the <a href=\"https://runescape.wiki/w/Consecration_seed\" target=\"_blank\" rel=\"noopener\">consecration seed</a> it drops.",
          "text": "Kill a moss giant and pick up the consecration seed it drops.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "islwyn-and-eluned:1u8jnw5:1acdirp",
              "html": "You can remove an item from your <a href=\"https://runescape.wiki/w/Tool_belt\" target=\"_blank\" rel=\"noopener\">tool belt</a> to use as a weapon. Legacy combat mode increases auto attack damage. A <a href=\"https://runescape.wiki/w/Ring_of_recoil\" target=\"_blank\" rel=\"noopener\">ring of recoil</a> may be helpful for lower levelled players.",
              "text": "You can remove an item from your tool belt to use as a weapon. Legacy combat mode increases auto attack damage. A ring of recoil may be helpful for lower levelled players.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:1gj3y27",
          "html": "If needed, reclaim <a href=\"https://runescape.wiki/w/Glarial%27s_amulet\" target=\"_blank\" rel=\"noopener\">Glarial&#39;s amulet</a> from the chest to the west.",
          "text": "If needed, reclaim Glarial's amulet from the chest to the west.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:1fdpq5s",
          "html": "Take the seed to Eluned to have her enchant it.",
          "text": "Take the seed to Eluned to have her enchant it.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:1nzmsk9",
          "html": "Travel to the <a href=\"https://runescape.wiki/w/Waterfall_dungeon\" target=\"_blank\" rel=\"noopener\">Waterfall dungeon</a>.",
          "text": "Travel to the Waterfall dungeon.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "islwyn-and-eluned:1nzmsk9:11blokq",
              "html": "Via <a href=\"https://runescape.wiki/w/Hoardstalker_ring\" target=\"_blank\" rel=\"noopener\">hoardstalker ring</a> or <a href=\"https://runescape.wiki/w/Dungeoneering_cape\" target=\"_blank\" rel=\"noopener\">Dungeoneering cape</a> (<a href=\"https://runescape.wiki/w/Baxtorian_Falls_resource_dungeon\" target=\"_blank\" rel=\"noopener\">Baxtorian Falls resource dungeon</a> option, called <i>Waterfall fire giant dungeon</i> in the cape)",
              "text": "Via hoardstalker ring or Dungeoneering cape (Baxtorian Falls resource dungeon option, called Waterfall fire giant dungeon in the cape)",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "islwyn-and-eluned:1nzmsk9:fl2qph",
              "html": "Via <a href=\"https://runescape.wiki/w/Games_necklace\" target=\"_blank\" rel=\"noopener\">games necklace</a>, <a href=\"https://runescape.wiki/w/Barbarian_Outpost\" target=\"_blank\" rel=\"noopener\">Barbarian Outpost</a> then run south to <a href=\"https://runescape.wiki/w/Baxtorian_Falls\" target=\"_blank\" rel=\"noopener\">Baxtorian Falls</a>, then:",
              "text": "Via games necklace, Barbarian Outpost then run south to Baxtorian Falls, then:",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": [
                {
                  "type": "step",
                  "id": "islwyn-and-eluned:1nzmsk9:fl2qph:11r0qht",
                  "html": "<i>Board</i> the <a href=\"https://runescape.wiki/w/Log_raft\" target=\"_blank\" rel=\"noopener\">log raft</a> north of Baxtorian falls",
                  "text": "Board the log raft north of Baxtorian falls",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "islwyn-and-eluned:1nzmsk9:fl2qph:19no5t4",
                  "html": "<i>Use</i> a <a href=\"https://runescape.wiki/w/Rope\" target=\"_blank\" rel=\"noopener\">rope</a> on the rock south across the water",
                  "text": "Use a rope on the rock south across the water",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "islwyn-and-eluned:1nzmsk9:fl2qph:1952hof",
                  "html": "<i>Use</i> a rope on the <a href=\"https://runescape.wiki/w/Dead_tree\" target=\"_blank\" rel=\"noopener\">dead tree</a>",
                  "text": "Use a rope on the dead tree",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "islwyn-and-eluned:1nzmsk9:fl2qph:1qhc3uy",
                  "html": "<i>Enter</i> the door",
                  "text": "Enter the door",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                }
              ]
            }
          ]
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:e5nj4d",
          "html": "If needed, reclaim <a href=\"https://runescape.wiki/w/A_key_(Waterfall_Dungeon)\" target=\"_blank\" rel=\"noopener\">a key</a> from the discoloured crates in the eastern room with skeletons.",
          "text": "If needed, reclaim a key from the discoloured crates in the eastern room with skeletons.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:1ag5aj2",
          "html": "Go inside the north-west room with the statues.",
          "text": "Go inside the north-west room with the statues.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:kfpmd9",
          "html": "<i>Plant</i> the <a href=\"https://runescape.wiki/w/Consecration_seed_(enchanted)\" target=\"_blank\" rel=\"noopener\">enchanted consecration seed</a> anywhere inside.",
          "text": "Plant the enchanted consecration seed anywhere inside.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:1kzgaeg",
          "html": "Return to Islwyn to choose your reward.",
          "text": "Return to Islwyn to choose your reward.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "~",
                  "text": "[Any option]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "islwyn-and-eluned:fvxipr",
          "html": "Quest complete!",
          "text": "Quest complete!",
          "dialogue": [],
          "images": [],
