  "sections": [
    {
      "id": "rescuing-wayward-souls",
      "title": "Rescuing Wayward Souls",
      "anchor": "Rescuing_Wayward_Souls",
      "blocks": [
        {
          "type": "step",
          "id": "rescuing-wayward-souls:1k2ezm1",
          "html": "Interact with <a href=\"https://runescape.wiki/w/Kharen\" target=\"_blank\" rel=\"noopener\">Kharen</a> on the docks in the north-western <a href=\"https://runescape.wiki/w/City_of_Um\" target=\"_blank\" rel=\"noopener\">City of Um</a>, close to the transportation icon.",
          "text": "Interact with Kharen on the docks in the north-western City of Um, close to the transportation icon.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "rescuing-wayward-souls:tcrlsa",
          "html": "Either:",
          "text": "Either:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "rescuing-wayward-souls:tcrlsa:1eyto6t",
              "html": "Speak to <a href=\"https://runescape.wiki/w/Ed\" target=\"_blank\" rel=\"noopener\">Ed</a> in a building to the north-east to rent a boat.",
              "text": "Speak to Ed in a building to the north-east to rent a boat.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "1",
                      "text": "Take a boat out onto the lake."
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "rescuing-wayward-souls:tcrlsa:1mu0ltw",
              "html": "Or choose the option <i>Rent boat</i> on Ed.",
              "text": "Or choose the option Rent boat on Ed.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "rescuing-wayward-souls:is3tsk",
          "html": "<i>Rescue</i> four <a href=\"https://runescape.wiki/w/Wayward_Soul_(City_of_Um)\" target=\"_blank\" rel=\"noopener\">Wayward Souls</a>. They are ghastly sphere shapes floating above the <a href=\"https://runescape.wiki/w/Lake_Mnemosyne\" target=\"_blank\" rel=\"noopener\">Lake Mnemosyne</a> in each of the four corners of the map. Some may be a good distance away from the coastline.",
          "text": "Rescue four Wayward Souls. They are ghastly sphere shapes floating above the Lake Mnemosyne in each of the four corners of the map. Some may be a good distance away from the coastline.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "rescuing-wayward-souls:is3tsk:13isrrp",
              "html": "<a href=\"https://runescape.wiki/w/High_contrast\" target=\"_blank\" rel=\"noopener\">High contrast</a> mode is beneficial for spotting them.",
              "text": "High contrast mode is beneficial for spotting them.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "rescuing-wayward-souls:is3tsk:1csoozx",
              "html": "<a href=\"https://runescape.wiki/w/Dive\" target=\"_blank\" rel=\"noopener\">Dive</a> and <a href=\"https://runescape.wiki/w/Surge\" target=\"_blank\" rel=\"noopener\">Surge</a> can be used to speed up movement. The <a href=\"https://runescape.wiki/w/Mobile\" target=\"_blank\" rel=\"noopener\">Mobile</a> perk (must be on an armour piece, as both hands must be free) and using a <a href=\"https://runescape.wiki/w/Powerburst_of_acceleration\" target=\"_blank\" rel=\"noopener\">powerburst of acceleration</a> will also help.",
              "text": "Dive and Surge can be used to speed up movement. The Mobile perk (must be on an armour piece, as both hands must be free) and using a powerburst of acceleration will also help.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "rescuing-wayward-souls:is3tsk:8hphwa",
              "html": "(Optional) Talk to <a href=\"https://runescape.wiki/w/Deano\" target=\"_blank\" rel=\"noopener\">Deano</a> and <a href=\"https://runescape.wiki/w/Sammy\" target=\"_blank\" rel=\"noopener\">Sammy</a> when you see them for a reward of 25 <a href=\"https://runescape.wiki/w/Soul_(Well_of_Souls)\" target=\"_blank\" rel=\"noopener\">souls</a> each.",
              "text": "(Optional) Talk to Deano and Sammy when you see them for a reward of 25 souls each.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "rescuing-wayward-souls:z6jty",
          "html": "Return back to the docks and disembark in the <a href=\"https://runescape.wiki/w/Dock\" target=\"_blank\" rel=\"noopener\">dock</a> south of Kharen. (Or teleport out of the rowboat.)",
          "text": "Return back to the docks and disembark in the dock south of Kharen. (Or teleport out of the rowboat.)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
