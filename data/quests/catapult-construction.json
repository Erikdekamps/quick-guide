        {
          "type": "step",
          "id": "fetching-the-materials:1uvox8",
          "html": "North of the <a href=\"https://runescape.wiki/w/Tyras_camp\" target=\"_blank\" rel=\"noopener\">Tyras camp</a>, talk to the guard next to the catapult.",
          "text": "North of the Tyras camp, talk to the guard next to the catapult.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "1",
                  "text": "I guess you're going to get fired, then."
                },
                {
                  "key": "1",
                  "text": "What do you suggest?"
                },
                {
                  "key": "1",
                  "text": "Alright, I'll go and speak to General Hining."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "fetching-the-materials:2hv90u",
          "html": "Talk to <a href=\"https://runescape.wiki/w/General_Hining\" target=\"_blank\" rel=\"noopener\">General Hining</a> in Tyras Camp.",
          "text": "Talk to General Hining in Tyras Camp.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "So, the Tyras Camp catapult is broken?"
                },
                {
                  "key": "1",
                  "text": "Perhaps I can help to repair it?"
                },
                {
                  "key": "2",
                  "text": "General, I believe I can be of service to you."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "fetching-the-materials:10tnyn2",
          "html": "Teleport to the Tirannwn lodestone, then take the north-western path, cross the leaves trap, and then the sticks trap (south west of the log crossing shortcut) to find the <a href=\"https://runescape.wiki/w/Catapult_engineer\" target=\"_blank\" rel=\"noopener\">Catapult engineer</a>.",
          "text": "Teleport to the Tirannwn lodestone, then take the north-western path, cross the leaves trap, and then the sticks trap (south west of the log crossing shortcut) to find the Catapult engineer.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "fetching-the-materials:1yk6jk5",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Catapult_engineer\" target=\"_blank\" rel=\"noopener\">Catapult engineer</a> for schematics.",
          "text": "Talk to the Catapult engineer for schematics.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "General Hining asked me to find you."
                },
                {
                  "key": "2",
                  "text": "I'm quite an experienced carpenter."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "fetching-the-materials:1lh1yz6",
