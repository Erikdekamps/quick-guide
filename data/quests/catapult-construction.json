        {
          "type": "step",
          "id": "fetching-the-materials:7cex8k",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Rolad\" target=\"_blank\" rel=\"noopener\">Rolad</a> at the <a href=\"https://runescape.wiki/w/Dwarven_Mine\" target=\"_blank\" rel=\"noopener\">Dwarven Mine</a> camp, south of <a href=\"https://runescape.wiki/w/Ice_Mountain\" target=\"_blank\" rel=\"noopener\">Ice Mountain</a>. (North-east of Falador lodestone)",
          "text": "Talk to Rolad at the Dwarven Mine camp, south of Ice Mountain. (North-east of Falador lodestone)",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Can I have the metal parts for the Tyras Camp catapult please?"
