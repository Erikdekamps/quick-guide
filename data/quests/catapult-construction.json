        {
          "type": "step",
          "id": "fetching-the-materials:g574t",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Thaki\" target=\"_blank\" rel=\"noopener\">Thaki</a> inside <a href=\"https://runescape.wiki/w/The_Rusty_Anchor\" target=\"_blank\" rel=\"noopener\">Port Sarim&#39;s pub</a>.",
          "text": "Talk to Thaki inside Port Sarim's pub.",
          "dialogue": [
            {
              "when": null,
