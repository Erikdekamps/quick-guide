        {
          "type": "step",
          "id": "walkthrough:1h3f6pe",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Kangai_Mau\" target=\"_blank\" rel=\"noopener\">Kangai Mau</a> in the large building north of <a href=\"https://runescape.wiki/w/Brimhaven\" target=\"_blank\" rel=\"noopener\">Brimhaven</a>&#39;s pub.",
          "text": "Talk to Kangai Mau in the large building north of Brimhaven's pub.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I'm in search of adventure!"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "walkthrough:1w1be7p",
          "html": "Travel to <a href=\"https://runescape.wiki/w/Ardougne\" target=\"_blank\" rel=\"noopener\">Ardougne</a> (you can take a ship from Brimhaven to complete <a href=\"https://runescape.wiki/w/Avast_Ardougne!\" target=\"_blank\" rel=\"noopener\">Avast Ardougne!</a>, an <a href=\"https://runescape.wiki/w/Easy_Karamja_achievements\" target=\"_blank\" rel=\"noopener\">easy Karamja achievement</a>), and head to the <a href=\"https://runescape.wiki/w/RuneScape_Parcel_Delivery_Team\" target=\"_blank\" rel=\"noopener\">RPDT</a> depot just south of the eastern bank.",
          "text": "Travel to Ardougne (you can take a ship from Brimhaven to complete Avast Ardougne!, an easy Karamja achievement), and head to the RPDT depot just south of the eastern bank.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "walkthrough:13jki3y",
          "html": "<i>Investigate</i> the crate directly north-east of the sacks for the <a href=\"https://runescape.wiki/w/Address_label\" target=\"_blank\" rel=\"noopener\">address label</a>.",
          "text": "Investigate the crate directly north-east of the sacks for the address label.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "walkthrough:a25nc",
          "html": "<i>Use</i> the address label on the stack of two crates directly north of the crate you just investigated.",
          "text": "Use the address label on the stack of two crates directly north of the crate you just investigated.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "walkthrough:4l9psw",
          "html": "Talk to an <a href=\"https://runescape.wiki/w/RPDT_employee\" target=\"_blank\" rel=\"noopener\">RPDT employee</a> and ask when the crate will be delivered.",
          "text": "Talk to an RPDT employee and ask when the crate will be delivered.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "So, when are you going to deliver this crate?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "walkthrough:6b5uob",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Wizard_Cromperty\" target=\"_blank\" rel=\"noopener\">Wizard Cromperty</a> in the house north-east of the Ardougne market (the one with the blue checkered floor).",
          "text": "Talk to Wizard Cromperty in the house north-east of the Ardougne market (the one with the blue checkered floor).",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "So what have you invented?"
                },
                {
                  "key": "2",
                  "text": "Can I be teleported please?"
                },
                {
                  "key": "1",
                  "text": "Yes, that sounds good. Teleport me!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "walkthrough:l7xgo5",
          "html": "Once inside the mansion, open the western door, using the code &quot;KURT&quot; to get in.",
          "text": "Once inside the mansion, open the western door, using the code \"KURT\" to get in.",
          "dialogue": [],
