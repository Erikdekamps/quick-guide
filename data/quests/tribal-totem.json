        {
          "type": "step",
          "id": "walkthrough:1io5day",
          "html": "Right-click <i>Investigate</i> the stairs, then <i>Climb-up</i> them.",
          "text": "Right-click Investigate the stairs, then Climb-up them.",
          "dialogue": [],
          "images": [],
