    {
      "id": "new-trade-deal",
      "title": "New trade deal",
      "anchor": "New_trade_deal",
      "blocks": [
        {
          "type": "step",
          "id": "new-trade-deal:hqo47y",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Emir_Ali_Mirza\" target=\"_blank\" rel=\"noopener\">Emir Ali Mirza</a> in <a href=\"https://runescape.wiki/w/Al_Kharid_palace\" target=\"_blank\" rel=\"noopener\">Al Kharid palace</a> to begin the quest.",
          "text": "Talk to Emir Ali Mirza in Al Kharid palace to begin the quest.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Talk about Jack of Spades."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "new-trade-deal:upj81t",
          "html": "Go upstairs. Talk to <a href=\"https://runescape.wiki/w/Osman\" target=\"_blank\" rel=\"noopener\">Osman</a>.",
          "text": "Go upstairs. Talk to Osman.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "5",
                  "text": "No more questions."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "new-trade-deal:12qww9v",
          "html": "From the same floor, climb the central north or northwest staircase to the roof and talk to <a href=\"https://runescape.wiki/w/Grand_Vizier_Hassan\" target=\"_blank\" rel=\"noopener\">Grand Vizier Hassan</a>. The steps are built into the wall and may be difficult to notice at a glance. Look south west of the fountain.",
          "text": "From the same floor, climb the central north or northwest staircase to the roof and talk to Grand Vizier Hassan. The steps are built into the wall and may be difficult to notice at a glance. Look south west of the fountain.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I know all I need - let's go!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "new-trade-deal:1uyxgt1",
          "html": "Dismiss any follower and unequip the item in your main and off-hand slots. Talk to <a href=\"https://runescape.wiki/w/Grand_Vizier_Hassan\" target=\"_blank\" rel=\"noopener\">Grand Vizier Hassan</a>.",
          "text": "Dismiss any follower and unequip the item in your main and off-hand slots. Talk to Grand Vizier Hassan.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes, let's go!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "new-trade-deal:1q7v65u",
          "html": "Talk to Hassan while on the carpet to teleport to <a href=\"https://runescape.wiki/w/Menaphos\" target=\"_blank\" rel=\"noopener\">Menaphos</a>.",
          "text": "Talk to Hassan while on the carpet to teleport to Menaphos.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
