    {
      "id": "the-streets-of-menaphos",
      "title": "The streets of Menaphos",
      "anchor": "The_streets_of_Menaphos",
      "blocks": [
        {
          "type": "step",
          "id": "the-streets-of-menaphos:vq7a6o",
          "html": "Talk to Hassan. Make sure you finish all dialogue. There are (brief) pauses between dialogue after talking to each person below.",
          "text": "Talk to Hassan. Make sure you finish all dialogue. There are (brief) pauses between dialogue after talking to each person below.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Talk about Jack of Spades."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-streets-of-menaphos:1g8cx8o",
          "html": "Head north east to the <a href=\"https://runescape.wiki/w/Shifting_tombs_(scenery)\" target=\"_blank\" rel=\"noopener\">shifting tombs entrance</a> in the centre of the market square.",
          "text": "Head north east to the shifting tombs entrance in the centre of the market square.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-streets-of-menaphos:1ive3k3",
          "html": "Choose the <i>Travel Ports District</i> option on the tombs to go to the <a href=\"https://runescape.wiki/w/Menaphos_Port_district\" target=\"_blank\" rel=\"noopener\">Port district</a>.",
          "text": "Choose the Travel Ports District option on the tombs to go to the Port district.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-streets-of-menaphos:fxy1db",
          "html": "Talk to <a href=\"https://runescape.wiki/w/%27Admiral%27_Wadud_(Ports)\" target=\"_blank\" rel=\"noopener\">&#39;Admiral&#39; Wadud (Ports)</a> in <a href=\"https://runescape.wiki/w/The_Golden_Scarab_Inn\" target=\"_blank\" rel=\"noopener\">The Golden Scarab Inn</a> just north.",
          "text": "Talk to 'Admiral' Wadud (Ports) in The Golden Scarab Inn just north.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-streets-of-menaphos:1jmfs6z",
          "html": "Choose the <i>Travel Imperial District</i> option on the tombs to the <a href=\"https://runescape.wiki/w/Menaphos_Imperial_district\" target=\"_blank\" rel=\"noopener\">Imperial district</a>. (This is a good time to activate the Menaphos Lodestone just East of you.)",
          "text": "Choose the Travel Imperial District option on the tombs to the Imperial district. (This is a good time to activate the Menaphos Lodestone just East of you.)",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-streets-of-menaphos:1yimz9f",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Commander_Akhomet_(Imperial)\" target=\"_blank\" rel=\"noopener\">Commander Akhomet (Imperial)</a> in front of the entrance to the Great Pyramid just west. Make sure you finish the dialogue, as there is a pause as the Jack of Spades appears.",
          "text": "Speak to Commander Akhomet (Imperial) in front of the entrance to the Great Pyramid just west. Make sure you finish the dialogue, as there is a pause as the Jack of Spades appears.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-streets-of-menaphos:6chtoz",
          "html": "Choose the <i>Travel Worker District</i> option on the tombs to the <a href=\"https://runescape.wiki/w/Menaphos_Worker_district\" target=\"_blank\" rel=\"noopener\">Worker district</a>.",
          "text": "Choose the Travel Worker District option on the tombs to the Worker district.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-streets-of-menaphos:1l2zqcx",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Batal_(Worker)\" target=\"_blank\" rel=\"noopener\">Batal (Worker)</a> next to the fire pit. Make sure you finish the dialogue, as there is a pause as the Jack of Spades appears.",
          "text": "Talk to Batal (Worker) next to the fire pit. Make sure you finish the dialogue, as there is a pause as the Jack of Spades appears.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "text",
          "html": "&#39;Admiral&#39; Wadud"
        },
        {
          "type": "text",
          "html": "Grand Vizier Ehsan"
        },
        {
          "type": "text",
          "html": "Commander Akhomet"
        },
        {
          "type": "text",
          "html": "Batal"
        }
      ]
    },
