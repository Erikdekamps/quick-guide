        {
          "type": "step",
          "id": "shifty:jwx68f",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Ozan#Jack_of_Spades\" target=\"_blank\" rel=\"noopener\">Jack of Spades</a>.",
          "text": "Talk to the Jack of Spades.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Why steal from people?"
                },
                {
                  "key": "4",
                  "text": "I've heard enough."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "shifty:3w44xs",
          "html": "<i>Exit</i> the shifting tombs to any district.",
          "text": "Exit the shifting tombs to any district.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "shifty:1ftgys7",
          "html": "Referencing above locations, return the four stolen items to their respective districts. It is recommended to do the Merchant district last as Hassan is there.",
          "text": "Referencing above locations, return the four stolen items to their respective districts. It is recommended to do the Merchant district last as Hassan is there.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "shifty:10j58py",
          "html": "Return to Hassan in the Merchant district.",
          "text": "Return to Hassan in the Merchant district.",
          "dialogue": [
            {
              "when": null,
