    {
      "id": "approaching-vorkath",
      "title": "Approaching Vorkath",
      "anchor": "Approaching_Vorkath",
      "blocks": [
        {
          "type": "bring",
          "needed": [
            {
              "id": "approaching-vorkath:bring:1nxwbsz",
              "html": "5 free <a href=\"https://runescape.wiki/w/Backpack\" target=\"_blank\" rel=\"noopener\">backpack</a> spaces",
              "text": "5 free backpack spaces"
            }
          ],
          "recommended": [
            {
              "id": "approaching-vorkath:bring:h1ghod",
              "html": "<a href=\"https://runescape.wiki/w/Combat\" target=\"_blank\" rel=\"noopener\">Combat</a> equipment",
              "text": "Combat equipment"
            }
          ]
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1lnjh8p",
          "html": "Head east to the <a href=\"https://runescape.wiki/w/Rowboat_(Fort_Forinthry)\" target=\"_blank\" rel=\"noopener\">rowboat</a> docked next to the <a href=\"https://runescape.wiki/w/Grove\" target=\"_blank\" rel=\"noopener\">Grove</a> cabin.",
          "text": "Head east to the rowboat docked next to the Grove cabin.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1qlqxc",
          "html": "Interact with the rowboat to travel to <a href=\"https://runescape.wiki/w/Ungael\" target=\"_blank\" rel=\"noopener\">Ungael</a>.",
          "text": "Interact with the rowboat to travel to Ungael.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "approaching-vorkath:1qlqxc:1630hnd",
              "html": "You will spawn next to hostile <a href=\"https://runescape.wiki/w/Zamorakian_scout\" target=\"_blank\" rel=\"noopener\">Zamorakian scouts</a>; praying against <a href=\"https://runescape.wiki/w/Ranged\" target=\"_blank\" rel=\"noopener\">Ranged</a> can be helpful. This is a safe encounter, and you will respawn outside of the rowboat upon death.",
              "text": "You will spawn next to hostile Zamorakian scouts; praying against Ranged can be helpful. This is a safe encounter, and you will respawn outside of the rowboat upon death.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "approaching-vorkath:o09802",
          "html": "Run north-west past the scouts and enter the <a href=\"https://runescape.wiki/w/Colossal_cave\" target=\"_blank\" rel=\"noopener\">colossal cave</a>.",
          "text": "Run north-west past the scouts and enter the colossal cave.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:ke8l0y",
          "html": "Head north-west and approach <a href=\"https://runescape.wiki/w/Vorkath\" target=\"_blank\" rel=\"noopener\">Vorkath</a>.",
          "text": "Head north-west and approach Vorkath.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Reach out your hand. (friendly)"
                },
                {
                  "key": "2",
                  "text": "Keep your hand extended. (friendly)"
                },
                {
                  "key": "2",
                  "text": "Encourage Vorkath. (friendly)"
                },
                {
                  "key": "2",
                  "text": "Try not to shiver. (friendly)"
                },
                {
                  "key": "1",
                  "text": "Study the creature. (neutral)"
                },
                {
                  "key": "2",
                  "text": "Lay the dragon's soul to rest. (Necromancy)"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1tqqvle",
          "html": "Inspect the <a href=\"https://runescape.wiki/w/Crystal_shard\" target=\"_blank\" rel=\"noopener\">crystal shard</a> in the backpack.",
          "text": "Inspect the crystal shard in the backpack.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:4hdsse",
          "html": "Return to the Ungael beach, this time travel up the north-east path, up the hill and interact with the <a href=\"https://runescape.wiki/w/Ruins_Entrance\" target=\"_blank\" rel=\"noopener\">Ruins Entrance</a> to enter.",
          "text": "Return to the Ungael beach, this time travel up the north-east path, up the hill and interact with the Ruins Entrance to enter.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:gt9jjg",
          "html": "Head north, just in front of the <a href=\"https://runescape.wiki/w/Imposing_Statue\" target=\"_blank\" rel=\"noopener\">Imposing Statue</a>, and interact with the <a href=\"https://runescape.wiki/w/Doorway_(Ungael)\" target=\"_blank\" rel=\"noopener\">doorway</a> to the south.",
          "text": "Head north, just in front of the Imposing Statue, and interact with the doorway to the south.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1fie6eb",
          "html": "Follow the path south-west and kill the <a href=\"https://runescape.wiki/w/Translator\" target=\"_blank\" rel=\"noopener\">translator</a>.",
          "text": "Follow the path south-west and kill the translator.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1y7i8vn",
          "html": "Pick up the dropped <a href=\"https://runescape.wiki/w/Zamorakian_translator%27s_notes\" target=\"_blank\" rel=\"noopener\">Zamorakian translator&#39;s notes</a> and read them.",
          "text": "Pick up the dropped Zamorakian translator's notes and read them.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1s5f4yw",
          "html": "Search the <a href=\"https://runescape.wiki/w/Bookcase_(Ungael)\" target=\"_blank\" rel=\"noopener\">bookcase</a> on the northern wall for <a href=\"https://runescape.wiki/w/Zorgoth%27s_Journal\" target=\"_blank\" rel=\"noopener\">Zorgoth&#39;s Journal</a>.",
          "text": "Search the bookcase on the northern wall for Zorgoth's Journal.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:wmgvqx",
          "html": "Search the <a href=\"https://runescape.wiki/w/Shelves_(Requiem_for_a_Dragon)\" target=\"_blank\" rel=\"noopener\">shelves</a> immediately southeast for a <a href=\"https://runescape.wiki/w/Broken_focus\" target=\"_blank\" rel=\"noopener\">broken focus</a>.",
          "text": "Search the shelves immediately southeast for a broken focus.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1yn7bw",
          "html": "Inspect the <a href=\"https://runescape.wiki/w/Dragonkin_mural_(Requiem_for_a_Dragon)\" target=\"_blank\" rel=\"noopener\">dragonkin mural</a> on the western wall.",
          "text": "Inspect the dragonkin mural on the western wall.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1bpcdzy",
          "html": "Pick up the <a href=\"https://runescape.wiki/w/Congealed_potion\" target=\"_blank\" rel=\"noopener\">congealed potion</a> in the south-eastern corner.",
          "text": "Pick up the congealed potion in the south-eastern corner.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "approaching-vorkath:1in34wv",
          "html": "Listen to the <a href=\"https://runescape.wiki/w/Archivist_(Ungael)\" target=\"_blank\" rel=\"noopener\">Archivist</a> about all findings.",
          "text": "Listen to the Archivist about all findings.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "The wall mural."
                },
                {
                  "key": "2",
                  "text": "The congealed potion."
                },
                {
                  "key": "3",
                  "text": "The broken focus."
                },
                {
                  "key": "4",
                  "text": "The crystal shard."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
