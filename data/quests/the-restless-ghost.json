  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:18vq4i2",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Father_Aereck\" target=\"_blank\" rel=\"noopener\">Father Aereck</a> in <a href=\"https://runescape.wiki/w/Lumbridge_Church\" target=\"_blank\" rel=\"noopener\">Lumbridge Church</a>.",
          "text": "Talk to Father Aereck in Lumbridge Church.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I'm looking for a quest!"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:z5y1uj",
          "html": "Go through the graveyard&#39;s southern exit and follow the shore to a mining site. Head west to a hut in the swamp.",
          "text": "Go through the graveyard's southern exit and follow the shore to a mining site. Head west to a hut in the swamp.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "ghostspeak-amulet",
      "title": "Ghostspeak amulet",
      "anchor": "Ghostspeak_amulet",
      "blocks": [
        {
          "type": "step",
          "id": "ghostspeak-amulet:1r0oq35",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Father_Urhney\" target=\"_blank\" rel=\"noopener\">Father Urhney</a> inside the hut.",
          "text": "Talk to Father Urhney inside the hut.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Father Aereck sent me to talk to you."
                },
                {
                  "key": "1",
                  "text": "A ghost is haunting his graveyard."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghostspeak-amulet:m545xi",
          "html": "Go back to the graveyard and open a coffin located south of the catacombs.",
          "text": "Go back to the graveyard and open a coffin located south of the catacombs.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "ghostspeak-amulet:1f135np",
          "html": "Equip the <a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">Ghostspeak amulet</a> and talk to the ghost.",
          "text": "Equip the Ghostspeak amulet and talk to the ghost.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yep. Now, tell me what the problem is."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "the-skull",
      "title": "The skull",
      "anchor": "The_skull",
      "blocks": [
        {
          "type": "step",
          "id": "the-skull:1j87fdp",
          "html": "Head back through the southern gate of the graveyard, keep walking until you reach the mining site once again.",
          "text": "Head back through the southern gate of the graveyard, keep walking until you reach the mining site once again.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-skull:1ss69fs",
          "html": "Look south-east of the mining site, there are some <a href=\"https://runescape.wiki/w/Rocks_(The_Restless_Ghost)\" target=\"_blank\" rel=\"noopener\">rocks</a>. Search the rocks, you will receive a muddy skull.",
          "text": "Look south-east of the mining site, there are some rocks. Search the rocks, you will receive a muddy skull.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-skull:5m25nj",
          "html": "Kill the skeleton <i>or</i> run away.",
          "text": "Kill the skeleton or run away.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-skull:4wugm7",
          "html": "Go back to the graveyard, reopen the coffin and use the skull on the open coffin.",
          "text": "Go back to the graveyard, reopen the coffin and use the skull on the open coffin.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Put the skull in the coffin."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-skull:1iflc2b",
          "html": "Quest completed!",
          "text": "Quest completed!",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    }
