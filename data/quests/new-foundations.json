    {
      "id": "recruiting-help",
      "title": "Recruiting help",
      "anchor": "Recruiting_help",
      "blocks": [
        {
          "type": "step",
          "id": "recruiting-help:ygz90c",
          "html": "Head to the <a href=\"https://runescape.wiki/w/Blue_Moon_Inn\" target=\"_blank\" rel=\"noopener\">Blue Moon Inn</a> in <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a> and talk to <a href=\"https://runescape.wiki/w/Aster\" target=\"_blank\" rel=\"noopener\">Aster</a> (outside by the tables).",
          "text": "Head to the Blue Moon Inn in Varrock and talk to Aster (outside by the tables).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "recruiting-help:1rssvv6",
          "html": "Head to <a href=\"https://runescape.wiki/w/Barbarian_Village\" target=\"_blank\" rel=\"noopener\">Gunnarsgrunn</a> (Barbarian Village) and talk to <a href=\"https://runescape.wiki/w/Overseer_Siv\" target=\"_blank\" rel=\"noopener\">Overseer Siv</a> (centre of the village).",
          "text": "Head to Gunnarsgrunn (Barbarian Village) and talk to Overseer Siv (centre of the village).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "recruiting-help:1anxxtc",
          "html": "Head to <a href=\"https://runescape.wiki/w/Draynor_Village\" target=\"_blank\" rel=\"noopener\">Draynor Village</a> and speak to <a href=\"https://runescape.wiki/w/Father_Flint\" target=\"_blank\" rel=\"noopener\">Father Flint</a> in the <a href=\"https://runescape.wiki/w/Draynor_Village\" target=\"_blank\" rel=\"noopener\">Draynor Village</a> marketplace.",
          "text": "Head to Draynor Village and speak to Father Flint in the Draynor Village marketplace.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "recruiting-help:ggyvjy",
          "html": "Head back to the fort and speak to Bill.",
          "text": "Head back to the fort and speak to Bill.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
