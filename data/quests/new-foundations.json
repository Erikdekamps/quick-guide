    {
      "id": "saving-bill-the-architect",
      "title": "Saving Bill the architect",
      "anchor": "Saving_Bill_the_architect",
      "blocks": [
        {
          "type": "bring",
          "needed": [],
          "recommended": [
            {
              "id": "saving-bill-the-architect:bring:7cbiov",
              "html": "Combat gear and food",
              "text": "Combat gear and food"
            }
          ]
        },
        {
          "type": "step",
          "id": "saving-bill-the-architect:9b8qlw",
          "html": "Travel north-east from <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>, near <a href=\"https://runescape.wiki/w/Jolly_Boar_Inn\" target=\"_blank\" rel=\"noopener\">Jolly Boar Inn</a> and the easternmost boundary of the <a href=\"https://runescape.wiki/w/Wilderness_wall\" target=\"_blank\" rel=\"noopener\">Wilderness wall</a>.",
          "text": "Travel north-east from Varrock, near Jolly Boar Inn and the easternmost boundary of the Wilderness wall.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "saving-bill-the-architect:9b8qlw:1m0biww",
              "html": "Fastest way to get there is by teleporting to the <a href=\"https://runescape.wiki/w/Infernal_Source_Dig_Site\" target=\"_blank\" rel=\"noopener\">Infernal Source Dig Site</a> and run slightly north-east (need level 20 Archaeology).",
              "text": "Fastest way to get there is by teleporting to the Infernal Source Dig Site and run slightly north-east (need level 20 Archaeology).",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "saving-bill-the-architect:9b8qlw:u703to",
              "html": "Alternatively, just use <a href=\"https://runescape.wiki/w/Archaeology_journal\" target=\"_blank\" rel=\"noopener\">Archaeology journal</a> and then head north.",
              "text": "Alternatively, just use Archaeology journal and then head north.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "saving-bill-the-architect:1rld8l8",
          "html": "Click the <a href=\"https://runescape.wiki/w/New_Foundations_(portal)\" target=\"_blank\" rel=\"noopener\">portal</a> to &quot;Continue New Foundations&quot;.",
          "text": "Click the portal to \"Continue New Foundations\".",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "saving-bill-the-architect:1aivprl",
          "html": "Defeat the <a href=\"https://runescape.wiki/w/Armoured_zombie\" target=\"_blank\" rel=\"noopener\">armoured zombies</a>.",
          "text": "Defeat the armoured zombies.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "saving-bill-the-architect:m2g6k3",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Bill\" target=\"_blank\" rel=\"noopener\">Bill</a> towards the north of the <a href=\"https://runescape.wiki/w/Well_(Fort_Forinthry)\" target=\"_blank\" rel=\"noopener\">well</a>.",
          "text": "Talk to Bill towards the north of the well.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "saving-bill-the-architect:wt044e",
          "html": "When the chat has ended, go southwest to the <a href=\"https://runescape.wiki/w/Fort_Forinthry_blueprints\" target=\"_blank\" rel=\"noopener\">Fort Forinthry blueprints</a> (table behind the <a href=\"https://runescape.wiki/w/Bank_chest\" target=\"_blank\" rel=\"noopener\">bank chest</a>) to build the <a href=\"https://runescape.wiki/w/Workshop_(Fort_Forinthry)\" target=\"_blank\" rel=\"noopener\">Workshop</a>.",
          "text": "When the chat has ended, go southwest to the Fort Forinthry blueprints (table behind the bank chest) to build the Workshop.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
