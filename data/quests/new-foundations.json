        {
          "type": "step",
          "id": "the-beginning:h7sjcc",
          "html": "Enter the <a href=\"https://runescape.wiki/w/New_Foundations_(portal)\" target=\"_blank\" rel=\"noopener\">New Foundations portal</a> outside <a href=\"https://runescape.wiki/w/King_Roald\" target=\"_blank\" rel=\"noopener\">King Roald</a>&#39;s throne room in <a href=\"https://runescape.wiki/w/Varrock_Palace\" target=\"_blank\" rel=\"noopener\">Varrock Palace</a>.",
          "text": "Enter the New Foundations portal outside King Roald's throne room in Varrock Palace.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-beginning:ta4yz6",
          "html": "After the conversation has ended, enter through the door and talk to King Roald.",
          "text": "After the conversation has ended, enter through the door and talk to King Roald.",
          "dialogue": [
            {
              "when": null,
              "options": [
