            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:1ykaobl",
          "html": "Follow the alley to the west and enter the building.",
          "text": "Follow the alley to the west and enter the building.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
