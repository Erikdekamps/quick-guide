        {
          "type": "step",
          "id": "the-gangs:urk9l4",
          "html": "Talk to Reldo and ask about the <a href=\"https://runescape.wiki/w/Phoenix_Gang\" target=\"_blank\" rel=\"noopener\">Phoenix Gang</a>.",
          "text": "Talk to Reldo and ask about the Phoenix Gang.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Do you know where I can find the Phoenix Gang?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:17hpm59",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Baraek\" target=\"_blank\" rel=\"noopener\">Baraek</a> who is located in the north-east of Varrock square, and give him 10 <a href=\"https://runescape.wiki/w/Coins\" target=\"_blank\" rel=\"noopener\">coins</a>. Ask him every question available.",
          "text": "Talk to Baraek who is located in the north-east of Varrock square, and give him 10 coins. Ask him every question available.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Can you tell me where I can find the Phoenix Gang?"
                },
                {
                  "key": "1",
                  "text": "Alright. Have 10 gold coins."
                },
                {
                  "key": "2",
                  "text": "Thanks!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:hg67a2",
          "html": "Travel to the <a href=\"https://runescape.wiki/w/Phoenix_Gang_Hideout\" target=\"_blank\" rel=\"noopener\">Phoenix Gang Hideout</a> which is located south of <a href=\"https://runescape.wiki/w/Aubury%27s_Rune_Shop\" target=\"_blank\" rel=\"noopener\">Aubury&#39;s Rune Shop</a>. It will be marked by a dungeon link to the Misthalin Underground on the map.",
          "text": "Travel to the Phoenix Gang Hideout which is located south of Aubury's Rune Shop. It will be marked by a dungeon link to the Misthalin Underground on the map.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:18gnyin",
          "html": "Climb down the ladder.",
          "text": "Climb down the ladder.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:1ahjllc",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Straven\" target=\"_blank\" rel=\"noopener\">Straven</a> and ask to join. Tell him you know who he is.",
          "text": "Talk to Straven and ask to join. Tell him you know who he is.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I know who you are!"
                },
                {
                  "key": "1",
                  "text": "I'd like to offer you my services."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:qh46o0",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Blue_Moon_Inn\" target=\"_blank\" rel=\"noopener\">Blue Moon Inn</a> which is just north of <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>&#39;s southern entrance.",
          "text": "Go to the Blue Moon Inn which is just north of Varrock's southern entrance.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:1tldqn4",
          "html": "Kill <a href=\"https://runescape.wiki/w/Jonny_the_beard\" target=\"_blank\" rel=\"noopener\">Jonny the beard</a>.",
          "text": "Kill Jonny the beard.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:77h96q",
          "html": "Grab the <a href=\"https://runescape.wiki/w/Intel_report\" target=\"_blank\" rel=\"noopener\">Intel report</a> that he drops.",
          "text": "Grab the Intel report that he drops.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:7og8jc",
          "html": "Return to the hideout and talk to <a href=\"https://runescape.wiki/w/Straven\" target=\"_blank\" rel=\"noopener\">Straven</a>.",
          "text": "Return to the hideout and talk to Straven.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:9nsanb",
          "html": "Search the chest in the south-west corner of the hideout for a <a href=\"https://runescape.wiki/w/Broken_shield_(right)\" target=\"_blank\" rel=\"noopener\">broken shield</a>.",
          "text": "Search the chest in the south-west corner of the hideout for a broken shield.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:12co3b6",
          "html": "After climbing back up the ladder, enter the house east of the Phoenix Gang Hideout and go up the ladder there.",
          "text": "After climbing back up the ladder, enter the house east of the Phoenix Gang Hideout and go up the ladder there.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:yvoyuc",
          "html": "Pick up the two <a href=\"https://runescape.wiki/w/Phoenix_crossbow\" target=\"_blank\" rel=\"noopener\">Phoenix crossbows</a> on the floor, you will need these for the next gang.",
          "text": "Pick up the two Phoenix crossbows on the floor, you will need these for the next gang.",
