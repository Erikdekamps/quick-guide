        },
        {
          "type": "step",
          "id": "the-gangs:14ia0c2",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Charlie_the_Tramp\" target=\"_blank\" rel=\"noopener\">Charlie the Tramp</a> located just north of <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>&#39;s southern entrance. Ask him what&#39;s down the alley.",
          "text": "Talk to Charlie the Tramp located just north of Varrock's southern entrance. Ask him what's down the alley.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Do you know where I can find the Black Arm Gang hideout?"
                },
                {
                  "key": "1",
                  "text": "That sounds fair. (Pay 10 gold.)"
