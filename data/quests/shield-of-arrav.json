          "text": "Talk to Katrine.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I've heard you're the Black Arm Gang."
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "1",
                  "text": "I want to become a member of your gang."
                },
                {
                  "key": "1",
                  "text": "Well, you can give me a try, can't you?"
                },
                {
                  "key": "1",
                  "text": "No problem. I'll get you two phoenix crossbows."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-gangs:18jesbj",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Katrine\" target=\"_blank\" rel=\"noopener\">Katrine</a> again to give her the crossbows.",
          "text": "Talk to Katrine again to give her the crossbows.",
          "dialogue": [],
