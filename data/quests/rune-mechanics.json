        {
          "type": "step",
          "id": "wizard-dougal:1wun0m3",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Wizard_Dougal\" target=\"_blank\" rel=\"noopener\">Wizard Dougal</a> who is also in the basement.",
          "text": "Talk to Wizard Dougal who is also in the basement.",
