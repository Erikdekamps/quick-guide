      "anchor": "Building_the_huts",
      "blocks": [
        {
          "type": "step",
          "id": "building-the-huts:1bkd0gv",
          "html": "Go back to the southern beach and talk to one of the crab leaders.",
          "text": "Go back to the southern beach and talk to one of the crab leaders.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "building-the-huts:1bkd0gv:bsrsbv",
              "html": "6 seaweed can be collected to the west on the same beach.",
              "text": "6 seaweed can be collected to the west on the same beach.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "building-the-huts:1bkd0gv:17v6wgd",
              "html": "You also need to bring 3 ropes. If you have the <a href=\"https://runescape.wiki/w/Lorehound\" target=\"_blank\" rel=\"noopener\">Lorehound</a> pet quest supplies track unlocked you can obtain from there.",
              "text": "You also need to bring 3 ropes. If you have the Lorehound pet quest supplies track unlocked you can obtain from there.",
              "dialogue": [],
              "images": [],
