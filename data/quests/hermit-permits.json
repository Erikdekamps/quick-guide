  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:l6fjos",
          "html": "Read the Village <a href=\"https://runescape.wiki/w/Noticeboard_(Wendlewick)\" target=\"_blank\" rel=\"noopener\">Noticeboard</a> in <a href=\"https://runescape.wiki/w/Wendlewick\" target=\"_blank\" rel=\"noopener\">Wendlewick</a>, just north of the pub.",
          "text": "Read the Village Noticeboard in Wendlewick, just north of the pub.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "4",
                  "text": "HELP NEEDED! Crabs running amok."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1uk7sbq",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Grocer_Hannah\" target=\"_blank\" rel=\"noopener\">Grocer Hannah</a> in the Wendlewick <a href=\"https://runescape.wiki/w/The_Village_Grocery\" target=\"_blank\" rel=\"noopener\">food shop</a>, east of the bank.",
          "text": "Talk to Grocer Hannah in the Wendlewick food shop, east of the bank.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Talk about 'Hermit Permits'."
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "1",
                  "text": "I could try herding them out?"
                },
                {
                  "key": "2",
                  "text": "What if I threatened them?"
                },
                {
                  "key": "3",
                  "text": "I could just kill them all."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:64f5k8",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Shelly\" target=\"_blank\" rel=\"noopener\">Shelly</a>, the crab, located in the same store and on the floor.",
          "text": "Talk to Shelly, the crab, located in the same store and on the floor.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:14etip5",
          "html": "Follow the crab, talking to it every time it stops.",
          "text": "Follow the crab, talking to it every time it stops.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "obtaining-the-crabulet",
      "title": "Obtaining the crabulet",
      "anchor": "Obtaining_the_crabulet",
      "blocks": [
        {
          "type": "step",
          "id": "obtaining-the-crabulet:18cswy2",
          "html": "Enter the cave to the east and talk to <a href=\"https://runescape.wiki/w/Hermit\" target=\"_blank\" rel=\"noopener\">Hermit</a> inside to the north-west.",
          "text": "Enter the cave to the east and talk to Hermit inside to the north-west.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "obtaining-the-crabulet:f0k4dw",
          "html": "Kill one of the crabs for a <a href=\"https://runescape.wiki/w/Fresh_crab_claw\" target=\"_blank\" rel=\"noopener\">fresh crab claw</a>, craft it into an <a href=\"https://runescape.wiki/w/Crab_amulet_(unstrung)\" target=\"_blank\" rel=\"noopener\">crab amulet (unstrung)</a>, and use it on a ball of wool to make a <a href=\"https://runescape.wiki/w/Crab_amulet\" target=\"_blank\" rel=\"noopener\">crab amulet</a>.",
          "text": "Kill one of the crabs for a fresh crab claw, craft it into an crab amulet (unstrung), and use it on a ball of wool to make a crab amulet.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "obtaining-the-crabulet:kgaihf",
          "html": "Talk to Hermit again.",
          "text": "Talk to Hermit again.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "~",
                  "text": "[Any option]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "obtaining-the-crabulet:1m6i1s5",
          "html": "Equip the <a href=\"https://runescape.wiki/w/Crabulet\" target=\"_blank\" rel=\"noopener\">crabulet</a> and talk to Shelly.",
          "text": "Equip the crabulet and talk to Shelly.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "obtaining-the-crabulet:s4i3x1",
          "html": "Return to Wendlewick, go back to the food shop, and talk to Shelly.",
          "text": "Return to Wendlewick, go back to the food shop, and talk to Shelly.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "obtaining-the-crabulet:9awhgk",
          "html": "South of the <a href=\"https://runescape.wiki/w/Shrine_of_Inanna\" target=\"_blank\" rel=\"noopener\">Shrine of Inanna</a>, go to the beach and talk to any of the crabs (<a href=\"https://runescape.wiki/w/Finn_(Havenhythe)\" target=\"_blank\" rel=\"noopener\">Finn</a>, <a href=\"https://runescape.wiki/w/Sandy_(Havenhythe)\" target=\"_blank\" rel=\"noopener\">Sandy</a>, or <a href=\"https://runescape.wiki/w/Kai_(Havenhythe)\" target=\"_blank\" rel=\"noopener\">Kai</a>).",
          "text": "South of the Shrine of Inanna, go to the beach and talk to any of the crabs (Finn, Sandy, or Kai).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "obtaining-the-crabulet:9awhgk:vwxauk",
              "html": "(Optional) Travel via the <a href=\"https://runescape.wiki/w/Canoe_station_(Havenhythe)\" target=\"_blank\" rel=\"noopener\">canoe station</a> on the dock next to the <a href=\"https://runescape.wiki/w/Burnt_Lobster_Tavern\" target=\"_blank\" rel=\"noopener\">Burnt Lobster Tavern</a> and then go south-west.",
              "text": "(Optional) Travel via the canoe station on the dock next to the Burnt Lobster Tavern and then go south-west.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "3",
                      "text": "Wendlewick (Grotto)"
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
