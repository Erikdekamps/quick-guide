        {
          "type": "text",
          "html": "Colour<br>Attack Weakness<br><b>White</b><br><a href=\"https://runescape.wiki/w/Air_spells\" target=\"_blank\" rel=\"noopener\">Air spells</a> (<a href=\"https://runescape.wiki/w/Air_Strike\" target=\"_blank\" rel=\"noopener\">Air Strike</a>, <a href=\"https://runescape.wiki/w/Air_Bolt\" target=\"_blank\" rel=\"noopener\">Bolt</a>, <a href=\"https://runescape.wiki/w/Air_Blast\" target=\"_blank\" rel=\"noopener\">Blast</a>, <a href=\"https://runescape.wiki/w/Air_Wave\" target=\"_blank\" rel=\"noopener\">Wave</a>, and <a href=\"https://runescape.wiki/w/Air_Surge\" target=\"_blank\" rel=\"noopener\">Surge</a>)<br><b>Blue</b><br><a href=\"https://runescape.wiki/w/Water_spells\" target=\"_blank\" rel=\"noopener\">Water spells</a> (<a href=\"https://runescape.wiki/w/Water_Strike\" target=\"_blank\" rel=\"noopener\">Water Strike</a>, <a href=\"https://runescape.wiki/w/Water_Bolt\" target=\"_blank\" rel=\"noopener\">Bolt</a>, <a href=\"https://runescape.wiki/w/Water_Blast\" target=\"_blank\" rel=\"noopener\">Blast</a>, <a href=\"https://runescape.wiki/w/Water_Wave\" target=\"_blank\" rel=\"noopener\">Wave</a>, and <a href=\"https://runescape.wiki/w/Water_Surge\" target=\"_blank\" rel=\"noopener\">Surge</a>)<br><b>Brown</b><br><a href=\"https://runescape.wiki/w/Earth_spells\" target=\"_blank\" rel=\"noopener\">Earth spells</a> (<a href=\"https://runescape.wiki/w/Earth_Strike\" target=\"_blank\" rel=\"noopener\">Earth Strike</a>, <a href=\"https://runescape.wiki/w/Earth_Bolt\" target=\"_blank\" rel=\"noopener\">Bolt</a>, <a href=\"https://runescape.wiki/w/Earth_Blast\" target=\"_blank\" rel=\"noopener\">Blast</a>, <a href=\"https://runescape.wiki/w/Earth_Wave\" target=\"_blank\" rel=\"noopener\">Wave</a>, and <a href=\"https://runescape.wiki/w/Earth_Surge\" target=\"_blank\" rel=\"noopener\">Surge</a>)<br><b>Red</b><br><a href=\"https://runescape.wiki/w/Fire_spells\" target=\"_blank\" rel=\"noopener\">Fire spells</a> (<a href=\"https://runescape.wiki/w/Fire_Strike\" target=\"_blank\" rel=\"noopener\">Fire Strike</a>, <a href=\"https://runescape.wiki/w/Fire_Bolt\" target=\"_blank\" rel=\"noopener\">Bolt</a>, <a href=\"https://runescape.wiki/w/Fire_Blast\" target=\"_blank\" rel=\"noopener\">Blast</a>, <a href=\"https://runescape.wiki/w/Fire_Wave\" target=\"_blank\" rel=\"noopener\">Wave</a>, and <a href=\"https://runescape.wiki/w/Fire_Surge\" target=\"_blank\" rel=\"noopener\">Surge</a>)<br><b>Orange</b><br><a href=\"https://runescape.wiki/w/Melee\" target=\"_blank\" rel=\"noopener\">Melee</a> attacks (at least <a href=\"https://runescape.wiki/w/Rune_weapons\" target=\"_blank\" rel=\"noopener\">rune weapons</a> are recommended)<br><b>Green</b><br><a href=\"https://runescape.wiki/w/Ranged\" target=\"_blank\" rel=\"noopener\">Ranged</a> attacks or <a href=\"https://runescape.wiki/w/Special_attacks\" target=\"_blank\" rel=\"noopener\">special attacks</a> (at least <a href=\"https://runescape.wiki/w/Adamant_crossbow\" target=\"_blank\" rel=\"noopener\">adamant</a> or <a href=\"https://runescape.wiki/w/Rune_crossbow\" target=\"_blank\" rel=\"noopener\">rune crossbow</a> recommended)"
