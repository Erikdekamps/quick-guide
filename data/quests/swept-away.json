    "items": [
      {
        "html": "2 <a href=\"https://runescape.wiki/w/Quest_points\" target=\"_blank\" rel=\"noopener\">quest points</a> (or 1 <a href=\"https://runescape.wiki/w/Quest_point\" target=\"_blank\" rel=\"noopener\">quest point</a>; depending on whether you had completed <a href=\"https://runescape.wiki/w/Witch%27s_Potion_(miniquest)\" target=\"_blank\" rel=\"noopener\">Witch&#39;s Potion</a>/<a href=\"https://runescape.wiki/w/Sheep_Shearer_(miniquest)\" target=\"_blank\" rel=\"noopener\">Sheep Shearer</a> before they got demoted to a miniquest)",
        "text": "2 quest points (or 1 quest point; depending on whether you had completed Witch's Potion/Sheep Shearer before they got demoted to a miniquest)",
        "subs": []
      },
      {
        "html": "A <a href=\"https://runescape.wiki/w/Broomstick\" target=\"_blank\" rel=\"noopener\">broomstick</a>",
        "text": "A broomstick",
        "subs": []
      },
      {
        "html": "10 portions of experience-giving <a href=\"https://runescape.wiki/w/Goulash\" target=\"_blank\" rel=\"noopener\">goulash</a>, and a <a href=\"https://runescape.wiki/w/Bowl\" target=\"_blank\" rel=\"noopener\">bowl</a> to collect it with (each drink gives experience equal to ten times the corresponding skill level, or five times if used for <a href=\"https://runescape.wiki/w/Invention\" target=\"_blank\" rel=\"noopener\">Invention</a>)",
        "text": "10 portions of experience-giving goulash, and a bowl to collect it with (each drink gives experience equal to ten times the corresponding skill level, or five times if used for Invention)",
        "subs": []
