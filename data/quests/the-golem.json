        {
          "type": "step",
          "id": "statuette:1cvitm4",
          "html": "Use the letter on <a href=\"https://runescape.wiki/w/Elissa\" target=\"_blank\" rel=\"noopener\">Elissa</a> and talk to <a href=\"https://runescape.wiki/w/Elissa\" target=\"_blank\" rel=\"noopener\">Elissa</a> who is east of the winch in the north-east corner of the Varrock Dig Site (just north of <a href=\"https://runescape.wiki/w/The_Stormbreaker\" target=\"_blank\" rel=\"noopener\">The Stormbreaker</a> ship).",
          "text": "Use the letter on Elissa and talk to Elissa who is east of the winch in the north-east corner of the Varrock Dig Site (just north of The Stormbreaker ship).",
