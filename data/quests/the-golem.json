            {
              "type": "step",
              "id": "statuette:1kjbntd:9o2bnl",
              "html": "Teleport to the <a href=\"https://runescape.wiki/w/Varrock_Dig_Site\" target=\"_blank\" rel=\"noopener\">Varrock Dig Site</a> using the <a href=\"https://runescape.wiki/w/Archaeology_journal\" target=\"_blank\" rel=\"noopener\">Archaeology journal</a>.",
