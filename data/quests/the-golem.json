            {
              "type": "step",
              "id": "statuette:1kjbntd:1vhpuam",
              "html": "Teleport to <a href=\"https://runescape.wiki/w/Fort_Forinthry\" target=\"_blank\" rel=\"noopener\">Fort Forinthry</a> and run south.",
              "text": "Teleport to Fort Forinthry and run south.",
              "dialogue": [],
              "images": [],
              "tables": [],
