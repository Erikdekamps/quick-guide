  "sections": [
    {
      "id": "a-helping-hand",
      "title": "A helping hand",
      "anchor": "A_helping_hand",
      "blocks": [
        {
          "type": "step",
          "id": "a-helping-hand:1ogdopn",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Bert\" target=\"_blank\" rel=\"noopener\">Bert</a> in the building near Yanille&#39;s house portal.",
          "text": "Talk to Bert in the building near Yanille's house portal.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Eww a hand, in the sand! Why haven't you told the authorities?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "a-helping-hand:1ogdopn:zumgn",
              "html": "If you need a bucket of sand, there is a sand pit directly north of the house portal that you may fill your bucket at for later in the quest.",
              "text": "If you need a bucket of sand, there is a sand pit directly north of the house portal that you may fill your bucket at for later in the quest.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "a-helping-hand:12tu2x9",
          "html": "Give the <a href=\"https://runescape.wiki/w/Guard_Captain\" target=\"_blank\" rel=\"noopener\">Guard Captain</a> in the nearby pub a beer.",
          "text": "Give the Guard Captain in the nearby pub a beer.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-helping-hand:fq4xh6",
          "html": "Go east to the Wizards&#39; Guild and ring the bell on the eastern side of the building.",
          "text": "Go east to the Wizards' Guild and ring the bell on the eastern side of the building.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I have a rather sandy problem that I'd like to palm off on you."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "a-helping-hand:fq4xh6:1mszmyu",
              "html": "If you have at least 66 <a href=\"https://runescape.wiki/w/Magic\" target=\"_blank\" rel=\"noopener\">Magic</a>, you can enter the guild and go upstairs to find <a href=\"https://runescape.wiki/w/Zavistic_Rarve\" target=\"_blank\" rel=\"noopener\">Zavistic Rarve</a>, rather than calling him to the front door.",
              "text": "If you have at least 66 Magic, you can enter the guild and go upstairs to find Zavistic Rarve, rather than calling him to the front door.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "a-helping-hand:lfiov4",
          "html": "Return to Bert and speak to him to receive <a href=\"https://runescape.wiki/w/Bert%27s_rota\" target=\"_blank\" rel=\"noopener\">Bert&#39;s rota</a>.",
          "text": "Return to Bert and speak to him to receive Bert's rota.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-helping-hand:14w0mzu",
          "html": "Go to <a href=\"https://runescape.wiki/w/Brimhaven\" target=\"_blank\" rel=\"noopener\">Brimhaven</a> and find Sandy in a small house directly south of the <a href=\"https://runescape.wiki/w/The_Shrimp_and_Parrot\" target=\"_blank\" rel=\"noopener\">The Shrimp and Parrot</a>.",
          "text": "Go to Brimhaven and find Sandy in a small house directly south of the The Shrimp and Parrot.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-helping-hand:1w8fiyr",
          "html": "Search his desk to receive <a href=\"https://runescape.wiki/w/Sandy%27s_rota\" target=\"_blank\" rel=\"noopener\">Sandy&#39;s rota</a>.",
          "text": "Search his desk to receive Sandy's rota.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-helping-hand:xskxch",
          "html": "Pickpocket Sandy for some <a href=\"https://runescape.wiki/w/Sand\" target=\"_blank\" rel=\"noopener\">sand</a> (may take several attempts, bucket of sand does not count).",
          "text": "Pickpocket Sandy for some sand (may take several attempts, bucket of sand does not count).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-helping-hand:1fpur1n",
          "html": "Return to Bert and talk to him.",
          "text": "Return to Bert and talk to him.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-helping-hand:dtfsom",
          "html": "Ring the Wizards&#39; Guild bell and talk to Zavistic Rarve again to receive a <a href=\"https://runescape.wiki/w/Magical_orb\" target=\"_blank\" rel=\"noopener\">magical orb</a>.",
          "text": "Ring the Wizards' Guild bell and talk to Zavistic Rarve again to receive a magical orb.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I have a rather sandy problem that I'd like to palm off on you."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "a-helping-hand:dtfsom:e797bd",
              "html": "If you have a second empty vial you can teleport to Port Sarim&#39;s magic shop by talking to Zavistic Rarve again and give him an empty vial.",
              "text": "If you have a second empty vial you can teleport to Port Sarim's magic shop by talking to Zavistic Rarve again and give him an empty vial.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "2",
                      "text": "I have a rather sandy problem that I'd like to palm off on you."
                    },
                    {
                      "key": "4",
                      "text": "Can you help me more?."
                    },
                    {
                      "key": "1",
                      "text": "Okay"
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
