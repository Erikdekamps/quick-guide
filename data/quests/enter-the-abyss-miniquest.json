  "sections": [
    {
      "id": "starting-off",
      "title": "Starting off",
      "anchor": "Starting_off",
      "blocks": [
        {
          "type": "step",
          "id": "starting-off:stgfmh",
          "html": "If you have PVP enabled bank all your equipment, gear and items so that you don&#39;t lose anything to <a href=\"https://runescape.wiki/w/Player_killers\" target=\"_blank\" rel=\"noopener\">player killers</a>.",
          "text": "If you have PVP enabled bank all your equipment, gear and items so that you don't lose anything to player killers.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-off:m95tt5",
          "html": "North of <a href=\"https://runescape.wiki/w/Edgeville\" target=\"_blank\" rel=\"noopener\">Edgeville</a> jump the <a href=\"https://runescape.wiki/w/Wilderness_wall\" target=\"_blank\" rel=\"noopener\">Wilderness wall</a> and run north to the tip of the <a href=\"https://runescape.wiki/w/River_Lum\" target=\"_blank\" rel=\"noopener\">river Lum</a> and speak to the <a href=\"https://runescape.wiki/w/Mage_of_Zamorak\" target=\"_blank\" rel=\"noopener\">Mage of Zamorak</a> without wearing Saradomin or Guthix equipment.",
          "text": "North of Edgeville jump the Wilderness wall and run north to the tip of the river Lum and speak to the Mage of Zamorak without wearing Saradomin or Guthix equipment.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-off:1iohoq6",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Temple_of_Zamorak\" target=\"_blank\" rel=\"noopener\">Temple of Zamorak</a> in southeast of <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>.",
          "text": "Go to the Temple of Zamorak in southeast of Varrock.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-off:13gpw8",
          "html": "Without wearing Saradomin or Guthix equipment, speak to the <a href=\"https://runescape.wiki/w/Mage_of_Zamorak\" target=\"_blank\" rel=\"noopener\">Mage of Zamorak</a>.",
          "text": "Without wearing Saradomin or Guthix equipment, speak to the Mage of Zamorak.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Where do you get your runes from?"
                },
                {
                  "key": "1",
                  "text": "Yes"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-off:1k8rav2",
          "html": "Continue the dialogue where the mage explains how to use the <a href=\"https://runescape.wiki/w/Scrying_orb\" target=\"_blank\" rel=\"noopener\">scrying orb</a>.",
          "text": "Continue the dialogue where the mage explains how to use the scrying orb.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "getting-the-readings",
      "title": "Getting the readings",
      "anchor": "Getting_the_readings",
      "blocks": [
        {
          "type": "bring",
          "needed": [
            {
              "id": "getting-the-readings:bring:1t11mrr",
              "html": "2 backpack space",
              "text": "2 backpack space"
            }
          ],
          "recommended": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:gzi605",
          "html": "With the <a href=\"https://runescape.wiki/w/Scrying_orb\" target=\"_blank\" rel=\"noopener\">scrying orb</a> in the backpack go to <a href=\"https://runescape.wiki/w/Aubury%27s_Rune_Shop\" target=\"_blank\" rel=\"noopener\">Aubury&#39;s Rune Shop</a> in southeast of <a href=\"https://runescape.wiki/w/Varrock\" target=\"_blank\" rel=\"noopener\">Varrock</a>.",
          "text": "With the scrying orb in the backpack go to Aubury's Rune Shop in southeast of Varrock.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:fywp72",
          "html": "Choose the &quot;teleport&quot; option on <a href=\"https://runescape.wiki/w/Aubury\" target=\"_blank\" rel=\"noopener\">Aubury</a>.",
          "text": "Choose the \"teleport\" option on Aubury.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:1of3p7r",
          "html": "Head to the <a href=\"https://runescape.wiki/w/Wizard%27s_Tower\" target=\"_blank\" rel=\"noopener\">Wizard&#39;s Tower</a> south of <a href=\"https://runescape.wiki/w/Draynor\" target=\"_blank\" rel=\"noopener\">Draynor</a> and go to the 2<sup>nd</sup> floor (UK) / 3<sup>rd</sup> floor (US).",
          "text": "Head to the Wizard's Tower south of Draynor and go to the 2nd floor (UK) / 3rd floor (US).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:1d6we2v",
          "html": "Choose the &quot;teleport&quot; option on <a href=\"https://runescape.wiki/w/Archmage_Sedridor\" target=\"_blank\" rel=\"noopener\">Archmage Sedridor</a> in the south.",
          "text": "Choose the \"teleport\" option on Archmage Sedridor in the south.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:1o3yerq",
          "html": "Head to <a href=\"https://runescape.wiki/w/Wizard_Cromperty\" target=\"_blank\" rel=\"noopener\">Wizard Cromperty</a> who is located in the blue-tiled house in northeast of <a href=\"https://runescape.wiki/w/Ardougne\" target=\"_blank\" rel=\"noopener\">Ardougne</a>.",
          "text": "Head to Wizard Cromperty who is located in the blue-tiled house in northeast of Ardougne.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:1at6j9c",
          "html": "Choose the &quot;teleport&quot; option on Wizard Cromperty.",
          "text": "Choose the \"teleport\" option on Wizard Cromperty.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:1iohoq6",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Temple_of_Zamorak\" target=\"_blank\" rel=\"noopener\">Temple of Zamorak</a> in southeast of Varrock.",
          "text": "Go to the Temple of Zamorak in southeast of Varrock.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:49vgt",
          "html": "Without wearing Saradomin or Guthix equipment, talk to the <a href=\"https://runescape.wiki/w/Mage_of_Zamorak\" target=\"_blank\" rel=\"noopener\">Mage of Zamorak</a> twice. The step requires 2 backpack space.",
          "text": "Without wearing Saradomin or Guthix equipment, talk to the Mage of Zamorak twice. The step requires 2 backpack space.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:1eh5umu",
          "html": "Miniquest complete!",
          "text": "Miniquest complete!",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-the-readings:11rbt3s",
          "html": "After the completion of the miniquest, speak to the Mage of Zamorak a third time to unlock the <a href=\"https://runescape.wiki/w/Abyss\" target=\"_blank\" rel=\"noopener\">Abyss</a>.",
          "text": "After the completion of the miniquest, speak to the Mage of Zamorak a third time to unlock the Abyss.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    }
  ],
