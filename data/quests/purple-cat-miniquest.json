        {
          "type": "step",
          "id": "getting-started:1mdb31z",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Wendy\" target=\"_blank\" rel=\"noopener\">Wendy</a>, West of <a href=\"https://runescape.wiki/w/Draynor_lodestone\" target=\"_blank\" rel=\"noopener\">Draynor lodestone</a>.",
          "text": "Talk to Wendy, West of Draynor lodestone.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "4",
                  "text": "Have you seen that purple cat wandering around?"
                },
                {
                  "key": "2",
                  "text": "If I brought you a cat, could you make it purple?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
