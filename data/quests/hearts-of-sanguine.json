    {
      "id": "to-the-farm",
      "title": "To the farm",
      "anchor": "To_the_farm",
      "blocks": [
        {
          "type": "step",
          "id": "to-the-farm:o9h03g",
          "html": "Go south-east to <a href=\"https://runescape.wiki/w/Eastfold_Farm\" target=\"_blank\" rel=\"noopener\">Eastfold Farm</a> (can be reached via <a href=\"https://runescape.wiki/w/Fairy_ring\" target=\"_blank\" rel=\"noopener\">fairy ring</a> <b>B</b><b>K</b><b>S</b>) and talk to <a href=\"https://runescape.wiki/w/Farmer_Rachel\" target=\"_blank\" rel=\"noopener\">Farmer Rachel</a>.",
          "text": "Go south-east to Eastfold Farm (can be reached via fairy ring BKS) and talk to Farmer Rachel.",
          "dialogue": [
            {
              "when": null,
              "options": [
