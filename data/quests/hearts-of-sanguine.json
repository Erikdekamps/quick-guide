        {
          "type": "step",
          "id": "to-the-farm:1do0kxj",
          "html": "Investigate the <a href=\"https://runescape.wiki/w/Bloodsplatter\" target=\"_blank\" rel=\"noopener\">bloodsplatter</a> to the north at the broken fence.",
          "text": "Investigate the bloodsplatter to the north at the broken fence.",
