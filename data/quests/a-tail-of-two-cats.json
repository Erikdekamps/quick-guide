          "substeps": [
            {
              "type": "step",
              "id": "cathunt:6oypi:1bp63e0",
              "html": "Right-click and &quot;<i>open&quot;</i> the amulet.",
              "text": "Right-click and \"open\" the amulet.",
              "dialogue": [],
