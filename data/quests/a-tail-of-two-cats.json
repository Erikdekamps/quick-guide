        {
          "type": "step",
          "id": "memories-and-bob-s-list:171wd8m",
          "html": "Go to <a href=\"https://runescape.wiki/w/Sophanem\" target=\"_blank\" rel=\"noopener\">Sophanem</a> and talk to the <a href=\"https://runescape.wiki/w/Sphinx\" target=\"_blank\" rel=\"noopener\">Sphinx</a>.",
          "text": "Go to Sophanem and talk to the Sphinx.",
