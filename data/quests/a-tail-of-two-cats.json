          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "memories-and-bob-s-list:171wd8m:1j3sidn",
              "html": "Talk to <a href=\"https://runescape.wiki/w/Raetul_and_Co%27s_Cloth_Store\" target=\"_blank\" rel=\"noopener\">Raetul</a> and buy a full desert robe set, if you don&#39;t have them already.",
              "text": "Talk to Raetul and buy a full desert robe set, if you don't have them already.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "memories-and-bob-s-list:vo986m",
          "html": "Return to Unferth&#39;s house in Burthorpe and do the following:",
          "text": "Return to Unferth's house in Burthorpe and do the following:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "memories-and-bob-s-list:vo986m:186qx5o",
              "html": "<i>Rake</i> the patch behind his house and plant potato seeds in it. Your cat will notify you when they are done (typically 25–35 minutes to grow). A supreme growth potion from <a href=\"https://runescape.wiki/w/Player-owned_farm\" target=\"_blank\" rel=\"noopener\">player-owned farm</a> cannot be used to accelerate growth. It will not get diseased, and it does not need composting or watering.",
              "text": "Rake the patch behind his house and plant potato seeds in it. Your cat will notify you when they are done (typically 25–35 minutes to grow). A supreme growth potion from player-owned farm cannot be used to accelerate growth. It will not get diseased, and it does not need composting or watering.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": [
                {
                  "type": "step",
                  "id": "memories-and-bob-s-list:vo986m:186qx5o:9yiube",
                  "html": "If you don&#39;t have your cat out, chatbox will tell &quot;Perhaps I should have a look and see if Unferth&#39;s potatoes have grown...&quot;.",
                  "text": "If you don't have your cat out, chatbox will tell \"Perhaps I should have a look and see if Unferth's potatoes have grown...\".",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                }
              ]
            },
            {
              "type": "step",
              "id": "memories-and-bob-s-list:vo986m:tkkt7b",
              "html": "<i>Use</i> the logs on fireplace, then <i>light</i> the fireplace.",
              "text": "Use the logs on fireplace, then light the fireplace.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "memories-and-bob-s-list:vo986m:pnqbf4",
              "html": "<i>Use</i> the chocolate cake and bucket of milk on the table.",
              "text": "Use the chocolate cake and bucket of milk on the table.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "memories-and-bob-s-list:vo986m:1dc9kc3",
              "html": "<i>Make</i> his bed upstairs.",
              "text": "Make his bed upstairs.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "memories-and-bob-s-list:vo986m:1um08vf",
              "html": "Give Unferth a haircut.",
              "text": "Give Unferth a haircut.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "2",
                      "text": "Cut Unferth's hair"
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "memories-and-bob-s-list:1gfkjp1",
          "html": "Talk to Unferth once all the chores are done.",
          "text": "Talk to Unferth once all the chores are done.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
