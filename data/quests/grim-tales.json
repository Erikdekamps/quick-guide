        {
          "type": "step",
          "id": "grimgnash:k3uucj",
          "html": "Head up the east side of <a href=\"https://runescape.wiki/w/White_Wolf_Mountain\" target=\"_blank\" rel=\"noopener\">White Wolf Mountain</a> near the <a href=\"https://runescape.wiki/w/Burthorpe_mine\" target=\"_blank\" rel=\"noopener\">Burthorpe mine</a> entrance and talk to <a href=\"https://runescape.wiki/w/Grimgnash\" target=\"_blank\" rel=\"noopener\">Grimgnash</a>.",
          "text": "Head up the east side of White Wolf Mountain near the Burthorpe mine entrance and talk to Grimgnash.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I heard you were a great and mighty Griffin!"
                },
                {
                  "key": "1",
                  "text": "There once was graveyard filled with undead."
                },
                {
                  "key": "2",
                  "text": "There lived a skeleton named Skullrot."
                },
                {
                  "key": "4",
                  "text": "Skullrot was insane!"
                },
                {
                  "key": "4",
                  "text": "Skullrot hungrily grabbed the gnome's hair."
                },
                {
                  "key": "3",
                  "text": "Started to strangle the poor gnome."
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "grimgnash:hp9a",
          "html": "Once he is sleeping, <i>take</i> a <a href=\"https://runescape.wiki/w/Griffin_feather\" target=\"_blank\" rel=\"noopener\">Feather</a> from next to the nest.",
          "text": "Once he is sleeping, take a Feather from next to the nest.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
