    {
      "id": "smuggler-s-cavern",
      "title": "Smuggler's cavern",
      "anchor": "Smuggler's_cavern",
      "blocks": [
        {
          "type": "step",
          "id": "smuggler-s-cavern:r9cu0c",
          "html": "Ignore the crassians and enter the eastern room.",
          "text": "Ignore the crassians and enter the eastern room.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:1t2ckqc",
          "html": "Pick up the <a href=\"https://runescape.wiki/w/Valve_outer_wheel\" target=\"_blank\" rel=\"noopener\">valve outer wheel</a>, <a href=\"https://runescape.wiki/w/Valve_inner_wheel\" target=\"_blank\" rel=\"noopener\">valve inner wheel</a> and <a href=\"https://runescape.wiki/w/Pitch\" target=\"_blank\" rel=\"noopener\">pitch</a>.",
          "text": "Pick up the valve outer wheel, valve inner wheel and pitch.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:vwnr0u",
          "html": "<i>Repair</i> the <a href=\"https://runescape.wiki/w/Pipe_(A_Shadow_over_Ashdale)\" target=\"_blank\" rel=\"noopener\">pipe</a> on the ground.",
          "text": "Repair the pipe on the ground.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:9cxjmm",
          "html": "Combine the valve parts to create a <a href=\"https://runescape.wiki/w/Valve_wheel_(A_Shadow_over_Ashdale)\" target=\"_blank\" rel=\"noopener\">valve wheel</a>.",
          "text": "Combine the valve parts to create a valve wheel.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:bwenp1",
          "html": "<i>Repair</i> the <a href=\"https://runescape.wiki/w/Socket\" target=\"_blank\" rel=\"noopener\">socket</a> on the central <a href=\"https://runescape.wiki/w/Barrel_(A_Shadow_over_Ashdale)\" target=\"_blank\" rel=\"noopener\">barrel</a>.",
          "text": "Repair the socket on the central barrel.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:9csr52",
          "html": "<i>Turn</i> the valve wheel on the filled barrel, repeating this process on each of the barrels to move the water through the pipes to open the door.",
          "text": "Turn the valve wheel on the filled barrel, repeating this process on each of the barrels to move the water through the pipes to open the door.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:cyj891",
          "html": "Continue through and kill the crassian scouts in the next room to open the barrier.",
          "text": "Continue through and kill the crassian scouts in the next room to open the barrier.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:1p7egtx",
          "html": "<i>Pull</i> the <a href=\"https://runescape.wiki/w/Lever_(A_Shadow_over_Ashdale)\" target=\"_blank\" rel=\"noopener\">lever</a> to the south when the <a href=\"https://runescape.wiki/w/Crassian_warrior\" target=\"_blank\" rel=\"noopener\">crassian warrior</a> isn&#39;t looking.",
          "text": "Pull the lever to the south when the crassian warrior isn't looking.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "smuggler-s-cavern:1p7egtx:132mzpk",
              "html": "If seen, simply try again.",
              "text": "If seen, simply try again.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:r8xzv1",
          "html": "Do the same with each crassian warrior guarding a lever to kill them.",
          "text": "Do the same with each crassian warrior guarding a lever to kill them.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:wqeput",
          "html": "Optionally loot the <a href=\"https://runescape.wiki/w/Chest_(A_Shadow_over_Ashdale)\" target=\"_blank\" rel=\"noopener\">chests</a> along the path for some <a href=\"https://runescape.wiki/w/Coins\" target=\"_blank\" rel=\"noopener\">coins</a> and uncut gems.",
          "text": "Optionally loot the chests along the path for some coins and uncut gems.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "smuggler-s-cavern:398bgq",
          "html": "Run past the scouts.",
          "text": "Run past the scouts.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
