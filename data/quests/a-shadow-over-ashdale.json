              "text": "Weapons to deal damage from a distance"
            }
          ]
        },
        {
          "type": "step",
          "id": "return-to-ashdale:1o10imj",
          "html": "To start, talk to <a href=\"https://runescape.wiki/w/Gudrik\" target=\"_blank\" rel=\"noopener\">Gudrik</a>, east of Gerrant&#39;s Fishy Business in Port Sarim.",
          "text": "To start, talk to Gudrik, east of Gerrant's Fishy Business in Port Sarim.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Ask about A Shadow over Ashdale."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "return-to-ashdale:14tdu7w",
          "html": "Talk to him again.",
          "text": "Talk to him again.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Can you take me to the island of Ashdale?"
                },
                {
                  "key": "1",
                  "text": "Ashdale by night (A Shadow over Ashdale)."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "return-to-ashdale:tklgpn",
          "html": "Once you arrive at Ashdale, head north into <a href=\"https://runescape.wiki/w/Lucy_(A_Shadow_over_Ashdale)\" target=\"_blank\" rel=\"noopener\">Lucy</a>&#39;s house to speak with her.",
          "text": "Once you arrive at Ashdale, head north into Lucy's house to speak with her.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I'm here to help."
                },
                {
                  "key": "3",
                  "text": "Why haven't you tried to leave?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "return-to-ashdale:67zqyc",
          "html": "<i>Enter</i> the <a href=\"https://runescape.wiki/w/Storm_drain\" target=\"_blank\" rel=\"noopener\">storm drain</a> just west of the house.",
          "text": "Enter the storm drain just west of the house.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "sewer-raider",
      "title": "Sewer raider",
      "anchor": "Sewer_raider",
      "blocks": [
        {
          "type": "step",
          "id": "sewer-raider:1d1n76p",
          "html": "Go through in the sewer, killing or running past crassians.",
          "text": "Go through in the sewer, killing or running past crassians.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "sewer-raider:my53l5",
          "html": "Climb up the ladder at the end of the sewer.",
          "text": "Climb up the ladder at the end of the sewer.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "sewer-raider:1bryos5",
          "html": "Run west, then south up the stairs. Continue south through Ashdale, through the gate and into the house.",
          "text": "Run west, then south up the stairs. Continue south through Ashdale, through the gate and into the house.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "sewer-raider:1rgs34n",
          "html": "Inspect the <a href=\"https://runescape.wiki/w/Bust\" target=\"_blank\" rel=\"noopener\">bust</a> by the fireplace.",
          "text": "Inspect the bust by the fireplace.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "sewer-raider:1sslczi",
