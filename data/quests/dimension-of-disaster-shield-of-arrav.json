  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:eq68pu",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Orlando_Smith\" target=\"_blank\" rel=\"noopener\">Orlando Smith</a> in the New Varrock Museum.",
          "text": "Talk to Orlando Smith in the New Varrock Museum.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "3",
                  "text": "Farewell."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "text",
          "html": "The quest diverges based on the gang you most recently joined (if you replay and want the <a href=\"https://runescape.wiki/w/South_AND_West_Side_Story\" target=\"_blank\" rel=\"noopener\">South AND West Side Story</a> achievement check which one you joined last time in your quest journal):"
        },
        {
          "type": "step",
          "id": "getting-started:1np00xj",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Charlie_the_Tramp\" target=\"_blank\" rel=\"noopener\">Charlie the Tramp</a>",
          "text": "Speak to Charlie the Tramp",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Can you help me find the Black Arm Gang hideout?"
                },
                {
                  "key": "1",
                  "text": "Give him a couple Zemomarks"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:d158y4",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Katrine\" target=\"_blank\" rel=\"noopener\">Katrine</a> in the Black Arm Gang Hideout.",
          "text": "Speak to Katrine in the Black Arm Gang Hideout.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I've heard you're the Black Arm Gang."
                },
                {
                  "key": "1",
                  "text": "I'd rather not reveal my sources."
                },
                {
                  "key": "2",
                  "text": "I want to join your gang."
                },
                {
                  "key": "4",
                  "text": "Farewell."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:nzu743",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Jonny_the_Beard\" target=\"_blank\" rel=\"noopener\">Jonny the Beard</a> in the <a href=\"https://runescape.wiki/w/Blue_Moon_Inn\" target=\"_blank\" rel=\"noopener\">Blue Moon Inn</a>.",
          "text": "Talk to Jonny the Beard in the Blue Moon Inn.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:nqsspk",
          "html": "Talk again and defeat Jonny the Beard.",
          "text": "Talk again and defeat Jonny the Beard.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:nqsspk:kmvhi2",
              "html": "If he disappears when you start fighting him, be sure to have auto retaliate on. You can reset the fight by walking upstairs and talking to him again.",
              "text": "If he disappears when you start fighting him, be sure to have auto retaliate on. You can reset the fight by walking upstairs and talking to him again.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:a6yf41",
          "html": "Take the <a href=\"https://runescape.wiki/w/Black_arm\" target=\"_blank\" rel=\"noopener\">black arm</a> to Katrine",
          "text": "Take the black arm to Katrine",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I've got your arm."
                },
                {
                  "key": "1",
                  "text": "I want to join the Black Arm Gang."
                },
                {
                  "key": "4",
                  "text": "Farewell."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:a6yf41:3nywkc",
              "html": "Join the Black Arm Gang.",
              "text": "Join the Black Arm Gang.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:uwkklo",
          "html": "Talk to Moira in the back room until you get the documents.",
          "text": "Talk to Moira in the back room until you get the documents.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:w9h70q",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Baraek\" target=\"_blank\" rel=\"noopener\">Baraek</a> in New Varrock square.",
          "text": "Talk to Baraek in New Varrock square.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Can you tell me where I can find the Phoenix Gang?"
                },
                {
                  "key": "1",
                  "text": "Sure have 2 zemomarks."
                },
                {
                  "key": "4",
                  "text": "Farewell."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1hfc5an",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Straven\" target=\"_blank\" rel=\"noopener\">Straven</a> near the south-eastern wall of New Varrock.",
          "text": "Talk to Straven near the south-eastern wall of New Varrock.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I know who you are!"
                },
                {
                  "key": "2",
                  "text": "I want to join your gang."
                },
                {
                  "key": "1",
                  "text": "What do I have to do to join the Phoenix gang?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:y9e1cw",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Lowe\" target=\"_blank\" rel=\"noopener\">Lowe</a> in <a href=\"https://runescape.wiki/w/Lowe%27s_Archery_Emporium\" target=\"_blank\" rel=\"noopener\">his archery emporium</a>.",
          "text": "Talk to Lowe in his archery emporium.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:wt0p6n",
          "html": "Go upstairs and take the moving egg by walking around the normal eggs.",
          "text": "Go upstairs and take the moving egg by walking around the normal eggs.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:ok6aaf",
          "html": "Talk to Straven.",
          "text": "Talk to Straven.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I've got your phoenix eggling."
                },
                {
                  "key": "3",
                  "text": "Clap at the egg."
                },
                {
                  "key": "1",
                  "text": "I want to join the Phoenix Gang."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:16o4jc5",
          "html": "Join Phoenix Gang.",
          "text": "Join Phoenix Gang.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:4fm6ea",
          "html": "Open the door to Molly&#39;s room using the pass phrase.",
          "text": "Open the door to Molly's room using the pass phrase.",
          "dialogue": [],
