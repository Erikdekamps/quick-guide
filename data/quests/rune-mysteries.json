        {
          "type": "step",
          "id": "the-old-tower:1uayy6e",
          "html": "Descend the beam twice or right-click and select <i>bottom floor</i> back to the ground floor (UK) / 1<sup>st</sup> floor (US).",
          "text": "Descend the beam twice or right-click and select bottom floor back to the ground floor (UK) / 1st floor (US).",
