          "html": "Talk to <a href=\"https://runescape.wiki/w/Wizard_Ellaron\" target=\"_blank\" rel=\"noopener\">Wizard Ellaron</a> in the northeastern room.",
          "text": "Talk to Wizard Ellaron in the northeastern room.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Ariane says the tower is in danger."
