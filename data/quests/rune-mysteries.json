        {
          "type": "step",
          "id": "getting-started:1jnzdwp",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Ariane\" target=\"_blank\" rel=\"noopener\">Ariane</a> in the entrance to <a href=\"https://runescape.wiki/w/Wizards%27_Tower\" target=\"_blank\" rel=\"noopener\">Wizards&#39; Tower</a>.",
          "text": "Talk to Ariane in the entrance to Wizards' Tower.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What's happening here?"
                },
                {
                  "key": "2",
                  "text": "What can I do to help?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:kuoeks",
          "html": "Head into the tower, pick up the <a href=\"https://runescape.wiki/w/Tower_mindspike\" target=\"_blank\" rel=\"noopener\">Tower mindspike</a> and attack the vortex with any spell. You must unequip any ranged, melee, or necromancy armour or you may not be able to lure the vortex.",
          "text": "Head into the tower, pick up the Tower mindspike and attack the vortex with any spell. You must unequip any ranged, melee, or necromancy armour or you may not be able to lure the vortex.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:n5n8mg",
          "html": "Lure the vortex into the energy beam.",
          "text": "Lure the vortex into the energy beam.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
