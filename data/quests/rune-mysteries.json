    {
      "id": "the-old-tower",
      "title": "The old tower",
      "anchor": "The_old_tower",
      "blocks": [
        {
          "type": "step",
          "id": "the-old-tower:175k29u",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Ariane\" target=\"_blank\" rel=\"noopener\">Ariane</a> on the bridge outside.",
          "text": "Talk to Ariane on the bridge outside.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "What do you want me to do?"
                },
                {
                  "key": "2",
                  "text": "I'll get on it."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-old-tower:1ngjg75",
          "html": "Ascend the beam twice, and talk to <a href=\"https://runescape.wiki/w/Wizard_Traiborn\" target=\"_blank\" rel=\"noopener\">Wizard Traiborn</a> in the northwestern room.",
          "text": "Ascend the beam twice, and talk to Wizard Traiborn in the northwestern room.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Have you seen anything unusual lately?"
                },
                {
                  "key": "2",
                  "text": "In the power beam?"
                },
                {
                  "key": "2",
                  "text": "Where do these things come from?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-old-tower:1i7zk93",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Archmage_Sedridor\" target=\"_blank\" rel=\"noopener\">Archmage Sedridor</a> in the southern room.",
          "text": "Talk to Archmage Sedridor in the southern room.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Ariane says the tower is in danger."
                },
                {
                  "key": "3",
                  "text": "What are you going to do?"
                },
                {
                  "key": "4",
                  "text": "Goodbye."
