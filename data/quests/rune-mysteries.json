        {
          "type": "step",
          "id": "the-old-tower:18qvf9u",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Ariane\" target=\"_blank\" rel=\"noopener\">Ariane</a>.",
          "text": "Talk to Ariane.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I've spoken to some of the wizards..."
                },
                {
                  "key": "3",
                  "text": "Wizard Traiborn said something came through the library floor."
                },
                {
                  "key": "2",
                  "text": "Then let's get down there and investigate!"
                },
                {
                  "key": "2",
                  "text": "I'll get right on it."
