        {
          "type": "step",
          "id": "the-hidden-key:1vkcy0o",
          "html": "Play the organ at the southern end of the ground floor (UK) / 1<sup>st</sup> floor (US).",
          "text": "Play the organ at the southern end of the ground floor (UK) / 1st floor (US).",
