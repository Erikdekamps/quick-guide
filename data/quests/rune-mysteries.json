        {
          "type": "step",
          "id": "the-hidden-key:13ipbuc",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Wizard_Ellaron\" target=\"_blank\" rel=\"noopener\">Wizard Ellaron</a>.",
          "text": "Talk to Wizard Ellaron.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "How can I get into the old tower?"
                },
                {
                  "key": "3",
                  "text": "You do know, though?"
                },
                {
                  "key": "3",
                  "text": "You mean the rumour about Water Surge?"
                },
                {
                  "key": "3",
                  "text": "What do you mean, the key lies in understanding Water Surge?"
                },
                {
                  "key": "2",
                  "text": "It's such a pity you couldn't help me, Maybe I'll visit the library."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-hidden-key:1ymktrt",
          "html": "Go back to the ground floor (UK) / 1<sup>st</sup> floor (US) and search the easternmost bookcase for <a href=\"https://runescape.wiki/w/The_Harmony_of_the_Runes\" target=\"_blank\" rel=\"noopener\">The Harmony of the Runes</a> and <a href=\"https://runescape.wiki/w/The_Runes_of_the_Spells_of_Water\" target=\"_blank\" rel=\"noopener\">The Runes of the Spells of Water</a>.",
          "text": "Go back to the ground floor (UK) / 1st floor (US) and search the easternmost bookcase for The Harmony of the Runes and The Runes of the Spells of Water.",
