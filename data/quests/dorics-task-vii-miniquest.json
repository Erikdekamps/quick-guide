            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "nostalgic-warhammers:4bt9le",
          "html": "Head to the northwesternmost building in western <a href=\"https://runescape.wiki/w/Keldagrim\" target=\"_blank\" rel=\"noopener\">Keldagrim</a>.",
