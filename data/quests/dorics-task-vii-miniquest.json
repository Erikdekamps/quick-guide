          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "nostalgic-warhammers:cyym5s",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Santiri\" target=\"_blank\" rel=\"noopener\">Santiri</a>. (If this is your first time in Keldagrim, you may need to talk to Santiri to accept an unrelated task, talk to him again to cancel it, and then talk to him a final time to start dialogue about the miniquest.)",
          "text": "Talk to Santiri. (If this is your first time in Keldagrim, you may need to talk to Santiri to accept an unrelated task, talk to him again to cancel it, and then talk to him a final time to start dialogue about the miniquest.)",
