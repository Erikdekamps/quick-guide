          "type": "step",
          "id": "nostalgic-warhammers:3ifcno",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Doric\" target=\"_blank\" rel=\"noopener\">Doric</a> in his hut north of Falador.",
          "text": "Speak to Doric in his hut north of Falador.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Do you have any more Smithing tasks for me?"
