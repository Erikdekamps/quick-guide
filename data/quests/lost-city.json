  "sections": [
    {
      "id": "seeking-the-lost-city",
      "title": "Seeking the lost city",
      "anchor": "Seeking_the_lost_city",
      "blocks": [
        {
          "type": "step",
          "id": "seeking-the-lost-city:16j9ckc",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Warrior_(Lost_City)\" target=\"_blank\" rel=\"noopener\">Warrior</a> northwest of the <a href=\"https://runescape.wiki/w/Lumbridge_swamp\" target=\"_blank\" rel=\"noopener\">Lumbridge swamp</a> to start the quest.",
          "text": "Talk to the Warrior northwest of the Lumbridge swamp to start the quest.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Why are you camped out here?"
                },
                {
                  "key": "1",
                  "text": "Who's Zanaris?"
                },
                {
                  "key": "1",
                  "text": "If it's hidden, how are you planning to find it?"
                },
                {
                  "key": "2",
                  "text": "Looks like you don't know either."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "seeking-the-lost-city:11f57rl",
          "html": "Attempt to chop the <a href=\"https://runescape.wiki/w/Swamp_Tree_(Lost_City)\" target=\"_blank\" rel=\"noopener\">swamp tree</a> south of the campsite - There will be an option to &quot;chop&quot; tree instead of &quot;chop down&quot; tree, and a quest icon on the tooltip.",
          "text": "Attempt to chop the swamp tree south of the campsite - There will be an option to \"chop\" tree instead of \"chop down\" tree, and a quest icon on the tooltip.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "seeking-the-lost-city:1hagyl",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Shamus\" target=\"_blank\" rel=\"noopener\">Shamus</a>.",
          "text": "Talk to Shamus.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I've been in that shed and I didn't see a city."
                },
                {
                  "key": "1",
                  "text": "Yes, please, a teleport would be useful."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "entrana",
      "title": "Entrana",
      "anchor": "Entrana",
      "blocks": [
        {
          "type": "image",
          "src": "https://runescape.wiki/images/thumb/Fighting_the_Dramen_tree_spirit.png/300px-Fighting_the_Dramen_tree_spirit.png?0e644",
          "width": 300,
          "height": 210,
          "alt": "",
          "caption": "A safespot to fight the tree spirit from by standing behind the fungus south of the tree.",
          "href": "https://runescape.wiki/w/File:Fighting_the_Dramen_tree_spirit.png"
        },
        {
          "type": "step",
          "id": "entrana:15fpkz1",
          "html": "Bring items to craft a weapon on <a href=\"https://runescape.wiki/w/Entrana\" target=\"_blank\" rel=\"noopener\">Entrana</a>. If you plan on using magic, you must have a magic weapon; you cannot cast spells without one. You can also remove tool belt items once you enter the dungeon, e.g. a <a href=\"https://runescape.wiki/w/Mithril_hatchet\" target=\"_blank\" rel=\"noopener\">mithril hatchet</a>, for use in combat.",
          "text": "Bring items to craft a weapon on Entrana. If you plan on using magic, you must have a magic weapon; you cannot cast spells without one. You can also remove tool belt items once you enter the dungeon, e.g. a mithril hatchet, for use in combat.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:1ugybal",
          "html": "Talk to the monks on the northern pier of <a href=\"https://runescape.wiki/w/Port_Sarim\" target=\"_blank\" rel=\"noopener\">Port Sarim</a> to be transported to Entrana.",
          "text": "Talk to the monks on the northern pier of Port Sarim to be transported to Entrana.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:1vvlga3",
          "html": "Do not craft your weapons now or you&#39;ll be thrown out of Entrana.",
          "text": "Do not craft your weapons now or you'll be thrown out of Entrana.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:1eg97ac",
          "html": "Run north-west though the wooded area to the dungeon entrance ladder.",
          "text": "Run north-west though the wooded area to the dungeon entrance ladder.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:1jsm4pa",
          "html": "Enter the dungeon.",
          "text": "Enter the dungeon.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Well, that is a risk I will have to take."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:615col",
          "html": "Craft your weapons now.",
          "text": "Craft your weapons now.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:xch52n",
          "html": "Run to the southern-most part of the dungeon.",
          "text": "Run to the southern-most part of the dungeon.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:1n2ryb",
          "html": "Chop the <a href=\"https://runescape.wiki/w/Dramen_tree\" target=\"_blank\" rel=\"noopener\">dramen tree</a>.",
          "text": "Chop the dramen tree.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:1htipi2",
          "html": "Kill the <a href=\"https://runescape.wiki/w/Dramen_tree_spirit\" target=\"_blank\" rel=\"noopener\">dramen tree spirit</a>.",
          "text": "Kill the dramen tree spirit.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "entrana:1htipi2:1kpkfjr",
              "html": "Make sure to let the dialogue appear before chopping again, or you may spawn a second spirit.",
              "text": "Make sure to let the dialogue appear before chopping again, or you may spawn a second spirit.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "entrana:1u3feob",
          "html": "Chop the dramen tree again.",
          "text": "Chop the dramen tree again.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "entrana:11bp7b1",
          "html": "Craft the <a href=\"https://runescape.wiki/w/Dramen_branch\" target=\"_blank\" rel=\"noopener\">dramen branch</a> using a knife.",
          "text": "Craft the dramen branch using a knife.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "entrana:11bp7b1:1vpougc",
              "html": "If you have not completed the quest <a href=\"https://runescape.wiki/w/Recipe_for_Disaster:_Freeing_Sir_Amik_Varze\" target=\"_blank\" rel=\"noopener\">Recipe for Disaster: Freeing Sir Amik Varze</a> yet, you may want to get a second dramen branch and craft it with the pestle and mortar. This gives an item required for the quest, <a href=\"https://runescape.wiki/w/Cinnamon\" target=\"_blank\" rel=\"noopener\">cinnamon</a>, and saves an otherwise necessary second trip to the island.",
              "text": "If you have not completed the quest Recipe for Disaster: Freeing Sir Amik Varze yet, you may want to get a second dramen branch and craft it with the pestle and mortar. This gives an item required for the quest, cinnamon, and saves an otherwise necessary second trip to the island.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "entrana:169p5yl",
          "html": "Enter the door to the east or teleport out.",
          "text": "Enter the door to the east or teleport out.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
