              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:aruwd0",
          "html": "<i>Jump</i> the bridge and find a nearby <a href=\"https://runescape.wiki/w/Rotting_log\" target=\"_blank\" rel=\"noopener\">rotting log</a> in the swamp.",
          "text": "Jump the bridge and find a nearby rotting log in the swamp.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "becoming-a-nature-spirit:aruwd0:tj5s02",
              "html": "There is some directly West of the Grotto tree island.",
              "text": "There is some directly West of the Grotto tree island.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:a0jypb",
          "html": "<i>Cast</i> the druidic spell in your backpack, then <i>pick</i> the fungus from the log.",
          "text": "Cast the druidic spell in your backpack, then pick the fungus from the log.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:1aust9x",
          "html": "Take the <a href=\"https://runescape.wiki/w/Mort_myre_fungus\" target=\"_blank\" rel=\"noopener\">Mort myre fungus</a> mushroom from the log and talk to Filliman.",
          "text": "Take the Mort myre fungus mushroom from the log and talk to Filliman.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:1eajxtp",
          "html": "<i>Use</i> the Mort myre fungus on the western, yellow stone.",
          "text": "Use the Mort myre fungus on the western, yellow stone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:1bey1wg",
          "html": "<i>Use</i> <a href=\"https://runescape.wiki/w/A_used_spell\" target=\"_blank\" rel=\"noopener\">a used spell</a> on the eastern, grey stone.",
          "text": "Use a used spell on the eastern, grey stone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:jv4wr4",
          "html": "Stand on top of the southern, orange stone in the centre by right-click selecting &quot;Walk here&quot;.",
          "text": "Stand on top of the southern, orange stone in the centre by right-click selecting \"Walk here\".",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:qoglv8",
          "html": "Tell Filliman the puzzle is solved.",
          "text": "Tell Filliman the puzzle is solved.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I think I've solved the puzzle!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:yvvv2z",
          "html": "<i>Enter</i> the Grotto tree.",
          "text": "Enter the Grotto tree.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:1nm43hs",
          "html": "<i>Search</i> the <a href=\"https://runescape.wiki/w/Grotto\" target=\"_blank\" rel=\"noopener\">Grotto</a> in the centre.",
          "text": "Search the Grotto in the centre.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "becoming-a-nature-spirit:eyuo3w",
          "html": "Continue speaking with <a href=\"https://runescape.wiki/w/Nature_Spirit_(NPC)\" target=\"_blank\" rel=\"noopener\">Nature Spirit</a> and he will ask you for a <a href=\"https://runescape.wiki/w/Silver_sickle\" target=\"_blank\" rel=\"noopener\">silver sickle</a>.",
          "text": "Continue speaking with Nature Spirit and he will ask you for a silver sickle.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "4",
                  "text": "Ok, thanks."
                }
              ]
            }
          ],
          "images": [],
