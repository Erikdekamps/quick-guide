        {
          "type": "step",
          "id": "killing-the-ghasts:15ax7x0",
          "html": "Talk to the Nature Spirit with a silver sickle in your backpack. He will bless it for a <a href=\"https://runescape.wiki/w/Silver_sickle_(b)\" target=\"_blank\" rel=\"noopener\">silver sickle (b)</a>.",
          "text": "Talk to the Nature Spirit with a silver sickle in your backpack. He will bless it for a silver sickle (b).",
