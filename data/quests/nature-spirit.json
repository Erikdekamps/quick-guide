            {
              "id": "getting-started:bring:15zkpyc",
              "html": "<a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">Ghostspeak amulet</a>",
              "text": "Ghostspeak amulet"
            }
          ],
          "recommended": []
        },
        {
          "type": "map",
          "caption": "Start point of the quest is within this Mausoleum",
          "lat": 3507,
          "lon": 3404,
          "zoom": 3,
          "plane": 0,
          "mapId": 28,
          "version": "2026-10-12-a",
          "features": [],
          "href": "https://runescape.wiki/w/Nature_Spirit/Quick_guide"
        },
        {
          "type": "step",
          "id": "getting-started:ctnkbu",
          "html": "Make sure you have prayer points before starting.",
          "text": "Make sure you have prayer points before starting.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:p7fmt1",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Drezel\" target=\"_blank\" rel=\"noopener\">Drezel</a>, who is located underground near <a href=\"https://runescape.wiki/w/Paterdomus\" target=\"_blank\" rel=\"noopener\">Paterdomus</a>. The entrance is north from the temple&#39;s door. You should have six empty backpack space; otherwise the food he gives you will appear on the floor.",
          "text": "Talk to Drezel, who is located underground near Paterdomus. The entrance is north from the temple's door. You should have six empty backpack space; otherwise the food he gives you will appear on the floor.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:p7fmt1:p25hmf",
              "html": "If you have lost <a href=\"https://runescape.wiki/w/Wolfbane\" target=\"_blank\" rel=\"noopener\">Wolfbane</a>:",
              "text": "If you have lost Wolfbane:",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "2",
                      "text": "Talk about something else."
                    },
                    {
                      "key": "2",
                      "text": "Is there anything else interesting to do around here?"
                    },
                    {
                      "key": "✓",
                      "text": "[Accept Quest]"
                    },
                    {
                      "key": "4",
                      "text": "Yes, I'll go and look for him."
                    },
                    {
                      "key": "1",
                      "text": "Yes, I'm sure."
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "getting-started:p7fmt1:6n8kai",
              "html": "If you have <a href=\"https://runescape.wiki/w/Wolfbane\" target=\"_blank\" rel=\"noopener\">Wolfbane</a> in your bank or backpack:",
              "text": "If you have Wolfbane in your bank or backpack:",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "2",
                      "text": "Is there anything else interesting to do around here?"
                    },
                    {
                      "key": "✓",
                      "text": "[Accept Quest]"
                    },
                    {
                      "key": "4",
                      "text": "Yes, I'll go and look for him."
                    },
                    {
                      "key": "1",
                      "text": "Yes, I'm sure."
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "getting-started:p7fmt1:zcf94z",
              "html": "If you have just completed <a href=\"https://runescape.wiki/w/Priest_in_Peril\" target=\"_blank\" rel=\"noopener\">Priest in Peril</a>, then you might need to exit and reenter the Mausoleum before the quest dialogue will appear. Drezel should be standing in the last chamber before the holy barrier.",
              "text": "If you have just completed Priest in Peril, then you might need to exit and reenter the Mausoleum before the quest dialogue will appear. Drezel should be standing in the last chamber before the holy barrier.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:1re6j3w",
          "html": "Exit into Morytania and travel south to a fence.",
          "text": "Exit into Morytania and travel south to a fence.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1y1g7ih",
          "html": "Look along the fence for a gate and go through it.",
          "text": "Look along the fence for a gate and go through it.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:g7fhnm",
          "html": "Go south until a round island is found with a grotto tree.",
          "text": "Go south until a round island is found with a grotto tree.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1g8pad4",
          "html": "Jump across the broken bridge and onto the island.",
          "text": "Jump across the broken bridge and onto the island.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "the-ghost-of-the-grotto",
      "title": "The ghost of the grotto",
      "anchor": "The_ghost_of_the_grotto",
      "blocks": [
        {
          "type": "step",
          "id": "the-ghost-of-the-grotto:17108jv",
          "html": "Search the bench nearby for a small <a href=\"https://runescape.wiki/w/Mirror\" target=\"_blank\" rel=\"noopener\">mirror</a>.",
          "text": "Search the bench nearby for a small mirror.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-ghost-of-the-grotto:s3pwhh",
          "html": "Search the <a href=\"https://runescape.wiki/w/Grotto_tree\" target=\"_blank\" rel=\"noopener\">grotto tree</a> for Filliman&#39;s <a href=\"https://runescape.wiki/w/Journal_(Nature_Spirit)\" target=\"_blank\" rel=\"noopener\">journal</a>.",
          "text": "Search the grotto tree for Filliman's journal.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-ghost-of-the-grotto:1ryxyo5",
          "html": "Equip your <a href=\"https://runescape.wiki/w/Ghostspeak_amulet\" target=\"_blank\" rel=\"noopener\">ghostspeak amulet</a> and talk to <a href=\"https://runescape.wiki/w/Filliman_Tarlock\" target=\"_blank\" rel=\"noopener\">Filliman Tarlock</a>.",
          "text": "Equip your ghostspeak amulet and talk to Filliman Tarlock.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "How long have you been a ghost?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-ghost-of-the-grotto:1iiedbt",
          "html": "Use the mirror on Filliman to prove he&#39;s a ghost.",
          "text": "Use the mirror on Filliman to prove he's a ghost.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "So, what's your plan?"
                },
                {
                  "key": "4",
                  "text": "How can I help?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-ghost-of-the-grotto:1iiedbt:1hyaixw",
              "html": "He&#39;ll give you a <a href=\"https://runescape.wiki/w/Druidic_spell\" target=\"_blank\" rel=\"noopener\">druidic spell</a>.",
              "text": "He'll give you a druidic spell.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
    {
