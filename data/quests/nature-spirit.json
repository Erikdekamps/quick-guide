              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "becoming-a-nature-spirit:1nandvf:11ff9fb",
              "html": "If you have the wolfbane in your backpack or bank:",
              "text": "If you have the wolfbane in your backpack or bank:",
              "dialogue": [
                {
                  "when": null,
