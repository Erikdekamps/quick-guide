    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:8rqrnu",
          "html": "Go to <a href=\"https://runescape.wiki/w/Gertrude\" target=\"_blank\" rel=\"noopener\">Gertrude&#39;s</a> house north-west of the <a href=\"https://runescape.wiki/w/Varrock_lodestone\" target=\"_blank\" rel=\"noopener\">Varrock lodestone</a>.",
          "text": "Go to Gertrude's house north-west of the Varrock lodestone.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1dv1di",
          "html": "Talk to Gertrude.",
          "text": "Talk to Gertrude.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:m8d4m4",
          "html": "Go behind the house and pick up a <a href=\"https://runescape.wiki/w/Doogle_leaf\" target=\"_blank\" rel=\"noopener\">doogle leaf</a>.",
          "text": "Go behind the house and pick up a doogle leaf.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "the-secret-hideout",
