      "anchor": "The_secret_hideout",
      "blocks": [
        {
          "type": "step",
          "id": "the-secret-hideout:16exygh",
          "html": "Go to the northeastern corner of <a href=\"https://runescape.wiki/w/Varrock_Square\" target=\"_blank\" rel=\"noopener\">Varrock Square</a>.",
          "text": "Go to the northeastern corner of Varrock Square.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-secret-hideout:1nwyzlg",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Shilop\" target=\"_blank\" rel=\"noopener\">Shilop</a> or <a href=\"https://runescape.wiki/w/Wilough\" target=\"_blank\" rel=\"noopener\">Wilough</a>, giving them 100 coins.",
          "text": "Talk to Shilop or Wilough, giving them 100 coins.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "What will make you tell me?"
                },
                {
                  "key": "2",
                  "text": "Okay then, I'll pay."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-secret-hideout:ygbim",
          "html": "Go south-west to an abandoned house between the Smithing workshop and the tanner, near the west wall of Varrock.",
          "text": "Go south-west to an abandoned house between the Smithing workshop and the tanner, near the west wall of Varrock.",
          "dialogue": [],
          "images": [],
