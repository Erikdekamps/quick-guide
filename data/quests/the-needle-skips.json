        {
          "type": "step",
          "id": "starting-out:dyxujb",
          "html": "Start off using the <a href=\"https://runescape.wiki/w/Fairy_ring\" target=\"_blank\" rel=\"noopener\">fairy ring</a> code <b>A</b><b>K</b><b>Q</b> or a <a href=\"https://runescape.wiki/w/Phoenix_Lair_Teleport\" target=\"_blank\" rel=\"noopener\">Phoenix Lair Teleport</a> scroll. You can also use the teleport from the <a href=\"https://runescape.wiki/w/Memory_strand\" target=\"_blank\" rel=\"noopener\">memory strand</a> in the currency pouch. Alternatively, teleport to <a href=\"https://runescape.wiki/w/Eagles%27_Peak_lodestone\" target=\"_blank\" rel=\"noopener\">Eagles&#39; Peak lodestone</a> and run north then west.",
          "text": "Start off using the fairy ring code AKQ or a Phoenix Lair Teleport scroll. You can also use the teleport from the memory strand in the currency pouch. Alternatively, teleport to Eagles' Peak lodestone and run north then west.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:1h49nx7",
          "html": "Run west of the <a href=\"https://runescape.wiki/w/Piscatoris_Fishing_Colony\" target=\"_blank\" rel=\"noopener\">Piscatoris Fishing Colony</a> until you find a house.",
          "text": "Run west of the Piscatoris Fishing Colony until you find a house.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:1j2wi8o",
          "html": "Cross the water eastward over the rocks and go east to search <a href=\"https://runescape.wiki/w/The_Needle\" target=\"_blank\" rel=\"noopener\">the Needle</a>.",
          "text": "Cross the water eastward over the rocks and go east to search the Needle.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:n6annd",
          "html": "<i>Search</i> the Needle to obtain the <a href=\"https://runescape.wiki/w/Shard_of_the_needle\" target=\"_blank\" rel=\"noopener\">shard of the needle</a>.",
          "text": "Search the Needle to obtain the shard of the needle.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:1s5eii9",
          "html": "After the cutscene, <i>investigate</i> the <a href=\"https://runescape.wiki/w/Mysterious_body\" target=\"_blank\" rel=\"noopener\">mysterious body</a> on the ground.",
          "text": "After the cutscene, investigate the mysterious body on the ground.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
