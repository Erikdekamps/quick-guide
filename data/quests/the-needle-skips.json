    {
      "id": "the-finale",
      "title": "The finale",
      "anchor": "The_finale",
      "blocks": [
        {
          "type": "step",
          "id": "the-finale:y7bf8u",
          "html": "Run back towards the house and harvest the buckthorn bush near the river.",
          "text": "Run back towards the house and harvest the buckthorn bush near the river.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-finale:ej7rmw",
          "html": "Grind and crush both the <a href=\"https://runescape.wiki/w/Buckthorn_leaf\" target=\"_blank\" rel=\"noopener\">leaf</a> and <a href=\"https://runescape.wiki/w/Buckthorn_berry\" target=\"_blank\" rel=\"noopener\">berry</a>.",
          "text": "Grind and crush both the leaf and berry.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-finale:1k12i6",
          "html": "Go upstairs in the house and give <a href=\"https://runescape.wiki/w/Primrose\" target=\"_blank\" rel=\"noopener\">Primrose</a> the smelling salts.",
          "text": "Go upstairs in the house and give Primrose the smelling salts.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-finale:17xw1c5",
          "html": "Go back downstairs, search the bookcase to the north-east.",
          "text": "Go back downstairs, search the bookcase to the north-east.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-finale:sfqdse",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Megan\" target=\"_blank\" rel=\"noopener\">Megan</a> and name the demon &#39;Metum&#39;.",
          "text": "Talk to Megan and name the demon 'Metum'.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Name the demon"
                },
                {
                  "key": "?",
                  "text": "Metum"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-finale:593mx5",
          "html": "Use the <a href=\"https://runescape.wiki/w/Bottle_of_crushed_berries\" target=\"_blank\" rel=\"noopener\">bottle of crushed berries</a> on the stove on the west side of the house.",
          "text": "Use the bottle of crushed berries on the stove on the west side of the house.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-finale:1m829sx",
          "html": "Return back to the Needle and use the <a href=\"https://runescape.wiki/w/Buckthorn_salve\" target=\"_blank\" rel=\"noopener\">buckthorn salve</a> on <a href=\"https://runescape.wiki/w/Gail\" target=\"_blank\" rel=\"noopener\">Gail</a>. Finish the dialogue and you will be teleported back to the house.",
          "text": "Return back to the Needle and use the buckthorn salve on Gail. Finish the dialogue and you will be teleported back to the house.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-finale:1lb6srv",
          "html": "Finish the dialogue with Megan and go back to the Needle and pick up the <a href=\"https://runescape.wiki/w/Note_from_gail\" target=\"_blank\" rel=\"noopener\">note from gail</a>.",
          "text": "Finish the dialogue with Megan and go back to the Needle and pick up the note from gail.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-finale:119hb6h",
          "html": "Read the note then return to Megan inside the house.",
          "text": "Read the note then return to Megan inside the house.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
