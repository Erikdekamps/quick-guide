        {
          "type": "step",
          "id": "cleansing-the-gate-of-elidinis:1ttksch",
          "html": "Receive blessing on the <a href=\"https://runescape.wiki/w/Idol_of_Amascut\" target=\"_blank\" rel=\"noopener\">idol of Amascut</a> or the <a href=\"https://runescape.wiki/w/Shard_of_the_Gate\" target=\"_blank\" rel=\"noopener\">shard of the Gate</a>.",
