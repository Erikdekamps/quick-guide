  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "map",
          "caption": "Location of Mort'ton",
          "lat": 3287,
          "lon": 3491,
          "zoom": 2,
          "plane": 0,
          "mapId": 28,
          "version": "2026-10-12-a",
          "features": [],
          "href": "https://runescape.wiki/w/Shades_of_Mort'ton/Quick_guide"
        },
        {
          "type": "step",
          "id": "getting-started:i74rxw",
          "html": "Enter the south-western ruined house in <a href=\"https://runescape.wiki/w/Mort%27ton\" target=\"_blank\" rel=\"noopener\">Mort&#39;ton</a>.",
          "text": "Enter the south-western ruined house in Mort'ton.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:i74rxw:1ca6cqe",
              "html": "Teleport to <a href=\"https://runescape.wiki/w/Canifis\" target=\"_blank\" rel=\"noopener\">Canifis</a> and run south-west to the gate of the swamp (must have <a href=\"https://runescape.wiki/w/Nature_Spirit\" target=\"_blank\" rel=\"noopener\">Nature Spirit</a> quest started), and then head to Mort&#39;ton.",
              "text": "Teleport to Canifis and run south-west to the gate of the swamp (must have Nature Spirit quest started), and then head to Mort'ton.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "getting-started:i74rxw:147as0s",
              "html": "Teleport to fairy ring <b>B</b><b>K</b><b>R</b> and then run south by south-east to where the map says the Hollows, to find a rowboat that takes you there.",
              "text": "Teleport to fairy ring BKR and then run south by south-east to where the map says the Hollows, to find a rowboat that takes you there.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "getting-started:i74rxw:ptn643",
              "html": "Alternatively use <a href=\"https://runescape.wiki/w/Drakan%27s_medallion\" target=\"_blank\" rel=\"noopener\">Drakan&#39;s medallion</a> to teleport to the <a href=\"https://runescape.wiki/w/Barrows\" target=\"_blank\" rel=\"noopener\">Barrows</a> and run west.",
              "text": "Alternatively use Drakan's medallion to teleport to the Barrows and run west.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:14hxxbn",
          "html": "Search the <a href=\"https://runescape.wiki/w/Shelf_(Shades_of_Mort%27ton)\" target=\"_blank\" rel=\"noopener\">shelf</a> on the wall and read the <a href=\"https://runescape.wiki/w/Diary_(Shades_of_Mort%27ton)\" target=\"_blank\" rel=\"noopener\">diary</a>.",
          "text": "Search the shelf on the wall and read the diary.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:14hxxbn:5y72j9",
              "html": "If you do not find it, it&#39;s probably already in your bank.",
              "text": "If you do not find it, it's probably already in your bank.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:1e0ni7x",
          "html": "(Optional) Chop three swamp trees nearby and burn two logs to get the ashes.",
          "text": "(Optional) Chop three swamp trees nearby and burn two logs to get the ashes.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:1e0ni7x:4bwv55",
              "html": "If you have an Underworld Grimoire equipped make sure to disable the auto-storage function, otherwise your ashes will be sent to the bank.",
              "text": "If you have an Underworld Grimoire equipped make sure to disable the auto-storage function, otherwise your ashes will be sent to the bank.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-started:405rxr",
          "html": "(Optional) Pick up the <a href=\"https://runescape.wiki/w/Vial\" target=\"_blank\" rel=\"noopener\">vials</a> (on the ground near the shelf) and search the <a href=\"https://runescape.wiki/w/Smashed_table\" target=\"_blank\" rel=\"noopener\">smashed table</a> for extra tarromin and one <a href=\"https://runescape.wiki/w/Grimy_rogue%27s_purse\" target=\"_blank\" rel=\"noopener\">grimy rogue&#39;s purse</a>.",
          "text": "(Optional) Pick up the vials (on the ground near the shelf) and search the smashed table for extra tarromin and one grimy rogue's purse.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "serum-207",
      "title": "Serum 207",
      "anchor": "Serum_207",
      "blocks": [
        {
          "type": "step",
          "id": "serum-207:17o07sc",
          "html": "Make vials of water by using the empty vials on the sink nearby.",
          "text": "Make vials of water by using the empty vials on the sink nearby.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:15douwy",
          "html": "Make <a href=\"https://runescape.wiki/w/Serum_207\" target=\"_blank\" rel=\"noopener\">Serum 207</a> by adding clean tarromin and ashes to a vial of water.",
          "text": "Make Serum 207 by adding clean tarromin and ashes to a vial of water.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:1ikd04",
          "html": "Use it on <a href=\"https://runescape.wiki/w/Razmire\" target=\"_blank\" rel=\"noopener\">Razmire</a> (afflicted) in the general store.",
          "text": "Use it on Razmire (afflicted) in the general store.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "4",
                  "text": "What are all these shadowy creatures?"
                },
                {
                  "key": "1",
                  "text": "Yes, I'll dispatch those dark and evil creatures."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:18czm9q",
          "html": "Kill five <a href=\"https://runescape.wiki/w/Loar_Shade\" target=\"_blank\" rel=\"noopener\">Loar Shades</a> and pick up their remains. Be sure to talk to Razmire first. They can be safespotted using the rocks south west of the waypost in the middle of town.",
          "text": "Kill five Loar Shades and pick up their remains. Be sure to talk to Razmire first. They can be safespotted using the rocks south west of the waypost in the middle of town.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:lrtr3r",
          "html": "Give him the remains. He may require more Serum 207.",
          "text": "Give him the remains. He may require more Serum 207.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:mnjix9",
          "html": "Use the serum on <a href=\"https://runescape.wiki/w/Ulsquire_Shauncy\" target=\"_blank\" rel=\"noopener\">Ulsquire Shauncy</a>, located in the house east of the general store.",
          "text": "Use the serum on Ulsquire Shauncy, located in the house east of the general store.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:69472v",
          "html": "Wait a minute and ask him about the remains and the temple.",
          "text": "Wait a minute and ask him about the remains and the temple.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What did you find out about the remains?"
                },
                {
                  "key": "2",
                  "text": "What can you tell me about that temple?"
                },
                {
                  "key": "5",
                  "text": "Ok, thanks."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:1y7yz88",
          "html": "Talk to Razmire.",
          "text": "Talk to Razmire.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I have another question."
                },
                {
                  "key": "2",
                  "text": "What can you tell me about that temple?"
                },
                {
                  "key": "4",
                  "text": "Can you open a store for me?"
                },
                {
                  "key": "1",
                  "text": "Can I see the general store please?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:76bi86",
          "html": "Buy at least one olive oil from his general store and optionally a <a href=\"https://runescape.wiki/w/Flamtaer_hammer\" target=\"_blank\" rel=\"noopener\">Flamtaer hammer</a>.",
          "text": "Buy at least one olive oil from his general store and optionally a Flamtaer hammer.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:5tbz15",
          "html": "Open his builders&#39; store.",
          "text": "Open his builders' store.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "serum-207:1b7tvji",
          "html": "Buy 5 timber beams, 5 limestone bricks, 25 swamp paste.",
          "text": "Buy 5 timber beams, 5 limestone bricks, 25 swamp paste.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "repairing-the-temple",
      "title": "Repairing the temple",
      "anchor": "Repairing_the_temple",
      "blocks": [
        {
          "type": "step",
          "id": "repairing-the-temple:3p7tl2",
          "html": "Hop to World 88 which is the official world for this minigame.",
          "text": "Hop to World 88 which is the official world for this minigame.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "repairing-the-temple:19zwfoe",
          "html": "Head north-east and kill shades or repair the temple to increase your sanctity.",
          "text": "Head north-east and kill shades or repair the temple to increase your sanctity.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "repairing-the-temple:1jl8cue",
          "html": "Repair the temple until you reach 100% and at least 20 sanctity.",
          "text": "Repair the temple until you reach 100% and at least 20 sanctity.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "repairing-the-temple:138nzy2",
          "html": "Light the sacred altar in the centre of the temple.",
          "text": "Light the sacred altar in the centre of the temple.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "repairing-the-temple:88poux",
          "html": "<b>For solo questers:</b> <a href=\"https://runescape.wiki/w/Shade_luring_dummy\" target=\"_blank\" rel=\"noopener\">Shade luring dummies</a> can be used to distract the <a href=\"https://runescape.wiki/w/Loar_Shade\" target=\"_blank\" rel=\"noopener\">Loar Shades</a> when repairing the temple. Using the <a href=\"https://runescape.wiki/w/Flamtaer_bracelet\" target=\"_blank\" rel=\"noopener\">Flamtaer bracelet</a>, the solo player can instantly create the temple walls section by section, until at 100%.",
          "text": "For solo questers: Shade luring dummies can be used to distract the Loar Shades when repairing the temple. Using the Flamtaer bracelet, the solo player can instantly create the temple walls section by section, until at 100%.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "repairing-the-temple:16f6a0y",
          "html": "Use your olive oil on the flame to make <a href=\"https://runescape.wiki/w/Sacred_oil\" target=\"_blank\" rel=\"noopener\">sacred oil</a>.",
          "text": "Use your olive oil on the flame to make sacred oil.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "repairing-the-temple:1momzo8",
          "html": "(Optional) Use Serum 207 on the flame to make <a href=\"https://runescape.wiki/w/Serum_208\" target=\"_blank\" rel=\"noopener\">Serum 208</a>, which permanently cures NPCs.",
          "text": "(Optional) Use Serum 207 on the flame to make Serum 208, which permanently cures NPCs.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "repairing-the-temple:silpk1",
          "html": "(Optional) Use the <a href=\"https://runescape.wiki/w/Serum_208\" target=\"_blank\" rel=\"noopener\">Serum 208</a> on <a href=\"https://runescape.wiki/w/Razmire_Keelgan\" target=\"_blank\" rel=\"noopener\">Razmire</a> and <a href=\"https://runescape.wiki/w/Ulsquire_Shauncy\" target=\"_blank\" rel=\"noopener\">Ulsquire</a> in the houses nearby to permanently cure them.",
          "text": "(Optional) Use the Serum 208 on Razmire and Ulsquire in the houses nearby to permanently cure them.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "burning-a-shade",
      "title": "Burning a shade",
      "anchor": "Burning_a_shade",
      "blocks": [
        {
          "type": "step",
          "id": "burning-a-shade:4t3ri1",
          "html": "Use the sacred oil on a log to create a <a href=\"https://runescape.wiki/w/Pyre_log\" target=\"_blank\" rel=\"noopener\">pyre log</a>.",
          "text": "Use the sacred oil on a log to create a pyre log.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "burning-a-shade:7e5pk9",
          "html": "Head to south-western Mort&#39;ton to the Funeral Fires (do not cross the river to the west). The Funeral Fires appear as black crosshairs on the minimap on the western part of the Mort&#39;ton.",
          "text": "Head to south-western Mort'ton to the Funeral Fires (do not cross the river to the west). The Funeral Fires appear as black crosshairs on the minimap on the western part of the Mort'ton.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "burning-a-shade:148l22i",
          "html": "Use the Pyre Log to light the fire, then use the Loar Remains to sacrifice them on the <a href=\"https://runescape.wiki/w/Funeral_pyre\" target=\"_blank\" rel=\"noopener\">funeral pyre</a>.",
          "text": "Use the Pyre Log to light the fire, then use the Loar Remains to sacrifice them on the funeral pyre.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "burning-a-shade:1bwr5qw",
          "html": "Talk to Ulsquire.",
          "text": "Talk to Ulsquire.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "burning-a-shade:fvxipr",
          "html": "Quest complete!",
          "text": "Quest complete!",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    }
