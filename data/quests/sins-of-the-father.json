        {
          "type": "step",
          "id": "getting-started:14txpx5",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Mr_Mordaut\" target=\"_blank\" rel=\"noopener\">Mr Mordaut</a> at the <a href=\"https://runescape.wiki/w/Anachronia_base_camp\" target=\"_blank\" rel=\"noopener\">Anachronia base camp</a>.",
