        {
          "type": "step",
          "id": "a-little-game:1wqge9a",
          "html": "A game of modified conquest must be played and won.",
          "text": "A game of modified conquest must be played and won.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "a-little-game:1wqge9a:1c8rl1b",
              "html": "Spinners are very powerful but do not heal like in <a href=\"https://runescape.wiki/w/Pest_Control\" target=\"_blank\" rel=\"noopener\">Pest Control</a>.",
              "text": "Spinners are very powerful but do not heal like in Pest Control.",
