    {
      "id": "the-pest-queen",
      "title": "The Pest Queen",
      "anchor": "The_Pest_Queen",
      "blocks": [
        {
          "type": "step",
          "id": "the-pest-queen:14dvsnh",
          "html": "Sacrifice either Korasi or <a href=\"https://runescape.wiki/w/Jessika\" target=\"_blank\" rel=\"noopener\">Jessika</a>.",
          "text": "Sacrifice either Korasi or Jessika.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-pest-queen:iflnm5",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Valluta\" target=\"_blank\" rel=\"noopener\">Valluta</a> before stocking for the fight or Sir Tiffy won&#39;t teleport you back.",
          "text": "Speak to Valluta before stocking for the fight or Sir Tiffy won't teleport you back.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "the-pest-queen:c9w56m",
          "html": "Make all necessary preparations to fight the <a href=\"https://runescape.wiki/w/Pest_Queen\" target=\"_blank\" rel=\"noopener\">Pest Queen</a>. <a href=\"https://runescape.wiki/w/Korasi%27s_sword\" target=\"_blank\" rel=\"noopener\">Korasi&#39;s sword</a> will be the primary weapon during the fight and its <a href=\"https://runescape.wiki/w/Special_attack\" target=\"_blank\" rel=\"noopener\">Special attacks</a> will be used a lot.",
          "text": "Make all necessary preparations to fight the Pest Queen. Korasi's sword will be the primary weapon during the fight and its Special attacks will be used a lot.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-pest-queen:c9w56m:z953io",
              "html": "It may be helpful to use manual attack abilities rather than Revolution.",
              "text": "It may be helpful to use manual attack abilities rather than Revolution.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "the-pest-queen:c9w56m:1ud4ee5",
              "html": "You can use necromancy to trivialise the encounter. Summon conjures prior to equipping Korasi&#39;s sword, and keep your necromancy offhand equipped. Ghost will provide full sustain without food, and skeleton will do the majority of the damage.",
              "text": "You can use necromancy to trivialise the encounter. Summon conjures prior to equipping Korasi's sword, and keep your necromancy offhand equipped. Ghost will provide full sustain without food, and skeleton will do the majority of the damage.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "the-pest-queen:cb9bcu",
          "html": "Kill the Pest Queen.",
          "text": "Kill the Pest Queen.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "the-pest-queen:cb9bcu:16cdpiu",
              "html": "The <a href=\"https://runescape.wiki/w/Weapon_Special_attack\" target=\"_blank\" rel=\"noopener\">Weapon Special attack</a> is located under <a href=\"https://runescape.wiki/w/Constitution\" target=\"_blank\" rel=\"noopener\">Constitution</a> abilities.",
              "text": "The Weapon Special attack is located under Constitution abilities.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "the-pest-queen:cb9bcu:dik98i",
              "html": "If you die, talk to <a href=\"https://runescape.wiki/w/Sir_Tiffy\" target=\"_blank\" rel=\"noopener\">Sir Tiffy</a> in <a href=\"https://runescape.wiki/w/Falador_park\" target=\"_blank\" rel=\"noopener\">Falador park</a> and he will teleport you back to the portal. You will lose the weapon if you die. Reclaim this from Jessika/Korasi before you attack the Pest Queen again.",
              "text": "If you die, talk to Sir Tiffy in Falador park and he will teleport you back to the portal. You will lose the weapon if you die. Reclaim this from Jessika/Korasi before you attack the Pest Queen again.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "3",
                      "text": ""
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "the-pest-queen:cb9bcu:4wdsg9",
              "html": "Build your adrenaline up more than 60% then use the special attack &quot;Disrupt&quot; to stun the Pest Queen when she raises her head and starts shaking for several seconds.",
              "text": "Build your adrenaline up more than 60% then use the special attack \"Disrupt\" to stun the Pest Queen when she raises her head and starts shaking for several seconds.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "the-pest-queen:cb9bcu:70kclw",
              "html": "Hurt but don&#39;t kill the spawning <a href=\"https://runescape.wiki/w/Elite_defiler\" target=\"_blank\" rel=\"noopener\">Elite defilers</a> to defend <a href=\"https://runescape.wiki/w/Void_Knight_archer\" target=\"_blank\" rel=\"noopener\">Void Knight archers</a>. They need to be focussed on you so more don&#39;t respawn and so they don&#39;t hurt your archers.",
              "text": "Hurt but don't kill the spawning Elite defilers to defend Void Knight archers. They need to be focussed on you so more don't respawn and so they don't hurt your archers.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "the-pest-queen:cb9bcu:jcz79f",
              "html": "More in-depth strategies can be found <a href=\"https://runescape.wiki/w/Pest_Queen/Strategies#The_Void_Stares_Back\" target=\"_blank\" rel=\"noopener\">here</a>.",
              "text": "More in-depth strategies can be found here.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
