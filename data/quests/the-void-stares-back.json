            },
            {
              "type": "step",
              "id": "a-little-game:1wqge9a:1tvkmkt",
              "html": "Ravagers have the movement range of Scouts and the damage rate of a Knight.",
              "text": "Ravagers have the movement range of Scouts and the damage rate of a Knight.",
              "dialogue": [],
              "images": [],
              "tables": [],
