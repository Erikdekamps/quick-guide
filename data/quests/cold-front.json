          "recommended": []
        },
        {
          "type": "step",
          "id": "finding-the-perfect-materials:1cxcmq",
          "html": "Use the chisel of conditional worth on the coal and make five pieces of <a href=\"https://runescape.wiki/w/%27Perfect%27_coal\" target=\"_blank\" rel=\"noopener\">&#39;perfect&#39; coal</a>.",
          "text": "Use the chisel of conditional worth on the coal and make five pieces of 'perfect' coal.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "finding-the-perfect-materials:1f0qbhw",
          "html": "Take 20 <a href=\"https://runescape.wiki/w/Carrot_(Cold_Front)\" target=\"_blank\" rel=\"noopener\">carrots</a> from the <a href=\"https://runescape.wiki/w/Bucket_o%27_carrots_(Cold_Front)\" target=\"_blank\" rel=\"noopener\">bucket o&#39; carrots</a> near the <a href=\"https://runescape.wiki/w/Hungry_reindeer\" target=\"_blank\" rel=\"noopener\">hungry reindeer</a> on the south-western wall outside of <a href=\"https://runescape.wiki/w/Diango%27s_Workshop\" target=\"_blank\" rel=\"noopener\">Diango&#39;s Workshop</a>.",
          "text": "Take 20 carrots from the bucket o' carrots near the hungry reindeer on the south-western wall outside of Diango's Workshop.",
          "dialogue": [],
