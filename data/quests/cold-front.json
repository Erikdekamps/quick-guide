            {
              "id": "finding-the-perfect-materials:bring:mnk95",
              "html": "<a href=\"https://runescape.wiki/w/Chisel_of_conditional_worth\" target=\"_blank\" rel=\"noopener\">Chisel of conditional worth</a> and 25 <a href=\"https://runescape.wiki/w/Coal\" target=\"_blank\" rel=\"noopener\">coal</a>",
