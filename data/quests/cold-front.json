    {
      "id": "constructing-the-perfect-snowman",
      "title": "Constructing the perfect snowman",
      "anchor": "Constructing_the_perfect_snowman",
      "blocks": [
        {
          "type": "step",
          "id": "constructing-the-perfect-snowman:1adkrdy",
          "html": "Make a snowball with one of the <a href=\"https://runescape.wiki/w/Pile_of_snow_(Cold_Front)\" target=\"_blank\" rel=\"noopener\">piles of snow</a> and push it to the marked spot at the top of the hill. The snowball needs to be pushed so that it becomes a <a href=\"https://runescape.wiki/w/Large_snowball\" target=\"_blank\" rel=\"noopener\">large snowball</a> precisely when reaching the reticule on the top of the hill, requiring a total of eight pushes.",
          "text": "Make a snowball with one of the piles of snow and push it to the marked spot at the top of the hill. The snowball needs to be pushed so that it becomes a large snowball precisely when reaching the reticule on the top of the hill, requiring a total of eight pushes.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "~",
                  "text": "[Any option]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "constructing-the-perfect-snowman:1adkrdy:197fory",
              "html": "You can&#39;t push diagonally, nor south from under the <a href=\"https://runescape.wiki/w/Queen_of_Snow\" target=\"_blank\" rel=\"noopener\">Queen of Snow</a>.",
              "text": "You can't push diagonally, nor south from under the Queen of Snow.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "constructing-the-perfect-snowman:1adkrdy:1nhlkfj",
              "html": "At any point, you can break the snowball down, and the pile of snow will reappear in the spot where you broke it down.",
              "text": "At any point, you can break the snowball down, and the pile of snow will reappear in the spot where you broke it down.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "constructing-the-perfect-snowman:t7sx4s",
          "html": "Repeat with another pile of snow to make an <a href=\"https://runescape.wiki/w/Enormous_snowball\" target=\"_blank\" rel=\"noopener\">enormous snowball</a> positioned next to the large snowball, requiring a total of 10 pushes.",
          "text": "Repeat with another pile of snow to make an enormous snowball positioned next to the large snowball, requiring a total of 10 pushes.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "constructing-the-perfect-snowman:ew4z7t",
          "html": "Repeat with the remaining pile of snow to make an <a href=\"https://runescape.wiki/w/Average_snowball\" target=\"_blank\" rel=\"noopener\">average snowball</a> positioned next to the previous snowballs, requiring a total of five pushes.",
          "text": "Repeat with the remaining pile of snow to make an average snowball positioned next to the previous snowballs, requiring a total of five pushes.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "constructing-the-perfect-snowman:xjqqjy",
          "html": "Continue through the dialogue.",
          "text": "Continue through the dialogue.",
          "dialogue": [
