        {
          "type": "step",
          "id": "getting-started:1lku6nz",
          "html": "Enter the ruins beneath the <a href=\"https://runescape.wiki/w/Wizards%27_Tower\" target=\"_blank\" rel=\"noopener\">Wizards&#39; Tower</a>.",
          "text": "Enter the ruins beneath the Wizards' Tower.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1vyw6ue",
          "html": "Pass through the first door, cross the fallen statue then pass through the second door. In the ruins and talk to <a href=\"https://runescape.wiki/w/Ariane\" target=\"_blank\" rel=\"noopener\">Ariane</a>.",
          "text": "Pass through the first door, cross the fallen statue then pass through the second door. In the ruins and talk to Ariane.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "What do you need help with?"
                },
                {
                  "key": "2",
                  "text": "I'd be happy to help."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "3",
                  "text": "How can I get you out?"
                },
                {
                  "key": "3",
                  "text": "Okay, what do you want me to do?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:3j5zj1",
          "html": "Use the <a href=\"https://runescape.wiki/w/Prepared_fire_rune\" target=\"_blank\" rel=\"noopener\">prepared fire rune</a> on a red vortex and the <a href=\"https://runescape.wiki/w/Prepared_air_rune\" target=\"_blank\" rel=\"noopener\">prepared air rune</a> on a grey vortex.",
          "text": "Use the prepared fire rune on a red vortex and the prepared air rune on a grey vortex.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:18qvf9u",
