          "type": "step",
          "id": "walkthrough:10pd1y2",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Malignius_Mortifer\" target=\"_blank\" rel=\"noopener\">Malignius Mortifer</a> next to the ritual site.",
          "text": "Talk to Malignius Mortifer next to the ritual site.",
