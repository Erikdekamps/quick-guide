            {
              "type": "step",
              "id": "the-games:194u3zg:1pqzqcq",
              "html": "First choice.",
              "text": "First choice.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "3",
                      "text": "I think Ahrim should go left."
                    },
                    {
                      "key": "1",
                      "text": "You'd let someone else be hurt?"
                    },
                    {
                      "key": "2",
                      "text": "That's no reason to hurt someone else."
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "the-games:194u3zg:1w5qncu",
              "html": "Second choice.",
              "text": "Second choice.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "3",
                      "text": "I think Ahrim should be hurt."
                    },
                    {
                      "key": "1",
                      "text": "Then suffer now so it won't be as bad later."
                    },
                    {
                      "key": "3",
                      "text": "Think about the innocents Ahrim."
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "the-games:194u3zg:6sktsl",
              "html": "Third choice.",
              "text": "Third choice.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "3",
                      "text": "I think Ahrim should be hurt."
                    },
                    {
                      "key": "2",
                      "text": "It's more practical to hurt you."
                    },
                    {
                      "key": "3",
                      "text": "Sliske won't kill you, he wants you at the end."
                    }
                  ]
