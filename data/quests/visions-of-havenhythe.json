        {
          "type": "step",
          "id": "call-of-the-great-wolf:1j9obkl",
          "html": "Head east towards the city of <a href=\"https://runescape.wiki/w/Wendlewick\" target=\"_blank\" rel=\"noopener\">Wendlewick</a>, then speak to <a href=\"https://runescape.wiki/w/Adam\" target=\"_blank\" rel=\"noopener\">Adam</a> in the building north of the <a href=\"https://runescape.wiki/w/Well\" target=\"_blank\" rel=\"noopener\">well</a> in the centre of the village.",
          "text": "Head east towards the city of Wendlewick, then speak to Adam in the building north of the well in the centre of the village.",
