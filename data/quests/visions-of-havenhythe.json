        {
          "type": "step",
          "id": "building-along-the-coast:3d2lnp",
          "html": "Go back downstairs, walk north, and build at the <a href=\"https://runescape.wiki/w/Lodestone_hotspot\" target=\"_blank\" rel=\"noopener\">Lodestone hotspot</a> just across the river.",
