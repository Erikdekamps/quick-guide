        {
          "type": "step",
          "id": "building-along-the-coast:1m3wde0",
          "html": "Head west to the beach and kill 10 <a href=\"https://runescape.wiki/w/Juvenile_boulder_crab\" target=\"_blank\" rel=\"noopener\">juvenile boulder crab</a>. Pick up the <a href=\"https://runescape.wiki/w/Limestone\" target=\"_blank\" rel=\"noopener\">limestone</a> they drop.",
          "text": "Head west to the beach and kill 10 juvenile boulder crab. Pick up the limestone they drop.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "building-along-the-coast:1m3wde0:163i2q",
              "html": "You must kill the crabs, but you can bring your own limestone bricks to Zeke.",
              "text": "You must kill the crabs, but you can bring your own limestone bricks to Zeke.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "building-along-the-coast:1crfutt",
          "html": "Return to Zeke.",
          "text": "Return to Zeke.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "building-along-the-coast:1crfutt:14llgzx",
              "html": "If you do not have level 12 <a href=\"https://runescape.wiki/w/Crafting\" target=\"_blank\" rel=\"noopener\">Crafting</a>, now it is time to give the limestone to Adam so that he can turn those limestone into bricks.",
              "text": "If you do not have level 12 Crafting, now it is time to give the limestone to Adam so that he can turn those limestone into bricks.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "building-along-the-coast:1crfutt:i2580v",
              "html": "If you want to convert them yourself and have the skill to do it, you may do so now.",
              "text": "If you want to convert them yourself and have the skill to do it, you may do so now.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
