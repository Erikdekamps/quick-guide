        {
          "type": "step",
          "id": "building-along-the-coast:q6ini9",
          "html": "Run south across the first bridge, through the lighthouse and out the back door. From the outside go up the stairs.",
          "text": "Run south across the first bridge, through the lighthouse and out the back door. From the outside go up the stairs.",
          "dialogue": [],
