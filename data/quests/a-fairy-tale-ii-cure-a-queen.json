  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:1c03wj5",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Martin_the_Master_Gardener\" target=\"_blank\" rel=\"noopener\">Martin the Master Gardener</a> in the <a href=\"https://runescape.wiki/w/Draynor_Market\" target=\"_blank\" rel=\"noopener\">Draynor Market</a>.",
          "text": "Talk to Martin the Master Gardener in the Draynor Market.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Talk about farming problems and fairies."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:8q0dyq",
          "html": "After around 5-6 minutes have elapsed, talk to him again.",
          "text": "After around 5-6 minutes have elapsed, talk to him again.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I suppose I'd better go and see what the problem is, then."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:13i432",
          "html": "Go to <a href=\"https://runescape.wiki/w/Fairy_Nuff\" target=\"_blank\" rel=\"noopener\">Fairy Nuff</a>&#39;s house, north of the <a href=\"https://runescape.wiki/w/Zanaris_bank\" target=\"_blank\" rel=\"noopener\">Zanaris bank</a>, and wait for a cutscene to play.",
          "text": "Go to Fairy Nuff's house, north of the Zanaris bank, and wait for a cutscene to play.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:5umsyk",
          "html": "Enter the house and take Nuff&#39;s <a href=\"https://runescape.wiki/w/Healing_certificate\" target=\"_blank\" rel=\"noopener\">healing certificate</a> from the floor in the south-east corner. Keep this in your inventory throughout the quest.",
          "text": "Enter the house and take Nuff's healing certificate from the floor in the south-east corner. Keep this in your inventory throughout the quest.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1i7las0",
          "html": "<i>Study</i> <a href=\"https://runescape.wiki/w/Nuff%27s_certificate\" target=\"_blank\" rel=\"noopener\">Nuff&#39;s certificate</a> (using <i>read</i> will not allow you to reach the Fairy Resistance HQ).",
          "text": "Study Nuff's certificate (using read will not allow you to reach the Fairy Resistance HQ).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:kmy3fa",
          "html": "Head south and read the rune temple sign, on the ground south of the <a href=\"https://runescape.wiki/w/Cosmic_altar\" target=\"_blank\" rel=\"noopener\">cosmic altar</a>.",
          "text": "Head south and read the rune temple sign, on the ground south of the cosmic altar.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1dfvelm",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Fairy_Godfather\" target=\"_blank\" rel=\"noopener\">Fairy Godfather</a> (located in the Throne Room) about the Queen&#39;s disappearance.",
          "text": "Talk to the Fairy Godfather (located in the Throne Room) about the Queen's disappearance.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Where is the Fairy Queen?"
                },
                {
                  "key": "1",
                  "text": "Do you have any idea who could have done this?"
                },
                {
                  "key": "1",
                  "text": "Yes, okay."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1n2ahe5",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Co-ordinator\" target=\"_blank\" rel=\"noopener\">co-ordinator</a> (located north of the Fairy Godfather) prior to using fairy rings to learn how to use them.",
          "text": "Talk to the co-ordinator (located north of the Fairy Godfather) prior to using fairy rings to learn how to use them.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
