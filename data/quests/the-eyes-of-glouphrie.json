    {
      "id": "elven-mystery",
      "title": "Elven Mystery",
      "anchor": "Elven_Mystery",
      "blocks": [
        {
          "type": "step",
          "id": "elven-mystery:ygp7wf",
          "html": "Inspect the singing bowl in the western portion of the cave.",
          "text": "Inspect the singing bowl in the western portion of the cave.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "elven-mystery:5itq9i",
          "html": "To the north, attempt to unlock <a href=\"https://runescape.wiki/w/Oaknock%27s_machine\" target=\"_blank\" rel=\"noopener\">Oaknock&#39;s machine</a> and use <a href=\"https://runescape.wiki/w/Oaknock%27s_exchanger\" target=\"_blank\" rel=\"noopener\">Oaknock&#39;s exchanger</a>.",
          "text": "To the north, attempt to unlock Oaknock's machine and use Oaknock's exchanger.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "elven-mystery:1vu9gsl",
          "html": "Talk to Brimstail.",
          "text": "Talk to Brimstail.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I've had a look in the other room now."
                },
                {
                  "key": "1",
                  "text": "Of course, I'd love to!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "memories",
      "title": "Memories",
      "anchor": "Memories",
      "blocks": [
        {
          "type": "step",
          "id": "memories:iu3w9k",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Hazelmere\" target=\"_blank\" rel=\"noopener\">Hazelmere</a> (island east of Yanille, fairy ring <b>C</b><b>L</b><b>S</b>) for several cutscenes. He provides you with a violet pentagon.",
          "text": "Talk to Hazelmere (island east of Yanille, fairy ring CLS) for several cutscenes. He provides you with a violet pentagon.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "memories:z9jely",
          "html": "Return and talk to Brimstail.",
          "text": "Return and talk to Brimstail.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I've visited Hazelmere, he told me all sorts of interesting things."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "incapacitated",
      "title": "Incapacitated",
      "anchor": "Incapacitated",
      "blocks": [
        {
          "type": "step",
          "id": "incapacitated:1o8gpzj",
          "html": "<i>Grind</i> <a href=\"https://runescape.wiki/w/Mud_rune\" target=\"_blank\" rel=\"noopener\">mud rune</a> and use on <a href=\"https://runescape.wiki/w/Bucket_of_sap\" target=\"_blank\" rel=\"noopener\">bucket of sap</a>.",
          "text": "Grind mud rune and use on bucket of sap.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "incapacitated:c0an21",
          "html": "Use the <a href=\"https://runescape.wiki/w/Magic_glue\" target=\"_blank\" rel=\"noopener\">magic glue</a> and a set of maple and oak logs on Oaknock&#39;s exchanger and <i>repair</i> it.",
          "text": "Use the magic glue and a set of maple and oak logs on Oaknock's exchanger and repair it.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "incapacitated:1vu9gsl",
          "html": "Talk to Brimstail.",
          "text": "Talk to Brimstail.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I think I've fixed the machine now!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "incapacitated:1lvdn3e",
          "html": "Talk to him again three or more times to receive more discs. You will need to drop all of your discs and pick them back up after chatting to receive more discs. The more discs, the more streamlined the process in the next step becomes as you require little to no converting.",
          "text": "Talk to him again three or more times to receive more discs. You will need to drop all of your discs and pick them back up after chatting to receive more discs. The more discs, the more streamlined the process in the next step becomes as you require little to no converting.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I can't work out what to do with these discs!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "machinery",
      "title": "Machinery",
      "anchor": "Machinery",
      "blocks": [
        {
          "type": "step",
          "id": "machinery:19wuaji",
          "html": "Unlock <a href=\"https://runescape.wiki/w/Oaknock%27s_machine\" target=\"_blank\" rel=\"noopener\">machine</a> to view the desired number.",
          "text": "Unlock machine to view the desired number.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "machinery:1bo1p36",
          "html": "If necessary, use the <a href=\"https://runescape.wiki/w/Oaknock%27s_exchanger\" target=\"_blank\" rel=\"noopener\">exchanger</a> to get a disc equal to your number (refer to conversion chart below, insert not more than 35 points at a time). If you have trouble converting, refer to the full guide <a href=\"https://runescape.wiki/w/The_Eyes_of_Glouphrie#Front_panel\" target=\"_blank\" rel=\"noopener\">here</a>.",
          "text": "If necessary, use the exchanger to get a disc equal to your number (refer to conversion chart below, insert not more than 35 points at a time). If you have trouble converting, refer to the full guide here.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "machinery:chfha7",
          "html": "Unlock the machine with the correct value disc. Click the small green square to submit the disc.",
          "text": "Unlock the machine with the correct value disc. Click the small green square to submit the disc.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "machinery:fayuef",
          "html": "Unlock the machine again to get 3 different numbers (the second unlock will require many more discs). Use the exchanger as necessary. The second number requires using 2 discs and the third requires 3 discs.",
          "text": "Unlock the machine again to get 3 different numbers (the second unlock will require many more discs). Use the exchanger as necessary. The second number requires using 2 discs and the third requires 3 discs.",
