  "sections": [
    {
      "id": "digression",
      "title": "Digression",
      "anchor": "Digression",
      "blocks": [
        {
          "type": "step",
          "id": "digression:1pjginv",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Brimstail\" target=\"_blank\" rel=\"noopener\">Brimstail</a> in a cave west of the bank in the Gnome Stronghold (View map). Look for dungeon link on minimap",
          "text": "Talk to Brimstail in a cave west of the bank in the Gnome Stronghold (View map). Look for dungeon link on minimap",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What's that cute creature wandering around?"
                },
                {
                  "key": "1",
                  "text": "Yes, that sounds fascinating..."
                },
                {
                  "key": "1",
                  "text": "Oh, yes I love a bit of History."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [
            {
