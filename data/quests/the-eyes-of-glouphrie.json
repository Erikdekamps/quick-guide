    {
      "id": "assassination",
      "title": "Assassination",
      "anchor": "Assassination",
      "blocks": [
        {
          "type": "step",
          "id": "assassination:1cmqamw",
          "html": "Kill the <a href=\"https://runescape.wiki/w/Evil_creature\" target=\"_blank\" rel=\"noopener\">evil creature</a> by Brimstail and talk to him again. <i>(1/6)</i>.",
          "text": "Kill the evil creature by Brimstail and talk to him again. (1/6).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "assassination:1lx19ii",
          "html": "Kill the 5 remaining evil creatures, which can be done in any order (View map):",
          "text": "Kill the 5 remaining evil creatures, which can be done in any order (View map):",
          "dialogue": [],
          "images": [
            {
              "type": "map",
              "caption": "View map",
              "lat": 3457,
              "lon": 2446,
              "zoom": 2,
              "plane": 0,
              "mapId": 28,
