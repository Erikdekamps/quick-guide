            }
          ],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "assassination:1lx19ii:1bm9ewb",
              "html": "<i>(2/6)</i> By the main gate to the stronghold (south-east from Brimstail&#39;s cave)",
              "text": "(2/6) By the main gate to the stronghold (south-east from Brimstail's cave)",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "assassination:1lx19ii:1jpb07g",
              "html": "<i>(3/6)</i> South of the spirit tree by the gnome agility course entrance.",
              "text": "(3/6) South of the spirit tree by the gnome agility course entrance.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "assassination:1lx19ii:1uj5kkn",
              "html": "<i>(4/6)</i> In the giant tortoise pen north-west of the Grand Tree and north of the swamp.",
              "text": "(4/6) In the giant tortoise pen north-west of the Grand Tree and north of the swamp.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "assassination:1lx19ii:1okcx4g",
              "html": "<i>(5/6)</i> Top floor of the Grand Tree, next to the small prison/by the ladder (wait for the chat response saying you killed it before using the ladder. If it doesn&#39;t count it, an evil creature should respawn at one of the locations.)",
              "text": "(5/6) Top floor of the Grand Tree, next to the small prison/by the ladder (wait for the chat response saying you killed it before using the ladder. If it doesn't count it, an evil creature should respawn at one of the locations.)",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "assassination:1lx19ii:1m0uxgp",
              "html": "<i>(6/6)</i> Near King Narnode (may need ranged, magic or necromancy as it can get stuck behind a trapdoor). Check your quest journal if your chat log does not display 6 creatures, if it says you need to talk to the king then you are finished.",
              "text": "(6/6) Near King Narnode (may need ranged, magic or necromancy as it can get stuck behind a trapdoor). Check your quest journal if your chat log does not display 6 creatures, if it says you need to talk to the king then you are finished.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "assassination:ykcrl8",
          "html": "Talk to King Narnode Shareen on the ground floor (UK) / 1<sup>st</sup> floor (US) of the Grand Tree.",
          "text": "Talk to King Narnode Shareen on the ground floor (UK) / 1st floor (US) of the Grand Tree.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
