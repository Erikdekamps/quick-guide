    {
      "id": "rescuing-the-miners",
      "title": "Rescuing the miners",
      "anchor": "Rescuing_the_miners",
      "blocks": [
        {
          "type": "step",
          "id": "rescuing-the-miners:92n62x",
          "html": "Free all 6 Lava-flow miners (they are all close to the entrance). <b>If you leave the scene</b> by exiting or teleporting, all progress made of rescuing the miners is lost.",
          "text": "Free all 6 Lava-flow miners (they are all close to the entrance). If you leave the scene by exiting or teleporting, all progress made of rescuing the miners is lost.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "rescuing-the-miners:92n62x:1i780o1",
              "html": "Mine the lighter coloured rubble surrounding them, then <i>rescue</i> them and they&#39;ll appear in your backpack. Only one <a href=\"https://runescape.wiki/w/Miner_(item)\" target=\"_blank\" rel=\"noopener\">Miner</a> can be carried at a time.",
              "text": "Mine the lighter coloured rubble surrounding them, then rescue them and they'll appear in your backpack. Only one Miner can be carried at a time.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "rescuing-the-miners:92n62x:43pjqt",
              "html": "Talk to <a href=\"https://runescape.wiki/w/Foreman_Jaak\" target=\"_blank\" rel=\"noopener\">Foreman Jaak</a> with one in your backpack, then move on to the next one.",
              "text": "Talk to Foreman Jaak with one in your backpack, then move on to the next one.",
