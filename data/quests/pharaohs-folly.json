              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "a-shifting-perspective:1b103dg:z3pd4y",
              "html": "<a href=\"https://runescape.wiki/w/Katarina\" target=\"_blank\" rel=\"noopener\">Katarina</a>",
              "text": "Katarina",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "a-shifting-perspective:1b103dg:11cs9nw",
              "html": "<a href=\"https://runescape.wiki/w/Shebit\" target=\"_blank\" rel=\"noopener\">Shebit</a>",
              "text": "Shebit",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "a-shifting-perspective:1b103dg:14e83p",
              "html": "<a href=\"https://runescape.wiki/w/Takhuit\" target=\"_blank\" rel=\"noopener\">Takhuit</a>",
              "text": "Takhuit",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:15e1z46",
          "html": "Mine crystalline corruption to obtain <a href=\"https://runescape.wiki/w/Crystal_shards_(Pharaoh%27s_Folly)\" target=\"_blank\" rel=\"noopener\">crystal shards</a>.",
          "text": "Mine crystalline corruption to obtain crystal shards.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:fulxjc",
          "html": "Search treasure chests to obtain <a href=\"https://runescape.wiki/w/Feathers_(Pharaoh%27s_Folly)\" target=\"_blank\" rel=\"noopener\">feathers</a>.",
          "text": "Search treasure chests to obtain feathers.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:1mc0snp",
          "html": "Smash urns to obtain a <a href=\"https://runescape.wiki/w/Gut_string\" target=\"_blank\" rel=\"noopener\">gut string</a>.",
          "text": "Smash urns to obtain a gut string.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:s0eypf",
          "html": "Search sarcophagi to obtain <a href=\"https://runescape.wiki/w/Mouldy_bandages\" target=\"_blank\" rel=\"noopener\">mouldy bandages</a>. To do this, click on the panels the energy bounces off in the order of which it started.",
          "text": "Search sarcophagi to obtain mouldy bandages. To do this, click on the panels the energy bounces off in the order of which it started.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:1g5dgsn",
          "html": "Use the gut string on the curved bone to create a <a href=\"https://runescape.wiki/w/Fragile_bow\" target=\"_blank\" rel=\"noopener\">fragile bow</a>.",
          "text": "Use the gut string on the curved bone to create a fragile bow.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:w9a37r",
          "html": "Use the feathers on the spare arrow shaft to create a <a href=\"https://runescape.wiki/w/Feathered_spare_arrow_shaft\" target=\"_blank\" rel=\"noopener\">feathered spare arrow shaft</a>.",
          "text": "Use the feathers on the spare arrow shaft to create a feathered spare arrow shaft.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:jcwu1d",
          "html": "Use the crystal shards on the feathered spare arrow shaft to make a <a href=\"https://runescape.wiki/w/Scrappy_arrow\" target=\"_blank\" rel=\"noopener\">scrappy arrow</a>.",
          "text": "Use the crystal shards on the feathered spare arrow shaft to make a scrappy arrow.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:1ahy6p0",
          "html": "Stand next to the arrow shafts where the exit rope was, then <i>fire arrow</i> with the bow in your backpack.",
          "text": "Stand next to the arrow shafts where the exit rope was, then fire arrow with the bow in your backpack.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:13zgn10",
          "html": "Exit the rope.",
          "text": "Exit the rope.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:1mwkye4",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Ozan\" target=\"_blank\" rel=\"noopener\">Ozan</a>.",
          "text": "Talk to Ozan.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "a-shifting-perspective:re3wjb",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Commander_Akhomet_(Imperial)\" target=\"_blank\" rel=\"noopener\">Commander Akhomet</a> outside the northern gates of <a href=\"https://runescape.wiki/w/Sophanem\" target=\"_blank\" rel=\"noopener\">Sophanem</a>.",
          "text": "Talk to Commander Akhomet outside the northern gates of Sophanem.",
          "dialogue": [
            {
              "when": null,
