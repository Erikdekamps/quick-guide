  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:13rxm3k",
          "html": "Talk to either NPC in the north eastern most building on the 1<sup>st</sup> floor (UK) / 2<sup>nd</sup> floor (US) of <a href=\"https://runescape.wiki/w/Dorgesh-Kaan\" target=\"_blank\" rel=\"noopener\">Dorgesh-Kaan</a>.",
          "text": "Talk to either NPC in the north eastern most building on the 1st floor (UK) / 2nd floor (US) of Dorgesh-Kaan.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-started:13rxm3k:11o5qi5",
              "html": "<a href=\"https://runescape.wiki/w/Ambassador_Alvijar\" target=\"_blank\" rel=\"noopener\">Ambassador Alvijar</a>",
              "text": "Ambassador Alvijar",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "✓",
                      "text": "[Accept Quest]"
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": [
                {
                  "type": "step",
                  "id": "getting-started:13rxm3k:11o5qi5:1idisry",
                  "html": "If Ambassador Alvijar says you might be a human spy, you haven&#39;t completed <a href=\"https://runescape.wiki/w/The_Giant_Dwarf\" target=\"_blank\" rel=\"noopener\">The Giant Dwarf</a> yet.",
                  "text": "If Ambassador Alvijar says you might be a human spy, you haven't completed The Giant Dwarf yet.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "getting-started:13rxm3k:11o5qi5:1jujfs6",
                  "html": "If you have just completed <a href=\"https://runescape.wiki/w/Death_to_the_Dorgeshuun\" target=\"_blank\" rel=\"noopener\">Death to the Dorgeshuun</a>, you may need to exit to the lobby and re-enter the game for him to appear.",
                  "text": "If you have just completed Death to the Dorgeshuun, you may need to exit to the lobby and re-enter the game for him to appear.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                }
              ]
            },
            {
              "type": "step",
              "id": "getting-started:13rxm3k:125vz47",
              "html": "<a href=\"https://runescape.wiki/w/Ur-Tag\" target=\"_blank\" rel=\"noopener\">Ur-Tag</a>",
              "text": "Ur-Tag",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "1",
                      "text": "What are you arguing about?"
                    },
                    {
                      "key": "✓",
                      "text": "[Accept Quest]"
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        }
      ]
    },
    {
      "id": "artefacts",
      "title": "Artefacts",
      "anchor": "Artefacts",
      "blocks": [
        {
          "type": "step",
          "id": "artefacts:ua28nn",
          "html": "While on the same floor, head west then south until you find a <a href=\"https://runescape.wiki/w/Icon#List_of_icons\" target=\"_blank\" rel=\"noopener\">transportation map icon</a> (Show map).",
          "text": "While on the same floor, head west then south until you find a transportation map icon (Show map).",
          "dialogue": [],
          "images": [
            {
              "type": "map",
              "caption": "Show map",
              "lat": 93,
              "lon": 103,
              "zoom": 2,
              "plane": 0,
              "mapId": 26,
              "version": "",
              "features": [],
              "href": "https://runescape.wiki/w/Another_Slice_of_H.A.M./Quick_guide"
            }
          ],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "artefacts:1did9l2",
          "html": "Enter the doorway, head south down the tracks and talk to <a href=\"https://runescape.wiki/w/Tegdak\" target=\"_blank\" rel=\"noopener\">Tegdak</a> (you need 2 free spaces for the specimen brush and trowel).",
          "text": "Enter the doorway, head south down the tracks and talk to Tegdak (you need 2 free spaces for the specimen brush and trowel).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "artefacts:14qk84",
          "html": "Use the trowel on the 6 <a href=\"https://runescape.wiki/w/Artefact_(Another_Slice_of_H.A.M.)\" target=\"_blank\" rel=\"noopener\">artefacts</a> on the ground to dig them up. They have the same sparkles as <a href=\"https://runescape.wiki/w/Time_sprite\" target=\"_blank\" rel=\"noopener\">time sprite</a>.",
          "text": "Use the trowel on the 6 artefacts on the ground to dig them up. They have the same sparkles as time sprite.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "artefacts:14qk84:191k90a",
              "html": "If you need more backpack space, you can talk to Tegdak per restored artefact, you don&#39;t need to give all in at once.",
              "text": "If you need more backpack space, you can talk to Tegdak per restored artefact, you don't need to give all in at once.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "artefacts:ezdvki",
          "html": "Use each of them on the <a href=\"https://runescape.wiki/w/Specimen_table_(Another_Slice_of_H.A.M.)\" target=\"_blank\" rel=\"noopener\">specimen table</a>.",
          "text": "Use each of them on the specimen table.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "artefacts:1xjphao",
          "html": "Talk to Tegdak and Zanik will be following you after the dialogue.",
          "text": "Talk to Tegdak and Zanik will be following you after the dialogue.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "artefacts:3euyk",
          "html": "If Zanik isn&#39;t following you, dismiss any pets/familiars and talk to <a href=\"https://runescape.wiki/w/Zanik\" target=\"_blank\" rel=\"noopener\">Zanik</a>.",
          "text": "If Zanik isn't following you, dismiss any pets/familiars and talk to Zanik.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "artefacts:3euyk:1pqi3aj",
              "html": "Zanik will now be following you.",
              "text": "Zanik will now be following you.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "artefacts:3euyk:lvmzpv",
              "html": "If you lose Zanik you will need to return here to retrieve her. (Teleporting will leave Zanik behind)",
              "text": "If you lose Zanik you will need to return here to retrieve her. (Teleporting will leave Zanik behind)",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "artefacts:olpoud",
          "html": "With Zanik following, exit the train tunnel using the doorway to the north.",
          "text": "With Zanik following, exit the train tunnel using the doorway to the north.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "artefacts:p6teql",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Goblin_scribe\" target=\"_blank\" rel=\"noopener\">Goblin scribe</a>, in the building directly west of the quest start point.",
          "text": "Talk to the Goblin scribe, in the building directly west of the quest start point.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "artefacts:7lesqp",
          "html": "In the house just west of the Goblin scribe, climb down the stairs.",
          "text": "In the house just west of the Goblin scribe, climb down the stairs.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "artefacts:ka95ed",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Oldak\" target=\"_blank\" rel=\"noopener\">Oldak</a>.",
          "text": "Talk to Oldak.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "artefacts:ka95ed:edxpsa",
              "html": "If you have Invention unlocked.",
              "text": "If you have Invention unlocked.",
              "dialogue": [
                {
                  "when": null,
                  "options": [
                    {
                      "key": "2",
                      "text": "No - talk about quest or other things."
                    }
                  ]
                }
              ],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "artefacts:vcfsnk",
          "html": "You will be teleported to <a href=\"https://runescape.wiki/w/Goblin_Village\" target=\"_blank\" rel=\"noopener\">Goblin Village</a> with Zanik, receiving a <a href=\"https://runescape.wiki/w/Dorgesh-kaan_sphere\" target=\"_blank\" rel=\"noopener\">Dorgesh-kaan sphere</a> in your inventory.",
          "text": "You will be teleported to Goblin Village with Zanik, receiving a Dorgesh-kaan sphere in your inventory.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
