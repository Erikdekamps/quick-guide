          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "infiltrating-h-a-m:6q8j2y:ostled",
              "html": "If you brought a water altar teleport or Enlightened amulet to teleport to Lumbridge Swamp, use them now for quicker travel.",
              "text": "If you brought a water altar teleport or Enlightened amulet to teleport to Lumbridge Swamp, use them now for quicker travel.",
