          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-the-goutweed:1ykne3l:1jjxc7y",
              "html": "If you receive the message &quot;... but you can&#39;t reach very far into it.&quot;, use an empty bucket on the cooking pot.",
