  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:n60axd",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Explorer_Jack\" target=\"_blank\" rel=\"noopener\">Explorer Jack</a> who is located in a house west of the <a href=\"https://runescape.wiki/w/Lumbridge_General_Store\" target=\"_blank\" rel=\"noopener\">Lumbridge General Store</a>.",
          "text": "Talk to Explorer Jack who is located in a house west of the Lumbridge General Store.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "You mentioned a quest?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "1",
                  "text": "How do I get to the Land of Snow?"
                },
                {
                  "key": "3",
                  "text": "Actually, never mind."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:16l610r",
          "html": "Go to the <a href=\"https://runescape.wiki/w/Wizards%27_Tower\" target=\"_blank\" rel=\"noopener\">Wizards&#39; Tower</a> which is located south of <a href=\"https://runescape.wiki/w/Draynor_Village\" target=\"_blank\" rel=\"noopener\">Draynor Village</a>.",
          "text": "Go to the Wizards' Tower which is located south of Draynor Village.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:5bdmj5",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Wizard_Isidor\" target=\"_blank\" rel=\"noopener\">Wizard Isidor</a> who is in the west room on the 1<sup>st</sup> floor (UK) / 2<sup>nd</sup> floor (US) of the tower.",
          "text": "Talk to Wizard Isidor who is in the west room on the 1st floor (UK) / 2nd floor (US) of the tower.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I'm a friend of Explorer Jack and need teleporting."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
