  "sections": [
    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "step",
          "id": "getting-started:3pnrqz",
          "html": "Talk to <a href=\"https://runescape.wiki/w/King_Arthur\" target=\"_blank\" rel=\"noopener\">King Arthur</a> at <a href=\"https://runescape.wiki/w/Camelot\" target=\"_blank\" rel=\"noopener\">Camelot</a>.",
          "text": "Talk to King Arthur at Camelot.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I'm looking for a quest."
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:aswuzc",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Sir_Gawain\" target=\"_blank\" rel=\"noopener\">Sir Gawain</a> nearby. Ask him how <a href=\"https://runescape.wiki/w/Merlin\" target=\"_blank\" rel=\"noopener\">Merlin</a> got stuck in the crystal.",
          "text": "Talk to Sir Gawain nearby. Ask him how Merlin got stuck in the crystal.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Do you know how Merlin got trapped?"
                },
                {
                  "key": "2",
                  "text": "Thank you for the information!"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1nvsr69",
          "html": "Go upstairs, and talk to <a href=\"https://runescape.wiki/w/Sir_Lancelot\" target=\"_blank\" rel=\"noopener\">Sir Lancelot</a>. Ask if he has any ideas on getting into <a href=\"https://runescape.wiki/w/Keep_Le_Faye\" target=\"_blank\" rel=\"noopener\">Keep Le Faye</a>.",
          "text": "Go upstairs, and talk to Sir Lancelot. Ask if he has any ideas on getting into Keep Le Faye.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Any ideas on how to get into Morgan Le Faye's stronghold?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:1tmnna2",
          "html": "Hide in the crate just west of the <a href=\"https://runescape.wiki/w/Candle-maker\" target=\"_blank\" rel=\"noopener\">candle-maker</a> in <a href=\"https://runescape.wiki/w/Catherby\" target=\"_blank\" rel=\"noopener\">Catherby</a>.",
          "text": "Hide in the crate just west of the candle-maker in Catherby.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Yes."
                },
                {
                  "key": "1",
                  "text": "Yes."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "inside-keep-le-faye",
      "title": "Inside Keep Le Faye",
      "anchor": "Inside_Keep_Le_Faye",
      "blocks": [
        {
          "type": "step",
          "id": "inside-keep-le-faye:1t50syt",
          "html": "Climb to the top floor.",
          "text": "Climb to the top floor.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-keep-le-faye:joi4t2",
          "html": "Attack <a href=\"https://runescape.wiki/w/Sir_Mordred\" target=\"_blank\" rel=\"noopener\">Sir Mordred</a> until his health drops to 0. If you use bleeds/poisons/conjures, future dialogue will be interrupted until the bleed/poison effect ends. Aggressive familiars would continue to attack when Sir Mordred goes back to full health after reaching 0 health, thus restarting the fight.",
          "text": "Attack Sir Mordred until his health drops to 0. If you use bleeds/poisons/conjures, future dialogue will be interrupted until the bleed/poison effect ends. Aggressive familiars would continue to attack when Sir Mordred goes back to full health after reaching 0 health, thus restarting the fight.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-keep-le-faye:1wykdz5",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Morgan_Le_Faye\" target=\"_blank\" rel=\"noopener\">Morgan Le Faye</a>. Spare Mordred&#39;s life to discover how to save <a href=\"https://runescape.wiki/w/Merlin\" target=\"_blank\" rel=\"noopener\">Merlin</a>.",
          "text": "Talk to Morgan Le Faye. Spare Mordred's life to discover how to save Merlin.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Tell me how to untrap Merlin and I might."
                },
                {
                  "key": "2",
                  "text": "Okay, I will do that."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "inside-keep-le-faye:z9m8y8",
          "html": "If you do not have <a href=\"https://runescape.wiki/w/Bat_bones\" target=\"_blank\" rel=\"noopener\">bat bones</a>, exit the keep to the west and kill a <a href=\"https://runescape.wiki/w/Giant_bat\" target=\"_blank\" rel=\"noopener\">Giant bat</a>.",
          "text": "If you do not have bat bones, exit the keep to the west and kill a Giant bat.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
    {
      "id": "getting-a-black-candle",
      "title": "Getting a black candle",
      "anchor": "Getting_a_black_candle",
      "blocks": [
        {
          "type": "bring",
          "needed": [
            {
              "id": "getting-a-black-candle:bring:1r2hopj",
              "html": "<a href=\"https://runescape.wiki/w/Bucket\" target=\"_blank\" rel=\"noopener\">Bucket</a>",
              "text": "Bucket"
            },
            {
              "id": "getting-a-black-candle:bring:zrycim",
              "html": "<a href=\"https://runescape.wiki/w/Insect_repellent\" target=\"_blank\" rel=\"noopener\">Insect repellent</a>",
              "text": "Insect repellent"
            }
          ],
          "recommended": []
        },
        {
          "type": "text",
          "html": "You may skip this step using a <a href=\"https://runescape.wiki/w/Black_candle\" target=\"_blank\" rel=\"noopener\">black candle</a> purchased from <a href=\"https://runescape.wiki/w/Wendle%27s_Wicks\" target=\"_blank\" rel=\"noopener\">Wendle&#39;s Wicks</a> in <a href=\"https://runescape.wiki/w/Wendlewick\" target=\"_blank\" rel=\"noopener\">Wendlewick</a>."
        },
        {
          "type": "step",
          "id": "getting-a-black-candle:1jn8uwk",
          "html": "Talk to the <a href=\"https://runescape.wiki/w/Candle-maker\" target=\"_blank\" rel=\"noopener\">candle-maker</a> in <a href=\"https://runescape.wiki/w/Catherby\" target=\"_blank\" rel=\"noopener\">Catherby</a>.",
          "text": "Talk to the candle-maker in Catherby.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Have you got any black candles?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-a-black-candle:1llapb6",
          "html": "Gather a bucket of wax from the <a href=\"https://runescape.wiki/w/Beehive\" target=\"_blank\" rel=\"noopener\">beehives</a> to the north-west. A bucket can be found at the beehives.",
          "text": "Gather a bucket of wax from the beehives to the north-west. A bucket can be found at the beehives.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "getting-a-black-candle:1llapb6:m2ghhz",
              "html": "If you do not have <a href=\"https://runescape.wiki/w/Insect_repellent\" target=\"_blank\" rel=\"noopener\">insect repellent</a> then speak to the <a href=\"https://runescape.wiki/w/Beekeeper\" target=\"_blank\" rel=\"noopener\">beekeeper</a> for some. You can also add it to your <a href=\"https://runescape.wiki/w/Tool_belt\" target=\"_blank\" rel=\"noopener\">tool belt</a>.",
              "text": "If you do not have insect repellent then speak to the beekeeper for some. You can also add it to your tool belt.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "getting-a-black-candle:f9stqo",
          "html": "Left click the hive to use <a href=\"https://runescape.wiki/w/Insect_repellent\" target=\"_blank\" rel=\"noopener\">insect repellent</a> on it and then use an empty bucket on a beehive to fill the bucket.",
          "text": "Left click the hive to use insect repellent on it and then use an empty bucket on a beehive to fill the bucket.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-a-black-candle:17ft7jz",
          "html": "Talk to the candle-maker again to get the <a href=\"https://runescape.wiki/w/Black_candle\" target=\"_blank\" rel=\"noopener\">black candle</a> from him.",
          "text": "Talk to the candle-maker again to get the black candle from him.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
