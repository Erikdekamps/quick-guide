    {
      "id": "treasure-trail",
      "title": "Treasure trail",
      "anchor": "Treasure_trail",
      "blocks": [
        {
          "type": "image",
          "src": "https://runescape.wiki/images/thumb/You_Are_It_mysterious_clue_dig_location.png/250px-You_Are_It_mysterious_clue_dig_location.png?c105e",
          "width": 250,
          "height": 141,
          "alt": "",
          "caption": "The dig location in Lumbridge cemetery.",
          "href": "https://runescape.wiki/w/File:You_Are_It_mysterious_clue_dig_location.png"
        },
        {
          "type": "step",
          "id": "treasure-trail:8qgumv",
          "html": "Stand in the room with <a href=\"https://runescape.wiki/w/Duke_Horacio\" target=\"_blank\" rel=\"noopener\">Duke Horacio</a> on the 1<sup>st</sup> floor (UK) / 2<sup>nd</sup> floor (US) of <a href=\"https://runescape.wiki/w/Lumbridge_Castle\" target=\"_blank\" rel=\"noopener\">Lumbridge Castle</a>.",
          "text": "Stand in the room with Duke Horacio on the 1st floor (UK) / 2nd floor (US) of Lumbridge Castle.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "treasure-trail:10v42az",
          "html": "Remove all worn items, then perform the <a href=\"https://runescape.wiki/w/Cry\" target=\"_blank\" rel=\"noopener\">Cry</a> and <a href=\"https://runescape.wiki/w/Panic\" target=\"_blank\" rel=\"noopener\">Panic</a> emotes (in that order). You should see a cutscene if it works.",
          "text": "Remove all worn items, then perform the Cry and Panic emotes (in that order). You should see a cutscene if it works.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "treasure-trail:1q5ybna",
          "html": "Go to <a href=\"https://runescape.wiki/w/Lumbridge_cemetery\" target=\"_blank\" rel=\"noopener\">Lumbridge cemetery</a>. Using the mysterious clue&#39;s dig option, dig one square to the north of the largest tombstone along the southern fence. You will get a <a href=\"https://runescape.wiki/w/Locked_casket\" target=\"_blank\" rel=\"noopener\">locked casket</a>. You must complete the cutscene in order to continue.",
          "text": "Go to Lumbridge cemetery. Using the mysterious clue's dig option, dig one square to the north of the largest tombstone along the southern fence. You will get a locked casket. You must complete the cutscene in order to continue.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "treasure-trail:b66bdm",
          "html": "<i>Enter</i> the <a href=\"https://runescape.wiki/w/Portal_(player-owned_house)\" target=\"_blank\" rel=\"noopener\">POH portal</a> in <a href=\"https://runescape.wiki/w/Rimmington\" target=\"_blank\" rel=\"noopener\">Rimmington</a> to trigger a cutscene.",
          "text": "Enter the POH portal in Rimmington to trigger a cutscene.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "treasure-trail:1p92l8y",
          "html": "Teleport to <a href=\"https://runescape.wiki/w/Draynor\" target=\"_blank\" rel=\"noopener\">Draynor</a>, run into the <a href=\"https://runescape.wiki/w/Draynor_Manor\" target=\"_blank\" rel=\"noopener\">Draynor Manor</a>, and head into the first door to the west after entering the building.",
          "text": "Teleport to Draynor, run into the Draynor Manor, and head into the first door to the west after entering the building.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "treasure-trail:dgd0b2",
          "html": "<i>Search</i> the bookcase in the north-western part of the room to find the <a href=\"https://runescape.wiki/w/Casket_key\" target=\"_blank\" rel=\"noopener\">casket key</a>.",
          "text": "Search the bookcase in the north-western part of the room to find the casket key.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "treasure-trail:44ikkv",
          "html": "Open the <a href=\"https://runescape.wiki/w/Locked_casket\" target=\"_blank\" rel=\"noopener\">locked casket</a> to obtain an <a href=\"https://runescape.wiki/w/Old_necklace\" target=\"_blank\" rel=\"noopener\">old necklace</a>.",
          "text": "Open the locked casket to obtain an old necklace.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
