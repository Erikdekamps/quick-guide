        },
        {
          "type": "step",
          "id": "starting-out:1hczi8k",
          "html": "Teleport to <a href=\"https://runescape.wiki/w/Seers%27_Village\" target=\"_blank\" rel=\"noopener\">Seers&#39; Village</a> and run north-west to <a href=\"https://runescape.wiki/w/McGrubor%27s_Wood\" target=\"_blank\" rel=\"noopener\">McGrubor&#39;s Wood</a> (fairy ring <b>A</b><b>L</b><b>S</b>).",
          "text": "Teleport to Seers' Village and run north-west to McGrubor's Wood (fairy ring ALS).",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:33gcwa",
          "html": "Enter the woods through the <a href=\"https://runescape.wiki/w/Loose_Railing_(McGrubor%27s_Wood)\" target=\"_blank\" rel=\"noopener\">Loose railing</a>.",
          "text": "Enter the woods through the Loose railing.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:c8r606",
          "html": "Attempt to chop the tree 14 paces west and 6 paces south of the crate. (Slightly different colour, and near the quest marker on the minimap)",
