    {
      "id": "infiltrating-the-fortress",
      "title": "Infiltrating the fortress",
      "anchor": "Infiltrating_the_fortress",
      "blocks": [
        {
          "type": "note",
          "html": "There are multiple possibilities, choice-wise, to get through this. The list below is just a recommended choice order."
        },
        {
          "type": "step",
          "id": "infiltrating-the-fortress:1y0vtsx",
          "html": "Open the Portcullis.",
          "text": "Open the Portcullis.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "infiltrating-the-fortress:1ktn2py",
          "html": "Fortress guard: (guaranteed suspicion on first chat option)",
          "text": "Fortress guard: (guaranteed suspicion on first chat option)",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "1",
                  "text": "He is my prisoner."
                },
                {
                  "key": "1",
                  "text": "No, I have something... special planned for him."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "infiltrating-the-fortress:1ktn2py:1grsqc0",
              "html": "It is required to dismiss pets and familiars before proceeding.",
              "text": "It is required to dismiss pets and familiars before proceeding.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "infiltrating-the-fortress:lbv5g9",
          "html": "Head north, to Lieutenant York:",
          "text": "Head north, to Lieutenant York:",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Are you suggesting I cannot handle a mere knight of Saradomin?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "infiltrating-the-fortress:z2265r",
          "html": "Head north-west, and <i>climb up</i> staircase. The fortress guard will stop you.",
          "text": "Head north-west, and climb up staircase. The fortress guard will stop you.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What do you want, maggot?"
                },
                {
                  "key": "2",
                  "text": "This prisoner is to be sacrificed."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "infiltrating-the-fortress:1w29qkx",
          "html": "Head to the 1<sup>st</sup> floor (UK) / 2<sup>nd</sup> floor (US) to the south, talk to <a href=\"https://runescape.wiki/w/Hierophant_Marius\" target=\"_blank\" rel=\"noopener\">Hierophant Marius</a>.",
          "text": "Head to the 1st floor (UK) / 2nd floor (US) to the south, talk to Hierophant Marius.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "Yes."
                },
                {
                  "key": "3",
                  "text": "I shall return after I deal with this Temple Knight."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "infiltrating-the-fortress:w4mdho",
          "html": "Head south-east of the room, and <i>climb up</i> staircase. The fortress guard will stop you.",
          "text": "Head south-east of the room, and climb up staircase. The fortress guard will stop you.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I am bringing him to the tallest tower."
                },
                {
                  "key": "1",
                  "text": "We need him to recover the weapon of power, as you know."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "infiltrating-the-fortress:1nhesu5",
          "html": "Go upstairs, head north to <a href=\"https://runescape.wiki/w/Lieutenant_Graves\" target=\"_blank\" rel=\"noopener\">Lieutenant Graves</a>.",
          "text": "Go upstairs, head north to Lieutenant Graves.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "Stand aside. I will handle this."
                },
                {
                  "key": "1",
                  "text": "The prisoner stays with me."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "infiltrating-the-fortress:qodnz6",
          "html": "Search the Lieutenant&#39;s body, and choose whether you want to kill him or not. It doesn&#39;t matter.",
          "text": "Search the Lieutenant's body, and choose whether you want to kill him or not. It doesn't matter.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
