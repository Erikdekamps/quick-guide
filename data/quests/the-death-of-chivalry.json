      "id": "meeting-saradomin",
      "title": "Meeting Saradomin",
      "anchor": "Meeting_Saradomin",
      "blocks": [
        {
          "type": "step",
          "id": "meeting-saradomin:t59o36",
          "html": "Speak to <a href=\"https://runescape.wiki/w/Sir_Owen\" target=\"_blank\" rel=\"noopener\">Sir Owen</a> in the garden north of the <a href=\"https://runescape.wiki/w/Edgeville_Monastery\" target=\"_blank\" rel=\"noopener\">Edgeville Monastery</a>.",
          "text": "Speak to Sir Owen in the garden north of the Edgeville Monastery.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "The who with the what now?"
                },
                {
                  "key": "1",
                  "text": "I guess I have one of those faces."
                },
                {
                  "key": "1",
                  "text": "Saradomin must have had a good reason..."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "meeting-saradomin:43jp23",
          "html": "Talk to Saradomin after the cutscene.",
          "text": "Talk to Saradomin after the cutscene.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "(Kneel before Saradomin.)"
                },
                {
                  "key": "2",
                  "text": "How can I help?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "meeting-saradomin:1p04oc3",
          "html": "Alternatively if aligned with another god.",
          "text": "Alternatively if aligned with another god.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "(Remain standing.)"
                },
                {
                  "key": "~",
                  "text": "[Any option]"
                },
                {
                  "key": "~",
