  "sections": [
    {
      "id": "freeing-the-generals",
      "title": "Freeing the Generals",
      "anchor": "Freeing_the_Generals",
      "blocks": [
        {
          "type": "step",
          "id": "freeing-the-generals:xu8g89",
          "html": "Inspect either <a href=\"https://runescape.wiki/w/General_Bentnoze\" target=\"_blank\" rel=\"noopener\">General Bentnoze</a> or <a href=\"https://runescape.wiki/w/General_Wartface\" target=\"_blank\" rel=\"noopener\">General Wartface</a>. They are located in the Lumbridge Castle banquet room.",
          "text": "Inspect either General Bentnoze or General Wartface. They are located in the Lumbridge Castle banquet room.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:j350w",
          "html": "Head to <a href=\"https://runescape.wiki/w/Goblin_Village\" target=\"_blank\" rel=\"noopener\">Goblin Village</a> and climb down the ladder in the eastern building.",
          "text": "Head to Goblin Village and climb down the ladder in the eastern building.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:w407zl",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Goblin_Cook\" target=\"_blank\" rel=\"noopener\">Goblin Cook</a>.",
          "text": "Talk to Goblin Cook.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "2",
                  "text": "I need your help..."
                },
                {
                  "key": "1",
                  "text": "What do you need? Maybe I can get it for you."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:utmwn5",
          "html": "Give him <a href=\"https://runescape.wiki/w/Charcoal\" target=\"_blank\" rel=\"noopener\">charcoal</a>.",
          "text": "Give him charcoal.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "I've got the charcoal you were after."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:balx9f",
          "html": "After the cutscene, talk to him again.",
          "text": "After the cutscene, talk to him again.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I need your help..."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:e72ot",
          "html": "Slice an <a href=\"https://runescape.wiki/w/Orange\" target=\"_blank\" rel=\"noopener\">orange</a> into <a href=\"https://runescape.wiki/w/Orange_slices\" target=\"_blank\" rel=\"noopener\">orange slices</a> (not <a href=\"https://runescape.wiki/w/Orange_chunks\" target=\"_blank\" rel=\"noopener\">chunks</a>) and use any colour of <a href=\"https://runescape.wiki/w/Dye\" target=\"_blank\" rel=\"noopener\">dye</a> except <a href=\"https://runescape.wiki/w/Orange_dye\" target=\"_blank\" rel=\"noopener\">orange</a>, <a href=\"https://runescape.wiki/w/Yellow_dye\" target=\"_blank\" rel=\"noopener\">yellow</a>, <a href=\"https://runescape.wiki/w/Red_dye\" target=\"_blank\" rel=\"noopener\">red</a>, or <a href=\"https://runescape.wiki/w/Pink_dye\" target=\"_blank\" rel=\"noopener\">pink</a> on the slices to create <a href=\"https://runescape.wiki/w/Dyed_orange\" target=\"_blank\" rel=\"noopener\">dyed orange</a>.",
          "text": "Slice an orange into orange slices (not chunks) and use any colour of dye except orange, yellow, red, or pink on the slices to create dyed orange.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:100rqa4",
          "html": "<i>Use</i> <a href=\"https://runescape.wiki/w/Spice\" target=\"_blank\" rel=\"noopener\">spice</a> on <a href=\"https://runescape.wiki/w/Fishing_bait\" target=\"_blank\" rel=\"noopener\">fishing bait</a> to create <a href=\"https://runescape.wiki/w/Spicy_maggots\" target=\"_blank\" rel=\"noopener\">spicy maggots</a>.",
          "text": "Use spice on fishing bait to create spicy maggots.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:1n2gmlk",
          "html": "Right click <i>Use</i> <a href=\"https://runescape.wiki/w/Bread\" target=\"_blank\" rel=\"noopener\">bread</a> on <a href=\"https://runescape.wiki/w/Bucket_of_water\" target=\"_blank\" rel=\"noopener\">bucket</a>, <a href=\"https://runescape.wiki/w/Bowl_of_water\" target=\"_blank\" rel=\"noopener\">bowl</a>, or <a href=\"https://runescape.wiki/w/Jug_of_water\" target=\"_blank\" rel=\"noopener\">jug</a> of water to create <a href=\"https://runescape.wiki/w/Soggy_bread\" target=\"_blank\" rel=\"noopener\">soggy bread</a>.",
          "text": "Right click Use bread on bucket, bowl, or jug of water to create soggy bread.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:w407zl-2",
          "html": "Talk to Goblin Cook.",
          "text": "Talk to Goblin Cook.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "3",
                  "text": "I've got the ingredients we need..."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:c4vgqi",
          "html": "Head back to the dining room in <a href=\"https://runescape.wiki/w/Lumbridge_Castle\" target=\"_blank\" rel=\"noopener\">Lumbridge Castle</a>, use the <a href=\"https://runescape.wiki/w/Slop_of_compromise\" target=\"_blank\" rel=\"noopener\">slop of compromise</a> on either of the Generals.",
          "text": "Head back to the dining room in Lumbridge Castle, use the slop of compromise on either of the Generals.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "freeing-the-generals:1k0rf3j",
          "html": "Subquest complete!",
          "text": "Subquest complete!",
