    {
      "id": "getting-started",
      "title": "Getting started",
      "anchor": "Getting_started",
      "blocks": [
        {
          "type": "bring",
          "needed": [
            {
              "id": "getting-started:bring:103kgp2",
              "html": "<a href=\"https://runescape.wiki/w/Chef%27s_hat\" target=\"_blank\" rel=\"noopener\">Chef&#39;s hat</a> or some other item to enter Cook&#39;s Guild",
              "text": "Chef's hat or some other item to enter Cook's Guild"
            }
          ],
          "recommended": []
        },
        {
          "type": "step",
          "id": "getting-started:1oul9qe",
          "html": "Head to the <a href=\"https://runescape.wiki/w/Cooks%27_Guild\" target=\"_blank\" rel=\"noopener\">Cooks&#39; Guild</a>, the building just south-west of the <a href=\"https://runescape.wiki/w/Grand_Exchange\" target=\"_blank\" rel=\"noopener\">Grand Exchange</a> main entrance.",
          "text": "Head to the Cooks' Guild, the building just south-west of the Grand Exchange main entrance.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "getting-started:wwjk0n",
          "html": "To start, talk to the <a href=\"https://runescape.wiki/w/Head_chef\" target=\"_blank\" rel=\"noopener\">Head chef</a> in the Cooks&#39; Guild.",
          "text": "To start, talk to the Head chef in the Cooks' Guild.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "Do you have any quests for me?"
                },
                {
                  "key": "1",
                  "text": "Of course, discrete is my middle name!"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                },
                {
                  "key": "2",
                  "text": "Cool story, can we get on with this?"
                },
                {
                  "key": "1",
                  "text": "Sounds tasty!"
                },
                {
                  "key": "2",
                  "text": "Consider myself braced."
                },
                {
                  "key": "2",
                  "text": "Pull yourself together!"
                },
                {
                  "key": "1",
                  "text": "Would you like me to get some more for you?"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
    },
