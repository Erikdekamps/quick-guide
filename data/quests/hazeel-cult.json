    {
      "id": "carnillean-s-side",
      "title": "Carnillean's Side",
      "anchor": "Carnillean's_Side",
      "blocks": [
        {
          "type": "step",
          "id": "carnillean-s-side:187mk23",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Clivet\" target=\"_blank\" rel=\"noopener\">Clivet</a> and refuse to help - he will disappear.",
          "text": "Talk to Clivet and refuse to help - he will disappear.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What do you mean?"
                },
                {
                  "key": "1",
                  "text": "I will never help you."
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "carnillean-s-side:xm747v",
          "html": "Board the raft.",
          "text": "Board the raft.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "carnillean-s-side:o5tgn7",
          "html": "Go south and talk to <a href=\"https://runescape.wiki/w/Alomone\" target=\"_blank\" rel=\"noopener\">Alomone</a>, and then kill him.",
          "text": "Go south and talk to Alomone, and then kill him.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "carnillean-s-side:1xk4f0",
          "html": "Pick up the <a href=\"https://runescape.wiki/w/Carnillean_armour\" target=\"_blank\" rel=\"noopener\">Carnillean armour</a> he drops.",
          "text": "Pick up the Carnillean armour he drops.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "carnillean-s-side:1xk4f0:1peyv17",
              "html": "To get a second piece of armour, kill Alomone again. (You may have to drop the armour before killing Alomone.)",
              "text": "To get a second piece of armour, kill Alomone again. (You may have to drop the armour before killing Alomone.)",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "carnillean-s-side:1xk4f0:448aze",
              "html": "Before talking to Ceril to turn in the quest, drop one on the floor, he will take any you have in the backpack. If you bank it, it will be gone after.",
              "text": "Before talking to Ceril to turn in the quest, drop one on the floor, he will take any you have in the backpack. If you bank it, it will be gone after.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "carnillean-s-side:1645j1s",
          "html": "Return to Carnilleans&#39; house and talk to Ceril.",
          "text": "Return to Carnilleans' house and talk to Ceril.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "carnillean-s-side:65ksn9",
          "html": "You will get a kind of &quot;Quest Complete!&quot; notification, but there is one more step.",
          "text": "You will get a kind of \"Quest Complete!\" notification, but there is one more step.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "carnillean-s-side:16j6zn3",
          "html": "Go upstairs and search the wardrobe in the eastern room, on the southern wall.",
          "text": "Go upstairs and search the wardrobe in the eastern room, on the southern wall.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "carnillean-s-side:fvxipr",
          "html": "Quest complete!",
          "text": "Quest complete!",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
