        {
          "type": "step",
          "id": "starting-out:qhml7j",
          "html": "Talk to <a href=\"https://runescape.wiki/w/Ceril_Carnillean\" target=\"_blank\" rel=\"noopener\">Ceril Carnillean</a>, located in his house to the immediate south of the <a href=\"https://runescape.wiki/w/East_Ardougne\" target=\"_blank\" rel=\"noopener\">East Ardougne</a> castle.",
          "text": "Talk to Ceril Carnillean, located in his house to the immediate south of the East Ardougne castle.",
          "dialogue": [
            {
              "when": null,
              "options": [
                {
                  "key": "1",
                  "text": "What's wrong?"
                },
                {
                  "key": "✓",
                  "text": "[Accept Quest]"
                }
              ]
            }
          ],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:1lh0p58",
          "html": "Exit his house and make your way to the south side of it.",
          "text": "Exit his house and make your way to the south side of it.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:dzhtj1",
          "html": "There are five valves that must be turned, complete them on the way to the cave to save time later:",
          "text": "There are five valves that must be turned, complete them on the way to the cave to save time later:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "starting-out:dzhtj1:c1oa15",
              "html": "Valve 2 is directly behind the Carnilleans&#39; house. Turn it <b>right</b>.",
              "text": "Valve 2 is directly behind the Carnilleans' house. Turn it right.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "starting-out:dzhtj1:1svyzyx",
              "html": "Valve 1 is west of the clock tower, just across the bridge. Turn it <b>right</b>.",
              "text": "Valve 1 is west of the clock tower, just across the bridge. Turn it right.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "starting-out:dzhtj1:ryemt5",
              "html": "Valve 3 is north of the cave, east of the clock tower. Turn it <b>left</b>.",
              "text": "Valve 3 is north of the cave, east of the clock tower. Turn it left.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "starting-out:dzhtj1:9dy2oq",
              "html": "Valve 4 is just south of <a href=\"https://runescape.wiki/w/Ardougne_Zoo\" target=\"_blank\" rel=\"noopener\">Ardougne Zoo</a>&#39;s penguin cage. Turn it <b>right</b>.",
              "text": "Valve 4 is just south of Ardougne Zoo's penguin cage. Turn it right.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "starting-out:dzhtj1:1g2oggp",
              "html": "Valve 5 is south-east of the fourth valve, near <a href=\"https://runescape.wiki/w/Brother_Cedric\" target=\"_blank\" rel=\"noopener\">Brother Cedric</a>. Turn it <b>right</b>.",
              "text": "Valve 5 is south-east of the fourth valve, near Brother Cedric. Turn it right.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
          ]
        },
        {
          "type": "step",
          "id": "starting-out:rhw09",
          "html": "Enter the <a href=\"https://runescape.wiki/w/Cave_entrance_(Southern_Ardougne_sewer)\" target=\"_blank\" rel=\"noopener\">cave entrance</a> that is south of valve 3.",
          "text": "Enter the cave entrance that is south of valve 3.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "starting-out:1g0jc5w",
          "html": "Pick a side and follow the guide for the according side.",
          "text": "Pick a side and follow the guide for the according side.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        }
      ]
