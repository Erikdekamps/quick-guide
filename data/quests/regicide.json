        },
        {
          "type": "step",
          "id": "tirannwn:ewx23k",
          "html": "Take some <a href=\"https://runescape.wiki/w/Sulphur\" target=\"_blank\" rel=\"noopener\">sulphur</a> from the floor, then <i>grind</i> it into <a href=\"https://runescape.wiki/w/Ground_sulphur\" target=\"_blank\" rel=\"noopener\">ground sulphur</a>.",
          "text": "Take some sulphur from the floor, then grind it into ground sulphur.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "tirannwn:m9p2io",
          "html": "Head north-west into the elf camp and talk to Lord Iorwerth.",
          "text": "Head north-west into the elf camp and talk to Lord Iorwerth.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "tirannwn:1ppdxaf",
          "html": "Read <a href=\"https://runescape.wiki/w/The_Big_Book_of_Bangs\" target=\"_blank\" rel=\"noopener\">the Big Book of Bangs</a> he gives you and pick up the empty pot north of him if you need one.",
          "text": "Read the Big Book of Bangs he gives you and pick up the empty pot north of him if you need one.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "tirannwn:gte45g",
          "html": "Go to a <a href=\"https://runescape.wiki/w/Furnace\" target=\"_blank\" rel=\"noopener\">furnace</a> and <i>use</i> the limestone on it to obtain some <a href=\"https://runescape.wiki/w/Quicklime\" target=\"_blank\" rel=\"noopener\">quicklime</a>.",
          "text": "Go to a furnace and use the limestone on it to obtain some quicklime.",
