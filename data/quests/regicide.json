          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "tirannwn:1em2q4o:4q9jkp",
              "html": "There are only two clickable tiles near the corpse and trees. Mouse over along the shoreline until you find the clickable area.",
              "text": "There are only two clickable tiles near the corpse and trees. Mouse over along the shoreline until you find the clickable area.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            }
