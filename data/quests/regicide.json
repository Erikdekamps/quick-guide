        {
          "type": "step",
          "id": "sabotage:16b9xzj",
          "html": "Use your barrel of tar on the <a href=\"https://runescape.wiki/w/Fractionation_still\" target=\"_blank\" rel=\"noopener\">fractionation still</a> outside.",
