        },
        {
          "type": "step",
          "id": "tirannwn:1em2q4o",
          "html": "<i>Use</i> the barrels on the <a href=\"https://runescape.wiki/w/Tar\" target=\"_blank\" rel=\"noopener\">tar</a> to fill them into <a href=\"https://runescape.wiki/w/Barrel_of_tar\" target=\"_blank\" rel=\"noopener\">barrels of tar</a>.",
          "text": "Use the barrels on the tar to fill them into barrels of tar.",
