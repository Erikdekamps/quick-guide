        {
          "type": "heading",
          "level": 3,
          "text": "Operating the still"
        },
        {
          "type": "text",
          "html": "To operate the still:"
        },
        {
          "type": "step",
          "id": "sabotage:jvbnlb",
          "html": "Click the <b>tar regulator</b> side twice.",
          "text": "Click the tar regulator side twice.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "sabotage:1c6u8rw",
          "html": "Wait until the arrow gauge is within the green on the <b>pressure valve</b> side, then click the <b>pressure valve</b> once. This should keep the pressure indicator in the green without fluctuating.",
          "text": "Wait until the arrow gauge is within the green on the pressure valve side, then click the pressure valve once. This should keep the pressure indicator in the green without fluctuating.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "sabotage:1cftkx0",
          "html": "Now add coal in 2x increments using the middle &quot;Add coal&quot; button to get the <b>tar regulator</b> indicator in the green.",
          "text": "Now add coal in 2x increments using the middle \"Add coal\" button to get the tar regulator indicator in the green.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "sabotage:3py8p9",
          "html": "Now that the pressure valve and tar regulator are both in the green, the distillation bar at the bottom of the interface will begin to fill up.",
          "text": "Now that the pressure valve and tar regulator are both in the green, the distillation bar at the bottom of the interface will begin to fill up.",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": []
        },
        {
          "type": "step",
          "id": "sabotage:ad8rr",
          "html": "When the distillation bar is full, you may exit out of the interface, You should now have a barrel of naptha in the backpack.",
          "text": "When the distillation bar is full, you may exit out of the interface, You should now have a barrel of naptha in the backpack.",
