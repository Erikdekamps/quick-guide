  "sections": [
    {
      "id": "walkthrough",
      "title": "Walkthrough",
      "anchor": "Walkthrough",
      "blocks": [
        {
          "type": "step",
          "id": "walkthrough:1kg68th",
          "html": "Obtain the following items: a <a href=\"https://runescape.wiki/w/Bucket_of_milk\" target=\"_blank\" rel=\"noopener\">bucket of milk</a>, a <a href=\"https://runescape.wiki/w/Pot_of_flour\" target=\"_blank\" rel=\"noopener\">pot of flour</a>, and an <a href=\"https://runescape.wiki/w/Egg\" target=\"_blank\" rel=\"noopener\">egg</a>:",
          "text": "Obtain the following items: a bucket of milk, a pot of flour, and an egg:",
          "dialogue": [],
          "images": [],
          "tables": [],
          "substeps": [
            {
              "type": "step",
              "id": "walkthrough:1kg68th:1ccccrs",
              "html": "Buy from the <a href=\"https://runescape.wiki/w/Grand_Exchange\" target=\"_blank\" rel=\"noopener\">Grand Exchange</a> for 2,082.",
              "text": "Buy from the Grand Exchange for 2,082.",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": []
            },
            {
              "type": "step",
              "id": "walkthrough:1kg68th:ckm3is",
              "html": "Create them yourself:",
              "text": "Create them yourself:",
              "dialogue": [],
              "images": [],
              "tables": [],
              "substeps": [
                {
                  "type": "step",
                  "id": "walkthrough:1kg68th:ckm3is:15plmv2",
                  "html": "<a href=\"https://runescape.wiki/w/Bucket_of_milk\" target=\"_blank\" rel=\"noopener\">Bucket of milk</a>: use a <a href=\"https://runescape.wiki/w/Bucket\" target=\"_blank\" rel=\"noopener\">bucket</a> on a <a href=\"https://runescape.wiki/w/Dairy_cow\" target=\"_blank\" rel=\"noopener\">dairy cow</a> or <a href=\"https://runescape.wiki/w/Prized_dairy_cow\" target=\"_blank\" rel=\"noopener\">prized dairy cow</a> in the <a href=\"https://runescape.wiki/w/Lumbridge_cow_field\" target=\"_blank\" rel=\"noopener\">Lumbridge cow field</a>.",
                  "text": "Bucket of milk: use a bucket on a dairy cow or prized dairy cow in the Lumbridge cow field.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "walkthrough:1kg68th:ckm3is:10rzi4t",
                  "html": "<a href=\"https://runescape.wiki/w/Egg\" target=\"_blank\" rel=\"noopener\">Egg</a>: spawns at the chicken farm north-west of the cow field.",
                  "text": "Egg: spawns at the chicken farm north-west of the cow field.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                },
                {
                  "type": "step",
                  "id": "walkthrough:1kg68th:ckm3is:sqeir5",
                  "html": "<a href=\"https://runescape.wiki/w/Pot_of_flour\" target=\"_blank\" rel=\"noopener\">Pot of flour</a>: with an <a href=\"https://runescape.wiki/w/Empty_pot\" target=\"_blank\" rel=\"noopener\">empty pot</a> (found by the Cook in Lumbridge Castle), head to the <a href=\"https://runescape.wiki/w/Mill_Lane_Mill\" target=\"_blank\" rel=\"noopener\">Mill Lane Mill</a> next to the cow pens and pick some <a href=\"https://runescape.wiki/w/Grain\" target=\"_blank\" rel=\"noopener\">grain</a> from outside. Climb up to the top floor of the mill and use the grain with the hopper, then pull the lever. Climb down and take the flour from the flour bin with an empty pot.",
                  "text": "Pot of flour: with an empty pot (found by the Cook in Lumbridge Castle), head to the Mill Lane Mill next to the cow pens and pick some grain from outside. Climb up to the top floor of the mill and use the grain with the hopper, then pull the lever. Climb down and take the flour from the flour bin with an empty pot.",
                  "dialogue": [],
                  "images": [],
                  "tables": [],
                  "substeps": []
                }
              ]
            }
          ]
        },
        {
